{%- comment -%}
  Product family for the "Complete the look" ordering: products of the same family are alternatives,
  other families complete the look. Usage: {% render 'product-family', type: product.type %}
{%- endcomment -%}
{%- liquid
  assign t = type | downcase | strip
  if t contains 'sock'
    echo 'socks'
  elsif t contains 'overshoe' or t contains 'shoe cover'
    echo 'overshoes'
  elsif t contains 'glove'
    echo 'gloves'
  elsif t contains 'base layer' or t contains 'baselayer'
    echo 'baselayers'
  elsif t == blank
    echo 'other'
  else
    echo t
  endif
-%}
