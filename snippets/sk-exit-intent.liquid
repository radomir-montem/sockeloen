  function fmtDay(d) { var L = { en: 'en-GB', nl: 'nl-NL', de: 'de-DE', fr: 'fr-FR' }[loc] || 'en-GB'; return d.toLocaleDateString(L, { weekday: 'long', day: 'numeric', month: 'long' }); }
  function fmtEur(v) { return v === 0 ? t.dlv.free : '€' + v.toFixed(2).replace('.', ','); }
  function deliveryText() {
    var now = NL_NOW(), h = now.getHours(), m = now.getMinutes(), day = now.getDay();
    var work = day >= 1 && day <= 5, before = h < CUTOFF;
    var ship = (work && before) ? new Date(now) : addWorkdays(now, 1);
