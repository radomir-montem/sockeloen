  // ---- levertekst (zelfde logica als onder de koopknop: NL-tijd, cutoff 15:00, werkdagen) ----
  function deliveryText() {
    var parts = new Date().toLocaleString('en-GB', { timeZone: 'Europe/Amsterdam', hour: 'numeric', minute: 'numeric', hour12: false }).split(':');
    var h = parseInt(parts[0], 10), m = parseInt(parts[1], 10);
    var day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(new Date().toLocaleString('en-GB', { timeZone: 'Europe/Amsterdam', weekday: 'short' }));
    var work = day >= 1 && day <= 5, before = h < CUTOFF;
    var s;
