    var pe = z.express ? z.express.price(cartTotal) : null, ps = z.standard ? z.standard.price(cartTotal) : null;
    if (z.express && pe !== null) parts.push(t.dlv.express.replace('{d}', win(z.express)).replace('{p}', fmtEur(pe)));
    if (z.standard && ps !== null) parts.push((parts.length ? t.dlv.standard : t.dlv.standardFirst).replace('{d}', win(z.standard)).replace('{p}', fmtEur(ps)));
    s += ' ' + parts.join(t.dlv.or) + '.';
    // gratis-verzending-noot: per methode (VS/UPS-landen: standaard gratis vanaf €100, express vanaf €150)
    var fs = z.standard && z.standard.freeFrom, fe = z.express && z.express.freeFrom;
    if (fs && fe && fe !== fs) {
      var g = cartTotal >= fe ? t.dlv.gAll : cartTotal >= fs ? t.dlv.gExp.replace('{g}', (fe - cartTotal).toFixed(0)) : t.dlv.gStd.replace('{g}', (fs - cartTotal).toFixed(0));
      s += t.dlv.freeDual.replace('{t1}', fs).replace('{t2}', fe).replace('{c}', cartTotal.toFixed(0)).replace('{g}', g);
    } else {
      var th = fs || fe || threshold;
      s += cartTotal >= th ? t.dlv.freeOk.replace('{t}', th) : t.dlv.freeNote.replace('{t}', th).replace('{c}', cartTotal.toFixed(0)).replace('{g}', (th - cartTotal).toFixed(0));
    }
    return s;
  }

  // ---- UI ----
  var css = '#skx-bd{display:block!important;position:fixed;top:0;left:0;right:0;bottom:0;width:100vw;height:100vh;z-index:1000000;backdrop-filter:blur(21px) saturate(180%);-webkit-backdrop-filter:blur(21px) saturate(180%);background:rgba(255,255,255,.18);opacity:0;transition:opacity .2s}' +
    '#skx-bd.on{opacity:1}' +
    '#skx{position:fixed;left:50%;top:14%;transform:translate(-50%,-12px);z-index:1000001;width:min(372px,calc(100vw - 24px));border-radius:22px;padding:14px 16px 14px;color:#111;opacity:0;transition:opacity .3s,transform .3s;' +
    'font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Helvetica Neue",Roboto,Arial,sans-serif;background:linear-gradient(to right bottom,rgba(255,255,255,.6),rgba(255,255,255,.28),rgba(255,255,255,.12));' +
    'backdrop-filter:blur(21px) saturate(180%);-webkit-backdrop-filter:blur(21px) saturate(180%);border:1px solid rgba(255,255,255,.35);box-shadow:0 2px 2px rgba(0,0,0,.1),0 18px 50px rgba(0,0,0,.25);box-sizing:border-box}' +
    '#skx.on{opacity:1;transform:translate(-50%,0)}' +
    '#skx .top{display:flex;align-items:center;gap:10px;margin-bottom:8px}#skx .ic{width:38px;height:38px;flex:none;border-radius:9px;overflow:hidden;background:transparent}#skx .ic img{width:38px;height:38px;display:block;transform:scale(1.5);transform-origin:center}' +
    '#skx .app{flex:1;font-size:15px;letter-spacing:.02em;text-transform:uppercase;color:#7a2e1f;opacity:.9}#skx .now{font-size:14px;color:#5b4a66;opacity:.85}' +
    '#skx h3{margin:0 0 1px;font-size:19px;font-weight:700;letter-spacing:-.01em;line-height:1.25;color:#111}#skx p{margin:0;font-size:17px;line-height:1.3;color:#1a1a1a}' +
    '#skx .code{font-weight:700;letter-spacing:.06em;font-size:19px;margin-top:8px;cursor:pointer}#skx .code small{display:block;font-size:11px;font-weight:400;letter-spacing:0;color:#4a4a4f;margin-top:2px}' +
    '#skx .opts{margin-top:12px;display:grid;gap:6px}#skx .o{display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.55);border:1px solid rgba(255,255,255,.5);border-radius:12px;padding:10px 13px;font-size:15.5px;cursor:pointer;color:#111;text-align:left;width:100%;font-family:inherit}' +
    '#skx .o:hover{background:rgba(255,255,255,.8)}#skx .o span{color:#8a8a8e;font-size:15px}' +
    '#skx .row{display:flex;gap:8px;margin-top:12px}#skx .btn{flex:1;text-align:center;border-radius:12px;padding:11px 12px;font-size:15.5px;font-weight:600;cursor:pointer;border:1px solid rgba(255,255,255,.5);background:rgba(255,255,255,.55);color:#111;text-decoration:none;font-family:inherit;display:block}' +
    '#skx .btn.pri{background:#111;color:#fff;border-color:#111}' +
    '#skx textarea,#skx input{width:100%;box-sizing:border-box;border:1px solid rgba(255,255,255,.5);border-radius:12px;padding:10px 13px;font-size:15px;font-family:inherit;background:rgba(255,255,255,.7);color:#111;margin-top:10px}#skx textarea{min-height:58px;resize:vertical}' +
    '#skx small{display:block;color:#4a4a4f;font-size:11.5px;margin-top:8px;line-height:1.35}#skx .bar{height:6px;background:rgba(0,0,0,.12);border-radius:3px;overflow:hidden;margin:10px 0 4px}#skx .bar i{display:block;height:100%;background:#25D366}' +
    '#skx .x{display:none}';

  var bd, w;
  function head() { return '<div class="top"><div class="ic"><img src="' + WA_ICON + '" alt=""></div><div class="app">WhatsApp</div><div class="now">now</div></div><h3>Jasper Ockeloen</h3>'; }
  function render(body) { w.innerHTML = head() + body + '<input type="text" name="hp" style="display:none" tabindex="-1" autocomplete="off"><button class="x" aria-label="' + t.close + '">×</button>'; w.querySelector('.x').addEventListener('click', close); }
  function close() { if (w && w.parentNode) w.parentNode.removeChild(w); if (bd && bd.parentNode) bd.parentNode.removeChild(bd); }
  function thanks() { render('<p>' + t.thanks + '</p>'); setTimeout(close, 1600); }
  function row(a, b) { return '<div class="row">' + (a ? '<button class="btn" data-k="a">' + a + '</button>' : '') + (b ? '<button class="btn pri" data-k="b">' + b + '</button>' : '') + '</div>'; }
  function btn(k) { return w.querySelector('.btn[data-k=' + k + ']'); }
  function goCart() { location.href = path + '?skcart=1'; }
  function codeScreen(a, want, text) {
    render('<p>' + text + '</p><p class="code">…</p>' + row(null, t.apply));
    send({ ev: 'follow', a: a, sub: want, want: want }, function (j) {
      var code = (j && j.code) || '';
      var ce = w.querySelector('.code'); ce.textContent = code;
      // geen aparte kopieerknop: één primaire actie; tikken op de code kopieert stilletjes (fallback als de checkout de code kwijtraakt)
      ce.addEventListener('click', function () { try { navigator.clipboard.writeText(code); } catch (e) {} var s = ce.querySelector('small') || document.createElement('small'); s.textContent = t.copied; ce.appendChild(s); send({ ev: 'click', a: a, sub: 'copy' }); });
      btn('b').addEventListener('click', function () {
        send({ ev: 'click', a: a, sub: 'apply' });
        var back = path + '?skcart=1';
        // 1) code op de cart zetten (Cart API), 2) via /discount/ ook de checkout-cookie zetten, 3) terug naar deze pagina met de side cart open
        fetch('/cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ discount: code }) }).catch(function () {}).then(function () {
          location.href = '/discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(back);
        });
      });
    });
  }

  function show() {
    if (shown) return; shown = true; mark();
    var st = document.createElement('style'); st.textContent = css; document.head.appendChild(st);
    bd = document.createElement('div'); bd.id = 'skx-bd'; document.body.appendChild(bd);
    w = document.createElement('div'); w.id = 'skx'; w.setAttribute('role', 'dialog'); w.setAttribute('aria-modal', 'true'); document.body.appendChild(w);
    bd.addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    requestAnimationFrame(function () { bd.classList.add('on'); w.classList.add('on'); });
    send({ ev: 'shown' });
    render('<p>' + t.q + '</p><div class="opts">' + t.o.map(function (o, i) { return '<button type="button" class="o" data-i="' + i + '">' + esc(o) + '<span>›</span></button>'; }).join('') + '</div>');
    w.querySelectorAll('.o').forEach(function (b) { b.addEventListener('click', function () { answer(CODES[+b.dataset.i]); }); });
  }

  function answer(a) {
    send({ ev: 'answer', a: a });
    if (a === 'price') return codeScreen('price', 'code10', t.price);
    if (a === 'shipping') {
      var pct = Math.min(100, Math.round(cartTotal / threshold * 100));
      if (cartTotal >= threshold) {
        // al boven de drempel → geen korting, alleen doorsturen naar de cart drawer (toont 'Shipping: Free')
        render('<p>' + t.shipFree(cartTotal, threshold) + '</p><div class="bar"><i style="width:100%"></i></div>' + row(null, t.shipCheckout));
        btn('b').addEventListener('click', function () { send({ ev: 'follow', a: 'shipping', sub: 'checkout_free' }); goCart(); });
        return;
      }
      var opts = '<button class="o" data-s="products">' + esc(cartTotal >= 50 ? t.shipAdd : t.shipO[0]) + '<span>›</span></button>' + (cartTotal < 50 ? '<button class="o" data-s="toomuch">' + esc(t.shipO[1]) + '<span>›</span></button>' : '');
      render('<p>' + t.ship1(cartTotal, threshold) + '</p><div class="bar"><i style="width:' + pct + '%"></i></div><div class="opts">' + opts + '</div>');
      w.querySelector('[data-s=products]').addEventListener('click', function () { send({ ev: 'follow', a: 'shipping', sub: 'products' }); location.href = (loc === 'en' ? '' : '/' + loc) + BESTSELLERS; });
      var tm = w.querySelector('[data-s=toomuch]'); if (tm) tm.addEventListener('click', function () { codeScreen('shipping', 'codeship', t.ship2); });
      return;
    }
    if (a === 'sizing') {
      render('<p>' + t.size + '</p><button class="btn pri" data-k="g" style="margin-top:10px">' + t.sizeBtn + '</button><p style="margin-top:12px">' + t.size2 + '</p><textarea placeholder="' + esc(t.ph) + '" maxlength="300"></textarea>' + row(t.skip, t.send));
      btn('g').addEventListener('click', function () {
        send({ ev: 'follow', a: 'sizing', sub: 'guide' });
        var l = document.querySelector('.size-guide-link'), ov = document.getElementById('size-guide-overlay');
        if (!l || !ov) {
          // geen product-maattabel op deze pagina (collectie/cart) → de algemene maattabel-pagina in een eigen modal, zelfde blur eromheen
          w.style.display = 'none';
          var m = document.createElement('div'); m.id = 'skx-sg';
          m.style.cssText = 'position:fixed;inset:0;z-index:1000001;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(0,0,0,.35)';
          m.innerHTML = '<div style="background:#fff;border-radius:16px;width:min(560px,100%);max-height:86vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.3)"><div style="display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid #eee"><b style="font-size:18px">Size guide</b><button type="button" aria-label="' + t.close + '" style="border:0;background:transparent;font-size:24px;line-height:1;cursor:pointer;color:#333">×</button></div><div class="sk-sg-body" style="padding:6px 18px 18px;overflow:auto;font-size:14px;line-height:1.5;-webkit-overflow-scrolling:touch">…</div></div>';
          // Shopify staat framen niet toe (frame-ancestors none) → de maattabel-pagina ophalen en de inhoud (.rte) in de modal zetten
          fetch((loc === 'en' ? '' : '/' + loc) + '/pages/size-guide').then(function (r) { return r.text(); }).then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var rte = doc.querySelector('main .rte') || doc.querySelector('.rte') || doc.querySelector('main');
            var body = m.querySelector('.sk-sg-body');
            if (!rte) { body.innerHTML = '<a href="' + (loc === 'en' ? '' : '/' + loc) + '/pages/size-guide" target="_blank" rel="noopener">Open size guide ↗</a>'; return; }
            rte.querySelectorAll('script,style,iframe').forEach(function (x) { x.remove(); });
            rte.querySelectorAll('table').forEach(function (tb) { tb.removeAttribute('border'); tb.removeAttribute('cellpadding'); tb.style.cssText = 'width:100%;border-collapse:collapse;font-size:13px;margin:10px 0;border:0'; tb.querySelectorAll('td,th').forEach(function (c) { c.removeAttribute('style'); c.style.cssText = 'padding:8px 8px;border:0;border-bottom:1px solid #eee;text-align:left;vertical-align:middle'; }); tb.querySelectorAll('th, tr:first-child td').forEach(function (c) { c.style.background = '#f5f5f5'; c.style.fontWeight = '700'; }); });
            rte.querySelectorAll('p,h1,h2,h3,h4,div').forEach(function (e) { e.style.textAlign = 'left'; });
            rte.querySelectorAll('img').forEach(function (i) { i.style.maxWidth = '100%'; i.style.height = 'auto'; });
            body.innerHTML = ''; body.appendChild(rte);
          }).catch(function () { m.querySelector('.sk-sg-body').innerHTML = '<a href="' + (loc === 'en' ? '' : '/' + loc) + '/pages/size-guide" target="_blank" rel="noopener">Open size guide ↗</a>'; });
          document.body.appendChild(m);
          var closeSg = function () { if (m.parentNode) m.parentNode.removeChild(m); w.style.display = ''; var ta = w.querySelector('textarea'); if (ta) ta.focus(); };
          m.querySelector('button').addEventListener('click', closeSg);
          m.addEventListener('click', function (e) { if (e.target === m) closeSg(); });
          return;
        }
        // theme-modal boven onze blur tonen, badge even verbergen; zodra de maattabel sluit komt de vraag terug
        w.style.display = 'none'; ov.style.zIndex = '1000001';
        l.click();
        var mo = new MutationObserver(function () {
          if (getComputedStyle(ov).display === 'none') { mo.disconnect(); ov.style.zIndex = ''; w.style.display = ''; var ta = w.querySelector('textarea'); if (ta) ta.focus(); }
        });
        mo.observe(ov, { attributes: true, attributeFilter: ['style', 'class'] });
      });
      btn('a').addEventListener('click', close);
      btn('b').addEventListener('click', function () { var v = w.querySelector('textarea').value.trim(); if (v) send({ ev: 'follow', a: 'sizing', sub: 'feedback', o: v }); thanks(); });
      return;
    }
    if (a === 'faster_doubt') {
      render('<p>' + t.fast + '</p>' + row(t.fastA, t.fastB));
      btn('a').addEventListener('click', function () { send({ ev: 'follow', a: 'faster_doubt', sub: 'report' }); window.open(REPORT, '_blank', 'noopener'); });
      btn('b').addEventListener('click', function () { send({ ev: 'follow', a: 'faster_doubt', sub: 'blog' }); window.open(BLOG[loc] || BLOG.en, '_blank', 'noopener'); });
      return;
    }
    if (a === 'delivery') {
      render('<p>' + deliveryText() + '</p>' + row(null, t.gotit));
      btn('b').addEventListener('click', function () { send({ ev: 'follow', a: 'delivery', sub: 'gotit' }); close(); });
      return;
    }
    if (a === 'browsing') {
      render('<p>' + t.browse + '</p><input type="email" placeholder="' + esc(t.email) + '" autocomplete="email">' + row(t.skip, t.browseBtn) + '<small>Privacy policy · unsubscribe any time</small>');
      btn('a').addEventListener('click', close);
      btn('b').addEventListener('click', function () {
        var em = w.querySelector('input[type=email]').value.trim(); if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)) return;
        send({ ev: 'follow', a: 'browsing', sub: 'join' });
        try {
          fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + KLAVIYO_COMPANY, { method: 'POST', headers: { 'Content-Type': 'application/json', 'revision': '2024-10-15' },
            body: JSON.stringify({ data: { type: 'subscription', attributes: { custom_source: 'exit-intent-browsing', profile: { data: { type: 'profile', attributes: { email: em, subscriptions: { email: { marketing: { consent: 'SUBSCRIBED' } } } } } } }, relationships: { list: { data: { type: 'list', id: KLAVIYO_LIST } } } } }) }).catch(function () {});
        } catch (e) {}
        render('<p>' + t.browseOk + '</p>'); setTimeout(close, 1800);
      });
      return;
    }
    // other
    render('<p>' + t.other + '</p><textarea placeholder="' + esc(t.ph) + '" maxlength="300"></textarea>' + row(t.skip, t.send));
    btn('a').addEventListener('click', close);
    btn('b').addEventListener('click', function () { var v = w.querySelector('textarea').value.trim(); if (v) send({ ev: 'follow', a: 'other', sub: 'text', o: v }); thanks(); });
  }

  function trigger() { cartFetch(show); }
  // Desktop: muis verlaat het venster aan de bovenkant, na minimaal 8 s
  if (!isMobile) {
    document.addEventListener('mouseout', function (e) { if (e.relatedTarget || e.toElement) return; if (e.clientY <= 0 && Date.now() - start > 8000) trigger(); });
  } else {
    // Mobiel: snel omhoog scrollen na 25 s, of 60 s inactief op PDP
    var lastY = window.scrollY, lastT = Date.now();
    window.addEventListener('scroll', function () { var y = window.scrollY, now = Date.now(); if (lastY - y > 350 && now - lastT < 400 && now - start > 25000 && y < 600) trigger(); lastY = y; lastT = now; }, { passive: true });
    if (page === 'product') setTimeout(function () { if (!shown && document.visibilityState === 'visible') trigger(); }, 60000);
  }
  if (TEST) setTimeout(trigger, 800);

})();
</script>
