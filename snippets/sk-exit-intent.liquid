  function render(body) { w.innerHTML = head() + body + '<input type="text" name="hp" style="display:none" tabindex="-1" autocomplete="off"><button class="x" aria-label="' + t.close + '">×</button>'; w.querySelector('.x').addEventListener('click', close); }
