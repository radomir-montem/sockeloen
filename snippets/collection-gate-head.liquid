{%- comment -%}
  Early access gate, head part: decides synchronously whether this page is locked so the
  products never flash before the sheet appears. The password itself never reaches the page:
  only its sha256 does, and the remembered token is that same hash. See collection-gate.liquid.
{%- endcomment -%}
{%- liquid
  assign gate_on = false
  if settings.gate_enabled and settings.gate_password != blank and settings.gate_collection != blank
    if template.name == 'collection' and collection.handle == settings.gate_collection.handle
      assign gate_on = true
    elsif template.name == 'product'
      for c in product.collections
        if c.handle == settings.gate_collection.handle
          assign gate_on = true
        endif
      endfor
    endif
  endif
-%}
{%- if gate_on -%}
  {%- assign gate_hash = settings.gate_password | strip | downcase | sha256 -%}
  <style>
    /* the page stays as a blurred silhouette behind the sheet (you can tell it is a collection), but nothing is readable or clickable */
    html.gate-locked #MainContent, html.gate-locked .shopify-section-group-footer-group, html.gate-locked #shopify-section-footer {
      filter: blur(14px) saturate(120%) !important; pointer-events: none !important; user-select: none !important; }
    html.gate-locked { overflow: hidden; }
    /* no Klaviyo popups or flyouts on the password-protected pages, locked or unlocked:
       whoever gets in is already on the list */
    form.klaviyo-form,
    [class*="kl-private-reset-css"]:has(form.klaviyo-form) { display: none !important; }
  </style>
  <script>
    (function () {
      window.__skNoKlaviyo = true;
      window.__skGate = { hash: '{{ gate_hash }}', key: 'sk_gate_{{ settings.gate_collection.handle }}', days: {{ settings.gate_days | default: 7 }} };
      var ok = false;
      try { var t = JSON.parse(localStorage.getItem(window.__skGate.key) || 'null'); ok = !!(t && t.h === window.__skGate.hash && Date.now() < t.exp); } catch (e) {}
      if (!ok) document.documentElement.classList.add('gate-locked');
    })();
  </script>
{%- endif -%}
