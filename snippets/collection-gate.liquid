{%- comment -%}
  Early access gate, body part: the glass password sheet (same look as the sign-up sheet on
  the Black Friday / AWE pages). Rendered only when collection-gate-head.liquid locked the page.
{%- endcomment -%}
{%- liquid
  assign gate_on = false
  if settings.gate_enabled and settings.gate_password != blank and settings.gate_collection != blank
    if template.name == 'collection' and collection.handle == settings.gate_collection.handle
      assign gate_on = true
    elsif template.name == 'product'
      for c in product.collections
        if c.handle == settings.gate_collection.handle
          assign gate_on = true
        endif
      endfor
    endif
  endif
-%}
{%- if gate_on -%}
<div id="SkGate" class="sk-gate" role="dialog" aria-modal="true" aria-labelledby="SkGateTitle" hidden>
  <div class="sk-gate__inner">
    {%- if settings.gate_kicker != blank -%}<p class="sk-gate__kicker">{{ settings.gate_kicker | escape }}</p>{%- endif -%}
    <h1 class="sk-gate__title" id="SkGateTitle">{{ settings.gate_heading | escape }}</h1>
    {%- if settings.gate_text != blank -%}<p class="sk-gate__text">{{ settings.gate_text | escape }}</p>{%- endif -%}
    <form class="sk-gate__form" novalidate>
      <input class="sk-gate__input" type="password" name="password" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="{{ settings.gate_placeholder | escape }}" aria-label="{{ settings.gate_placeholder | escape }}" required>
      <p class="sk-gate__error" hidden>{{ settings.gate_error | escape }}</p>
      <button type="submit" class="sk-gate__submit">{{ settings.gate_button | escape }}</button>
    </form>
    {%- if settings.gate_signup_url != blank and settings.gate_signup_text != blank -%}
      <a class="sk-gate__signup" href="{{ settings.gate_signup_url }}">{{ settings.gate_signup_text | escape }}</a>
    {%- endif -%}
  </div>
</div>
<style>
  html.gate-locked #SkGate { display: flex; }
  #SkGate { position: fixed; inset: 0; z-index: 100000; display: none; align-items: center; justify-content: center; padding: 96px 24px 40px; overflow: auto;
    color: #111; text-align: center; background: rgba(255,255,255,.72); backdrop-filter: blur(40px) saturate(160%); -webkit-backdrop-filter: blur(40px) saturate(160%); }
  #SkGate[hidden] { display: none !important; }
  #SkGate .sk-gate__inner { width: 100%; max-width: 420px; }
  #SkGate .sk-gate__kicker { margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #555; }
  #SkGate .sk-gate__title { margin: 0 0 12px; font-size: 32px; line-height: 1.1; font-weight: 700; letter-spacing: -.01em; }
  #SkGate .sk-gate__text { margin: 0 0 24px; font-size: 16px; line-height: 1.5; color: #333; }
  #SkGate .sk-gate__form { display: grid; gap: 10px; }
  #SkGate .sk-gate__input { width: 100%; height: 52px; padding: 0 16px; font-size: 16px; color: #111; background: rgba(255,255,255,.85); border: 1px solid rgba(0,0,0,.14); border-radius: 8px; outline: none; text-align: center; letter-spacing: .06em; }
  #SkGate .sk-gate__input:focus { border-color: #111; box-shadow: 0 0 0 3px rgba(0,0,0,.08); background: #fff; }
  #SkGate .sk-gate__input[aria-invalid="true"] { border-color: #d9202a; }
  #SkGate .sk-gate__error { margin: 0; font-size: 13px; color: #d9202a; }
  #SkGate .sk-gate__submit { height: 52px; border: 0; border-radius: 8px; background: #111; color: #fff; font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }
  #SkGate .sk-gate__submit:hover { background: #000; }
  #SkGate .sk-gate__signup { display: inline-block; margin-top: 20px; font-size: 14px; color: #111; text-decoration: underline; text-underline-offset: 3px; }
  #SkGate.is-shaking .sk-gate__form { animation: sk-gate-shake .35s; }
  @keyframes sk-gate-shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
</style>
<script>
  (function () {
    var G = window.__skGate; if (!G) return;
    var el = document.getElementById('SkGate'), form = el.querySelector('form'), inp = el.querySelector('input'), err = el.querySelector('.sk-gate__error');
    function sha256(s) {
      var enc = new TextEncoder().encode(s);
      return crypto.subtle.digest('SHA-256', enc).then(function (buf) { return Array.prototype.map.call(new Uint8Array(buf), function (b) { return ('0' + b.toString(16)).slice(-2); }).join(''); });
    }
    function unlock() {
      try { localStorage.setItem(G.key, JSON.stringify({ h: G.hash, exp: Date.now() + G.days * 864e5 })); } catch (e) {}
      document.documentElement.classList.remove('gate-locked'); el.hidden = true;
    }
    function tryPassword(v, fromLink) {
      v = String(v || '').trim().toLowerCase(); if (!v) return Promise.resolve(false);
      return sha256(v).then(function (h) {
        if (h === G.hash) { unlock(); return true; }
        if (!fromLink) { inp.setAttribute('aria-invalid', 'true'); err.hidden = false; el.classList.add('is-shaking'); setTimeout(function () { el.classList.remove('is-shaking'); }, 400); inp.focus(); }
        return false;
      });
    }
    var locked = document.documentElement.classList.contains('gate-locked');
    var key = new URLSearchParams(location.search).get('key');
    if (key) {
      tryPassword(key, true).then(function (ok) {
        try { var u = new URL(location.href); u.searchParams.delete('key'); history.replaceState(null, '', u.pathname + (u.search || '') + u.hash); } catch (e) {}
        if (!ok && locked) { el.hidden = false; }
      });
    } else if (locked) { el.hidden = false; }
    form.addEventListener('submit', function (e) { e.preventDefault(); tryPassword(inp.value, false); });
    inp.addEventListener('input', function () { inp.removeAttribute('aria-invalid'); err.hidden = true; });
    if (locked) setTimeout(function () { try { inp.focus(); } catch (e) {} }, 300);
  })();
</script>
{%- endif -%}
