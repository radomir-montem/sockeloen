{%- comment -%}
  Early access gate, body part: the glass password sheet (same look as the sign-up sheet on
  the Black Friday / AWE pages: white kicker in the editor's own casing, same title, field
  and button; the collection has no video behind it, so the glass carries a grey tint). Rendered only when collection-gate-head.liquid locked the page.
{%- endcomment -%}
{%- liquid
  assign gate_on = false
  if settings.gate_enabled and settings.gate_password != blank and settings.gate_collection != blank
    if template.name == 'collection' and collection.handle == settings.gate_collection.handle
      assign gate_on = true
    elsif template.name == 'product'
      capture gate_flag
        render 'gate-product-check', product: product
      endcapture
      if gate_flag contains 'true'
        assign gate_on = true
      endif
    endif
  endif
-%}
{%- if gate_on -%}
<div id="SkGate" class="sk-gate" role="dialog" aria-modal="true" aria-labelledby="SkGateTitle" hidden>
  <div class="sk-gate__inner">
    {%- if settings.gate_kicker != blank -%}<p class="sk-gate__kicker">{{ settings.gate_kicker | escape }}</p>{%- endif -%}
    <h1 class="sk-gate__title" id="SkGateTitle">{{ settings.gate_heading | escape }}</h1>
    {%- if settings.gate_text != blank -%}<p class="sk-gate__text">{{ settings.gate_text | escape }}</p>{%- endif -%}
    <form class="sk-gate__form" novalidate>
      {%- comment -%} lock on the left, show/hide on the right, typed characters as wide-spaced dots {%- endcomment -%}
      <div class="sk-gate__field">
        <svg class="sk-gate__lock" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>
        <input class="sk-gate__input" type="password" name="password" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="{{ settings.gate_placeholder | escape }}" aria-label="{{ settings.gate_placeholder | escape }}" required>
        <button type="button" class="sk-gate__toggle" aria-label="Show password" aria-pressed="false">
          <svg class="sk-gate__eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/><path class="sk-gate__eye-slash" d="M4 4l16 16"/></svg>
        </button>
      </div>
      <p class="sk-gate__error" hidden>{{ settings.gate_error | escape }}</p>
      <button type="submit" class="sk-gate__submit">{{ settings.gate_button | escape }}</button>
    </form>
    {%- if settings.gate_signup_url != blank and settings.gate_signup_text != blank -%}
      {%- comment -%} #signup opens the sign-up sheet (step 1) on the Black Friday / AWE pages straight away {%- endcomment -%}
      {%- assign gate_signup_href = settings.gate_signup_url -%}
      {%- unless gate_signup_href contains '#' -%}{%- assign gate_signup_href = gate_signup_href | append: '#signup' -%}{%- endunless -%}
      <a class="sk-gate__signup" href="{{ gate_signup_href }}">{{ settings.gate_signup_text | escape }}</a>
    {%- endif -%}
  </div>
</div>
<style>
  html.gate-locked #SkGate { display: flex; }
  #SkGate { position: fixed; inset: 0; z-index: 100000; display: none; align-items: center; justify-content: center; padding: 96px 24px 40px; overflow: auto;
    color: #111; text-align: center; background: rgba(150,150,150,.55); backdrop-filter: blur(40px) saturate(160%); -webkit-backdrop-filter: blur(40px) saturate(160%); }
  #SkGate[hidden] { display: none !important; }
  #SkGate .sk-gate__inner { width: 100%; max-width: 440px; }
  #SkGate .sk-gate__kicker { margin: 0 0 12px; font-size: 12px; font-weight: 700; color: #fff; }
  #SkGate .sk-gate__title { margin: 0 0 12px; font-size: 32px; line-height: 1.08; font-weight: 700; letter-spacing: -.01em; color: #111; text-wrap: balance; }
  #SkGate .sk-gate__text { margin: 0 0 24px; font-size: 15px; line-height: 1.5; color: #333; }
  #SkGate .sk-gate__form { display: grid; gap: 12px; }
  #SkGate .sk-gate__field { position: relative; }
  #SkGate .sk-gate__lock { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #666; pointer-events: none; }
  #SkGate .sk-gate__input { width: 100%; height: 52px; padding: 0 52px 0 46px; font-size: 16px; color: #111; background: rgba(255,255,255,.85); border: 1px solid rgba(0,0,0,.14); border-radius: 8px; outline: none; box-sizing: border-box; text-align: left; }
  #SkGate .sk-gate__input[type="password"]:not(:placeholder-shown) { letter-spacing: .3em; font-weight: 700; }
  #SkGate .sk-gate__input::placeholder { color: #8a8a8a; letter-spacing: 0; font-weight: 400; }
  #SkGate .sk-gate__toggle { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; display: grid; place-items: center; padding: 0; border: 0; background: none; color: #666; cursor: pointer; border-radius: 6px; }
  #SkGate .sk-gate__toggle:hover { color: #111; }
  #SkGate .sk-gate__toggle:focus-visible { outline: 2px solid #111; outline-offset: -4px; }
  #SkGate .sk-gate__toggle[aria-pressed="true"] .sk-gate__eye-slash { display: none; }
  #SkGate .sk-gate__input:focus { border-color: #111; box-shadow: 0 0 0 3px rgba(0,0,0,.08); background: #fff; }
  #SkGate .sk-gate__input[aria-invalid="true"] { border-color: #d9202a; }
  #SkGate .sk-gate__error { margin: 0; font-size: 13px; color: #d9202a; }
  #SkGate .sk-gate__submit { height: 52px; border: 2px solid #111; border-radius: 8px; background: #111; color: #fff; font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; cursor: pointer; transition: background-color .2s ease; }
  #SkGate .sk-gate__submit:hover { background: #333; border-color: #333; }
  #SkGate .sk-gate__signup { display: inline-block; margin-top: 12px; padding: 16px 0; font-size: 14px; color: #111; text-decoration: none; }
  #SkGate.is-shaking .sk-gate__form { animation: sk-gate-shake .35s; }
  @keyframes sk-gate-shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
</style>
<script>
  (function () {
    var G = window.__skGate; if (!G) return;
    var el = document.getElementById('SkGate'), form = el.querySelector('form'), inp = el.querySelector('input'), err = el.querySelector('.sk-gate__error');
    function sha256(s) {
      var enc = new TextEncoder().encode(s);
      return crypto.subtle.digest('SHA-256', enc).then(function (buf) { return Array.prototype.map.call(new Uint8Array(buf), function (b) { return ('0' + b.toString(16)).slice(-2); }).join(''); });
    }
    function unlock() {
      try { (G.days > 0 ? localStorage : sessionStorage).setItem(G.key, JSON.stringify({ h: G.hash, exp: Date.now() + G.days * 864e5 })); } catch (e) {}
      document.documentElement.classList.remove('gate-locked'); el.hidden = true;
    }
    function tryPassword(v, fromLink) {
      v = String(v || '').trim().toLowerCase(); if (!v) return Promise.resolve(false);
      return sha256(v).then(function (h) {
        if (h === G.hash) { unlock(); return true; }
        if (!fromLink) { inp.setAttribute('aria-invalid', 'true'); err.hidden = false; el.classList.add('is-shaking'); setTimeout(function () { el.classList.remove('is-shaking'); }, 400); inp.focus(); }
        return false;
      });
    }
    var locked = document.documentElement.classList.contains('gate-locked');
    var key = new URLSearchParams(location.search).get('key');
    if (key) {
      tryPassword(key, true).then(function (ok) {
        try { var u = new URL(location.href); u.searchParams.delete('key'); history.replaceState(null, '', u.pathname + (u.search || '') + u.hash); } catch (e) {}
        if (!ok && locked) { el.hidden = false; }
      });
    } else if (locked) { el.hidden = false; }
    form.addEventListener('submit', function (e) { e.preventDefault(); tryPassword(inp.value, false); });
    var toggle = el.querySelector('.sk-gate__toggle');
    if (toggle) toggle.addEventListener('click', function () {
      var show = inp.type === 'password';
      inp.type = show ? 'text' : 'password';
      toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
      toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
      inp.focus();
    });
    inp.addEventListener('input', function () { inp.removeAttribute('aria-invalid'); err.hidden = true; });
    if (locked) setTimeout(function () { try { inp.focus(); } catch (e) {} }, 300);
  })();
</script>
{%- endif -%}
