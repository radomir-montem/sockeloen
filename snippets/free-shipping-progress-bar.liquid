{% liquid
  assign free_shipping = settings.free_shipping | times: 100
  assign free_gift = settings.free_gift_threshold | times: 100
  assign has_free_gift = false
  if free_gift > 0 and settings.free_gift_collection != blank
    assign has_free_gift = true
  endif
  assign bar_max = free_shipping
  if has_free_gift
    assign bar_max = free_gift
  endif
  assign percent = cart.total_price | times: 1.0 | divided_by: bar_max | times: 100 | at_most: 100
  assign shipping_marker_percent = free_shipping | times: 1.0 | divided_by: bar_max | times: 100 | at_most: 100
  assign shipping_reached = false
  assign gift_reached = false
  if cart.total_price >= free_shipping
    assign shipping_reached = true
  endif
  if has_free_gift and cart.total_price >= free_gift
    assign gift_reached = true
  endif
  assign gift_remaining = free_gift | minus: cart.total_price | money_without_currency
%}
<div class="mb-8 free_shipping_container{% if has_free_gift %} has-free-gift{% endif %}"
  data-total="{{ cart.total_price }}"
  data-shipping-limit="{{ settings.free_shipping }}"
  data-gift-limit="{{ settings.free_gift_threshold }}"
  data-has-free-gift="{{ has_free_gift }}"
  data-reached-text="{{ 'sections.cart.free_shipping_reached' | t | escape }}"
  data-away-text="{{ 'sections.cart.free_shipping_away_html' | t: amount: '__AMOUNT__' | escape }}"
  data-gift-reached-text="{{ 'sections.cart.free_gift_reached' | t | escape }}"
  data-gift-away-text="{{ 'sections.cart.free_gift_away_html' | t: amount: '__AMOUNT__' | escape }}"
  data-both-reached-text="{{ 'sections.cart.free_shipping_and_gift_reached' | t | escape }}">
  <h4 class="text-[14px] leading-6 tracking-wider font-light text-base-text mb-3 {{ classes }}">
    {% if gift_reached %}
      <span class="free_shipping_text ml-0">{{ 'sections.cart.free_shipping_and_gift_reached' | t }}</span>
    {% elsif shipping_reached and has_free_gift %}
      <span class="free_shipping_prev_text">{{ 'sections.cart.free_gift_away_html' | t: amount: '' | split: '<strong>' | first }}</span>
      <span data-limit="{{ settings.free_gift_threshold }}" class="free_shipping free_gift_amount font-bold text-black">{{ gift_remaining }}</span>
      <span class="free_shipping_text">{{ 'sections.cart.free_gift_away_suffix_html' | t }}</span>
    {% elsif shipping_reached %}
      <span class="free_shipping_text ml-0">{{ 'sections.cart.free_shipping_reached' | t }}</span>
    {% else %}
      <span class="free_shipping_prev_text">{{ 'sections.cart.free_shipping_away_html' | t: amount: '' | split: '<strong>' | first }}</span>
      <span data-limit="{{ settings.free_shipping }}" class="free_shipping font-bold text-black">{{ free_shipping | minus: cart.total_price | money_without_currency }}</span>
      <span class="free_shipping_text">{{ 'sections.cart.free_shipping_away_suffix_html' | t }}</span>
    {% endif %}
  </h4>
  <div class="w-full h-[12px] bg-[#D9D9D9] rounded-[6px] flex relative progress_bar_track">
    <div class="w-0 h-full !inline-block rounded-[6px] progressive_bar_shipping_price {% if gift_reached %}bg-[#0395F6]{% elsif shipping_reached %}bg-[#0395F6]{% else %}bg-[#F76503]{% endif %}" style="width: {{ percent }}%"></div>
    {% if has_free_gift %}
      <span class="progress_bar_milestone progress_bar_milestone--shipping{% if shipping_reached %} is-reached{% endif %}" style="left: {{ shipping_marker_percent }}%;" title="{{ 'sections.cart.free_shipping_reached' | t }}">
        {% render 'icon-truck' %}
      </span>
      <span class="progress_bar_milestone progress_bar_milestone--gift{% if gift_reached %} is-reached{% endif %}" style="left: 100%;" title="{{ 'sections.cart.free_gift_reached' | t }}">
        {% render 'icon-gift' %}
      </span>
    {% endif %}
  </div>
  {% if has_free_gift %}
    <div class="progress_bar_labels">
      <span class="progress_bar_label progress_bar_label--shipping{% if shipping_reached %} is-reached{% endif %}" style="left: {{ shipping_marker_percent }}%;">
        <span class="progress_bar_label__amount">{{ settings.free_shipping | times: 100 | money }}</span>
        <span class="progress_bar_label__name">{{ 'sections.cart.free_shipping_label' | t }}</span>
      </span>
      <span class="progress_bar_label progress_bar_label--gift{% if gift_reached %} is-reached{% endif %}" style="left: 100%;">
        <span class="progress_bar_label__amount">{{ settings.free_gift_threshold | times: 100 | money }}</span>
        <span class="progress_bar_label__name">{{ 'sections.cart.free_gift_label' | t }}</span>
      </span>
    </div>
  {% endif %}
</div>
{% if has_free_gift %}
  {% render 'free-gift-widget', gift_reached: gift_reached, gift_remaining: gift_remaining %}
{% endif %}
