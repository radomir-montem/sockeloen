{% liquid
  assign free_shipping = settings.free_shipping | times: 100
  assign second_tier_type = settings.second_tier_type | default: 'gift'
  assign second_tier = settings.second_tier_threshold | times: 100

  assign has_second_tier = false
  if second_tier_type == 'express_shipping' and settings.second_tier_threshold > 0
    assign has_second_tier = true
  elsif second_tier_type == 'gift' and settings.second_tier_threshold > 0 and settings.free_gift_collection != blank
    assign has_second_tier = true
  endif

  comment
    Translation keys differ depending on whether the second tier is a
    Free Gift or Free Express Shipping, so the store can offer either
    reward per market without duplicating this whole template.
  endcomment
  assign second_tier_reached_key = 'sections.cart.free_gift_reached'
  assign second_tier_away_prefix_key = 'sections.cart.free_gift_away_html'
  assign second_tier_away_suffix_key = 'sections.cart.free_gift_away_suffix_html'
  assign second_tier_label_key = 'sections.cart.free_gift_label'
  assign both_reached_key = 'sections.cart.free_shipping_and_gift_reached_html'
  if second_tier_type == 'express_shipping'
    assign second_tier_reached_key = 'sections.cart.free_express_shipping_reached'
    assign second_tier_away_prefix_key = 'sections.cart.free_express_shipping_away_html'
    assign second_tier_away_suffix_key = 'sections.cart.free_express_shipping_away_suffix_html'
    assign second_tier_label_key = 'sections.cart.free_express_shipping_label'
    assign both_reached_key = 'sections.cart.free_shipping_and_express_reached_html'
  endif

  assign bar_max = free_shipping
  if has_second_tier
    assign bar_max = second_tier
  endif

  comment
    Two-segment scale: €0-bar_baseline maps into a small "low_zone" sliver of
    the bar (so low cart values are still visible), and bar_baseline-bar_max
    maps into the remaining width up to bar_top_percent, keeping visual focus
    on the zone where the average order value actually sits.
    The last overshoot_percent of the bar is left as headroom past the second
    tier threshold, so the bar visibly has "more room to grow" beyond it.
  endcomment
  assign bar_baseline = 5000
  assign bar_range = bar_max | minus: bar_baseline
  assign low_zone_percent = 15
  assign overshoot_percent = 10
  assign overshoot_amount = 3000
  assign bar_top_percent = 100 | minus: overshoot_percent
  assign high_zone_percent = bar_top_percent | minus: low_zone_percent

  assign percent = cart.total_price | times: 1.0 | divided_by: bar_baseline | times: low_zone_percent
  if cart.total_price > bar_baseline and cart.total_price <= bar_max
    assign percent = cart.total_price | minus: bar_baseline | times: 1.0 | divided_by: bar_range | times: high_zone_percent | plus: low_zone_percent
  elsif cart.total_price > bar_max
    assign percent = cart.total_price | minus: bar_max | times: 1.0 | divided_by: overshoot_amount | times: overshoot_percent | plus: bar_top_percent
  endif
  assign percent = percent | at_least: 0 | at_most: 100

  assign shipping_marker_percent = free_shipping | times: 1.0 | divided_by: bar_baseline | times: low_zone_percent
  if free_shipping > bar_baseline
    assign shipping_marker_percent = free_shipping | minus: bar_baseline | times: 1.0 | divided_by: bar_range | times: high_zone_percent | plus: low_zone_percent
  endif
  assign shipping_marker_percent = shipping_marker_percent | at_least: 0 | at_most: 100

  assign shipping_reached = false
  assign second_tier_reached = false
  if cart.total_price >= free_shipping
    assign shipping_reached = true
  endif
  if has_second_tier and cart.total_price >= second_tier
    assign second_tier_reached = true
  endif
  assign second_tier_remaining = second_tier | minus: cart.total_price | money_without_currency

  assign reward_state = 'none'
  if shipping_reached
    assign reward_state = 'shipping'
  endif
  if second_tier_reached
    assign reward_state = 'gift'
  endif
%}
<div class="mb-8 free_shipping_container reward-state--{{ reward_state }}{% if has_second_tier %} has-free-gift{% endif %}"
  data-total="{{ cart.total_price }}"
  data-gift-limit="{{ settings.second_tier_threshold }}"
  data-has-free-gift="{{ has_second_tier }}">
  <h4 class="progress_bar_headline text-[14px] leading-6 tracking-wider font-light text-base-text mb-3 {{ classes }}">
    {% if second_tier_reached %}
      <span class="free_shipping_text ml-0">{{ both_reached_key | t }}</span>
    {% elsif shipping_reached and has_second_tier %}
      <span class="free_shipping_prev_text">{{ second_tier_away_prefix_key | t: amount: '' | split: '<strong>' | first }}</span>
      <span data-limit="{{ settings.second_tier_threshold }}" class="free_shipping free_gift_amount font-bold text-black">€{{ second_tier_remaining }}</span>
      <span class="free_shipping_text">{{ second_tier_away_suffix_key | t }}</span>
    {% elsif shipping_reached %}
      <span class="free_shipping_text ml-0">✓ {{ 'sections.cart.free_shipping_reached' | t }}</span>
    {% else %}
      <span class="free_shipping_prev_text">{{ 'sections.cart.free_shipping_away_html' | t: amount: '' | split: '<strong>' | first }}</span>
      <span data-limit="{{ settings.free_shipping }}" class="free_shipping font-bold text-black">€{{ free_shipping | minus: cart.total_price | money_without_currency }}</span>
      <span class="free_shipping_text">{{ 'sections.cart.free_shipping_away_suffix_html' | t }}</span>
    {% endif %}
  </h4>
  <div class="progress_bar_track">
    <div class="progressive_bar_shipping_price{% if shipping_reached %} is-reached{% endif %}" style="width: {{ percent }}%"></div>
    {% if has_second_tier %}
      <span class="progress_bar_milestone progress_bar_milestone--shipping{% if shipping_reached %} is-reached{% endif %}" style="left: {{ shipping_marker_percent }}%;" title="{{ 'sections.cart.free_shipping_reached' | t }}">
        <span class="progress_bar_milestone__badge">
          {% render 'icon-milestone-check' %}
        </span>
      </span>
      <span class="progress_bar_milestone progress_bar_milestone--gift{% if second_tier_reached %} is-reached{% endif %}" style="left: {{ bar_top_percent }}%;" title="{{ second_tier_reached_key | t }}">
        <span class="progress_bar_milestone__badge">
          {% render 'icon-milestone-check' %}
        </span>
      </span>
    {% endif %}
  </div>
  {% if has_second_tier %}
    <div class="progress_bar_labels">
      <span class="progress_bar_label progress_bar_label--shipping{% if shipping_reached %} is-reached{% endif %}" style="left: {{ shipping_marker_percent }}%;">
        <span class="progress_bar_label__amount">€{{ settings.free_shipping | times: 100 | money_without_currency }}</span>
        <span class="progress_bar_label__name">{{ 'sections.cart.free_shipping_label' | t }}</span>
      </span>
      <span class="progress_bar_label progress_bar_label--gift{% if second_tier_reached %} is-reached{% endif %}" style="left: {{ bar_top_percent }}%;">
        <span class="progress_bar_label__amount">€{{ settings.second_tier_threshold | times: 100 | money_without_currency }}</span>
        <span class="progress_bar_label__name">{{ second_tier_label_key | t }}</span>
      </span>
    </div>
  {% endif %}
</div>
{% if has_second_tier and second_tier_type == 'gift' and hide_gift_widget != true %}
  {% render 'free-gift-widget', gift_reached: second_tier_reached, gift_remaining: second_tier_remaining %}
{% endif %}
