{% comment %}
  Size guide modal — renders contextual size chart.
  Accepts an explicit guide_type override, otherwise auto-detects from product.

  Usage:
    {% render 'size-guide-modal', product: product, guide_type_override: 'socks' %}
{% endcomment %}

{%- liquid
  assign guide_type = guide_type_override | default: ''

  if guide_type == '' or guide_type == 'auto'
    comment
      Title and type are translated per locale (NL: "Overschoen", DE: "Überschuh"), so the handle (never translated) is the primary signal; the English/NL/DE words are a fallback.
    endcomment
    assign p_handle = product.handle | downcase
    assign p_type = product.type | downcase
    assign p_title = product.title | downcase
    assign p_text = p_handle | append: ' ' | append: p_type | append: ' ' | append: p_title

    assign guide_type = 'socks'
    if p_text contains 'base-layer' or p_text contains 'base layer' or p_text contains 'baselayer'
      assign guide_type = 'baselayer'
    elsif p_text contains 'glove' or p_text contains 'handschoen' or p_text contains 'handschuh'
      assign guide_type = 'gloves'
    elsif p_text contains 'toe-cover' or p_text contains 'toe cover' or p_text contains 'toecover' or p_text contains 'teenbeschermer' or p_text contains 'zehen'
      assign guide_type = 'toecovers'
    elsif p_text contains 'overshoe' or p_text contains 'shoecover' or p_text contains 'shoe-cover' or p_text contains 'shoe cover' or p_text contains 'overschoen' or p_text contains 'überschuh' or p_text contains 'couvre-chaussure' or p_text contains 'sur-chaussure'
      assign guide_type = 'overshoes'
    endif
  endif
-%}

<div class="size-guide-overlay" id="size-guide-overlay" style="display:none;">
  <div class="size-guide-modal">
    <div class="size-guide-modal__header">
      <h3 class="size-guide-modal__title">{{ 'products.v2.size_guide_title' | t }}</h3>
      <button class="size-guide-modal__close" aria-label="Close size guide" onclick="document.getElementById('size-guide-overlay').style.display='none'; document.body.classList.remove('noscroll');">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="size-guide-modal__body">
      {%- comment -%} EU -> US (men) -> UK conversion used for overshoes and toe covers {%- endcomment -%}
      {%- assign shoe_map = '35:3.5:2.5,36:4:3.5,37:5:4,38:5.5:5,39:6.5:5.5,40:7:6,41:8:7,42:8.5:7.5,43:9.5:8.5,44:10:9,45:11:10,46:11.5:10.5,47:12.5:11.5,48:13:12,49:14:13,50:15:14' | split: ',' -%}

      {% case guide_type %}

        {% when 'socks' %}
          <p class="size-guide-modal__intro">{{ 'products.v2.size_guide_socks_intro' | t }}</p>
          <table class="size-guide-table">
            <thead>
              <tr>
                <th>{{ 'products.v2.size_guide_eu_shoe_size' | t }}</th>
                <th>{{ 'products.v2.size_guide_sock_size' | t }}</th>
                <th>US Men</th>
                <th>US Women</th>
                <th>UK</th>
              </tr>
            </thead>
            <tbody>
              <tr><td><strong>39-46</strong></td><td>One Size</td><td>8-13.5</td><td>9.5-15</td><td>6.5-12</td></tr>
              <tr><td><strong>35-40</strong></td><td>XS</td><td>4.5-8.5</td><td>6-10</td><td>3-7</td></tr>
              <tr><td><strong>36-42</strong></td><td>S</td><td>5.5-10</td><td>7-11.5</td><td>4-8.5</td></tr>
              <tr><td><strong>40-45</strong></td><td>M</td><td>8.5-12.5</td><td>10-14</td><td>7-11</td></tr>
              <tr><td><strong>43-48</strong></td><td>L</td><td>10.5-15</td><td>12-16.5</td><td>9-13.5</td></tr>
              <tr><td><strong>45-50</strong></td><td>XL</td><td>12.5-16.5</td><td>14-18</td><td>11-15</td></tr>
            </tbody>
          </table>
          <p class="size-guide-modal__note">{{ 'products.v2.size_guide_socks_between' | t }}</p>
          <details class="size-guide-modal__details">
            <summary>{{ 'products.v2.size_guide_heights_title' | t }}</summary>
            <p class="size-guide-modal__intro">{{ 'products.v2.size_guide_heights_intro' | t }}</p>
            <table class="size-guide-table">
              <thead><tr><th>{{ 'products.v2.size_guide_sock_type' | t }}</th><th>cm</th><th>inch</th></tr></thead>
              <tbody>
                <tr><td><strong>{{ 'products.v2.size_guide_height_aero' | t }}</strong></td><td>17 (36-42) / 19 (43-48)</td><td>6.7 / 7.5</td></tr>
                <tr><td><strong>{{ 'products.v2.size_guide_height_cycling' | t }}</strong></td><td>19</td><td>7.5</td></tr>
                <tr><td><strong>{{ 'products.v2.size_guide_height_casual' | t }}</strong></td><td>19</td><td>7.5</td></tr>
                <tr><td><strong>{{ 'products.v2.size_guide_height_printed' | t }}</strong></td><td>17 (36-42) / 19 (43-48)</td><td>6.7 / 7.5</td></tr>
                <tr><td><strong>{{ 'products.v2.size_guide_height_low_compression' | t }}</strong></td><td>19</td><td>7.5</td></tr>
                <tr><td><strong>{{ 'products.v2.size_guide_height_high_compression' | t }}</strong></td><td>31</td><td>12.2</td></tr>
              </tbody>
            </table>
          </details>
          <details class="size-guide-modal__details">
            <summary>{{ 'products.v2.size_guide_faq_title' | t }}</summary>
            <p><strong>{{ 'products.v2.size_guide_faq_fit_q' | t }}</strong><br>{{ 'products.v2.size_guide_faq_fit_a' | t }}</p>
            <p><strong>{{ 'products.v2.size_guide_faq_onesize_q' | t }}</strong><br>{{ 'products.v2.size_guide_faq_onesize_a' | t }}</p>
            <p><strong>{{ 'products.v2.size_guide_faq_wrong_q' | t }}</strong><br>{{ 'products.v2.size_guide_faq_wrong_a' | t }}</p>
          </details>

        {% when 'gloves' %}
          <p class="size-guide-modal__intro">{{ 'products.v2.size_guide_gloves_intro' | t }}</p>
          <table class="size-guide-table">
            <thead>
              <tr>
                <th>{{ 'products.v2.size_guide_size' | t }}</th>
                <th>{{ 'products.v2.size_guide_index_finger' | t }} (cm)</th>
                <th>{{ 'products.v2.size_guide_index_finger' | t }} (inch)</th>
              </tr>
            </thead>
            <tbody>
              <tr><td><strong>S</strong></td><td>7.5</td><td>2.95</td></tr>
              <tr><td><strong>M</strong></td><td>8</td><td>3.15</td></tr>
              <tr><td><strong>L</strong></td><td>8.5</td><td>3.35</td></tr>
              <tr><td><strong>XL</strong></td><td>9</td><td>3.55</td></tr>
            </tbody>
          </table>
          <p class="size-guide-modal__note">{{ 'products.v2.size_guide_gloves_between' | t }}</p>

        {% when 'baselayer' %}
          <p class="size-guide-modal__intro">{{ 'products.v2.size_guide_baselayer_intro' | t }}</p>
          <div class="size-guide-table-scroll">
            <table class="size-guide-table">
              <thead>
                <tr>
                  <th>{{ 'products.v2.size_guide_measurement' | t }}</th>
                  <th>XS</th><th>S</th><th>M</th><th>L</th><th>XL</th><th>XXL</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><strong>Front length</strong></td><td>47</td><td>49</td><td>51</td><td>53</td><td>55</td><td>57</td></tr>
                <tr><td><strong>Back length</strong></td><td>57,5</td><td>59,5</td><td>61,5</td><td>63,5</td><td>65,5</td><td>67,5</td></tr>
                <tr><td><strong>Chest &ndash; &frac12; width</strong></td><td>33,5</td><td>36</td><td>38,5</td><td>41</td><td>43,5</td><td>46</td></tr>
                <tr><td><strong>Hem relaxed &ndash; &frac12; width</strong></td><td>30</td><td>32,5</td><td>35</td><td>37,5</td><td>40</td><td>42,5</td></tr>
                <tr><td><strong>Circumference collar</strong></td><td>25,2</td><td>26,1</td><td>27</td><td>27,9</td><td>28,8</td><td>29,7</td></tr>
                <tr><td><strong>Sleeve length</strong></td><td>13,5</td><td>14</td><td>14,5</td><td>15,1</td><td>15,7</td><td>16,3</td></tr>
                <tr><td><strong>Biceps width</strong></td><td>10,4</td><td>10,9</td><td>11,4</td><td>11,9</td><td>12,4</td><td>12,9</td></tr>
                <tr><td><strong>Bottom sleeve width</strong></td><td>54</td><td>55,5</td><td>57</td><td>58,6</td><td>60,2</td><td>61,8</td></tr>
              </tbody>
            </table>
          </div>

        {% when 'overshoes' %}
          {%- liquid
            assign size_values = blank
            for opt in product.options_with_values
              assign opt_name = opt.name | downcase
              if opt_name == 'size' or opt_name == 'maat' or opt_name == 'größe' or opt_name == 'taille'
                assign size_values = opt.values
              endif
            endfor
            if size_values == blank
              assign size_values = '39-42,43-45,46-48' | split: ','
            endif
          -%}
          <p class="size-guide-modal__intro">{{ 'products.v2.size_guide_overshoes_intro' | t }}</p>
          <div class="size-guide-table-scroll">
          <table class="size-guide-table">
            <thead>
              <tr>
                <th>{{ 'products.v2.size_guide_overshoe_size' | t }}</th>
                <th>EU</th>
                <th>US</th>
                <th>UK</th>
              </tr>
            </thead>
            <tbody>
              {%- for v in size_values -%}
                {%- liquid
                  assign parts = v | split: '-'
                  assign lo = parts | first | strip
                  assign hi = parts | last | strip
                  assign us_lo = ''
                  assign us_hi = ''
                  assign uk_lo = ''
                  assign uk_hi = ''
                  for m in shoe_map
                    assign mp = m | split: ':'
                    if mp[0] == lo
                      assign us_lo = mp[1]
                      assign uk_lo = mp[2]
                    endif
                    if mp[0] == hi
                      assign us_hi = mp[1]
                      assign uk_hi = mp[2]
                    endif
                  endfor
                  if lo == hi
                    assign eu_txt = lo
                    assign us_txt = us_lo
                    assign uk_txt = uk_lo
                  else
                    assign eu_txt = lo | append: ' - ' | append: hi
                    assign us_txt = us_lo | append: ' - ' | append: us_hi
                    assign uk_txt = uk_lo | append: ' - ' | append: uk_hi
                  endif
                  if us_lo == '' or us_hi == ''
                    assign us_txt = '–'
                    assign uk_txt = '–'
                  endif
                -%}
                <tr><td><strong>{{ v }}</strong></td><td>{{ eu_txt }}</td><td>{{ us_txt }}</td><td>{{ uk_txt }}</td></tr>
              {%- endfor -%}
            </tbody>
          </table>
          </div>
          <p class="size-guide-modal__note">{{ 'products.v2.size_guide_overshoes_between' | t }}</p>

        {% when 'toecovers' %}
          {%- liquid
            assign size_values = blank
            for opt in product.options_with_values
              assign opt_name = opt.name | downcase
              if opt_name == 'size' or opt_name == 'maat' or opt_name == 'größe' or opt_name == 'taille'
                assign size_values = opt.values
              endif
            endfor
          -%}
          <p class="size-guide-modal__intro">{{ 'products.v2.size_guide_toecovers_intro' | t }}</p>
          {%- if size_values != blank -%}
          <div class="size-guide-table-scroll">
          <table class="size-guide-table">
            <thead><tr><th>{{ 'products.v2.size_guide_size' | t }}</th><th>EU</th><th>US</th><th>UK</th></tr></thead>
            <tbody>
              {%- for v in size_values -%}
                {%- liquid
                  comment
                    The EU range lives in the variant note ("This toe cover will fit sizes from size 37 up to size 41 ...") so it stays editable per variant in the admin.
                  endcomment
                  assign lo = ''
                  assign hi = ''
                  for variant in product.variants
                    if lo == '' and variant.metafields.custom.note != blank
                      assign in_size = false
                      for so in variant.options
                        if so == v
                          assign in_size = true
                        endif
                      endfor
                      if in_size
                        assign note_txt = variant.metafields.custom.note | metafield_tag | strip_html
                        if note_txt contains 'from size '
                          assign after = note_txt | split: 'from size ' | last
                          assign lo = after | split: ' ' | first | remove: '.' | remove: ','
                          if after contains 'up to size '
                            assign hi = after | split: 'up to size ' | last | split: ' ' | first | remove: '.' | remove: ','
                          endif
                        endif
                      endif
                    endif
                  endfor
                  assign us_lo = ''
                  assign us_hi = ''
                  assign uk_lo = ''
                  assign uk_hi = ''
                  for m in shoe_map
                    assign mp = m | split: ':'
                    if mp[0] == lo
                      assign us_lo = mp[1]
                      assign uk_lo = mp[2]
                    endif
                    if mp[0] == hi
                      assign us_hi = mp[1]
                      assign uk_hi = mp[2]
                    endif
                  endfor
                  if lo != '' and hi != ''
                    assign eu_txt = lo | append: ' - ' | append: hi
                    assign us_txt = us_lo | append: ' - ' | append: us_hi
                    assign uk_txt = uk_lo | append: ' - ' | append: uk_hi
                  else
                    assign eu_txt = '–'
                    assign us_txt = '–'
                    assign uk_txt = '–'
                  endif
                -%}
                <tr><td><strong>{{ v }}</strong></td><td>{{ eu_txt }}</td><td>{{ us_txt }}</td><td>{{ uk_txt }}</td></tr>
              {%- endfor -%}
            </tbody>
          </table>
          </div>
          {%- endif -%}
          <p class="size-guide-modal__note">{{ 'products.v2.size_guide_toecovers_overlap' | t }}</p>

      {% endcase %}
    </div>
  </div>
</div>
