{%- comment -%}
  Product JSON-LD structured data (schema.org) — self-contained, safe to
  render on any product template. Mirrors the inline schema on the v1
  product template and adds AggregateRating from the reviews.io
  metafields (reviews.rating / reviews.rating_count) when present.
  Usage: {% render 'product-structured-data', product: product %}
{%- endcomment -%}
{%- liquid
  assign sd_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign sd_coming_soon = product.metafields.custom.coming_soon | default: false
  assign sd_rating = product.metafields.reviews.rating.value
  assign sd_rating_count = product.metafields.reviews.rating_count.value
-%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if sd_media -%}
      "image": [
        {{ sd_media | image_url: width: sd_media.preview_image.width | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    {% if sd_rating != blank and sd_rating_count != blank and sd_rating_count > 0 -%}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ sd_rating.rating | json }},
        "bestRating": {{ sd_rating.scale_max | json }},
        "ratingCount": {{ sd_rating_count | json }}
      },
    {%- endif %}
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
            "gtin12": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available and sd_coming_soon == false %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
