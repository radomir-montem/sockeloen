{% comment %}
  Renders up to 2 selectable free-socks VARIANTS once the second tier
  threshold is reached. Tiles are concrete variants (not products): the
  shopper sees exactly what gets added — variant image and print color —
  with a single click, no variant picker. If one product has multiple
  color variants, they can appear as separate tiles.
  Selection is optional — checking out without picking is always allowed.
  Once a pick is in the cart the widget collapses to a compact
  confirmation row; "Change" expands the picker again (handled in
  free-gift.js via [data-free-gift-expand]).
{% endcomment %}
{% liquid
  assign gift_collection = settings.free_gift_collection
  assign current_gift_variant_ids = ','
  assign chosen_gift_item = blank
  for item in cart.items
    if item.properties['_free_gift'] == 'true'
      assign current_gift_variant_ids = current_gift_variant_ids | append: item.variant_id | append: ','
      assign chosen_gift_item = item
    endif
  endfor
  assign is_collapsed = false
  if gift_reached and chosen_gift_item != blank
    assign is_collapsed = true
  endif
%}
{% if gift_collection.products.size > 0 %}
  <div class="free_gift_widget{% if is_collapsed %} free_gift_widget--collapsed{% endif %}" data-free-gift-widget data-gift-reached="{{ gift_reached }}">
    {% if chosen_gift_item != blank %}
      <div class="free_gift_widget__chosen">
        <div class="free_gift_widget__chosen-image">
          {% if chosen_gift_item.image %}
            <img src="{{ chosen_gift_item.image | image_url: width: 72 }}" alt="{{ chosen_gift_item.image.alt | escape }}" loading="lazy" width="36" height="36">
          {% endif %}
        </div>
        <span class="free_gift_widget__chosen-text">
          {{ 'sections.cart.free_gift_chosen' | t }} <strong>{{ chosen_gift_item.product.title }}</strong> <span class="free_gift_widget__chosen-check">&#10003;</span>
        </span>
        <button type="button" class="free_gift_widget__change-btn" data-free-gift-expand>
          {{ 'sections.cart.free_gift_change' | t }}
        </button>
      </div>
    {% endif %}
    <p class="free_gift_widget__title">
      {% if gift_reached %}
        {{ 'sections.cart.free_gift_widget_title' | t }}
      {% else %}
        {{ 'sections.cart.free_gift_add_amount_html' | t: amount: gift_remaining }}
      {% endif %}
    </p>
    <p class="free_gift_widget__removed_notice hidden" data-free-gift-removed-notice>{{ 'sections.cart.free_gift_removed_notice' | t }}</p>
    <div class="free_gift_widget__products">
      {% comment %}
        Slot selection: pinned variant IDs from settings.free_gift_pinned_variants
        (comma-separated, in display order) fill the 2 slots first; any remaining
        slots fall back to the first available variants in collection order.
        Unavailable pinned variants are skipped automatically.
      {% endcomment %}
      {% liquid
        assign shown_variants = 0
        assign slot_ids = ','
        assign pinned_raw = settings.free_gift_pinned_variants | default: ''
        assign pinned = pinned_raw | remove: ' ' | split: ','
        for pid in pinned
          if shown_variants >= 2
            break
          endif
          if pid == ''
            continue
          endif
          for product in gift_collection.products
            for variant in product.variants
              assign vid = variant.id | append: ''
              if vid == pid and variant.available
                assign marker = ',' | append: variant.id | append: ','
                unless slot_ids contains marker
                  assign slot_ids = slot_ids | append: variant.id | append: ','
                  assign shown_variants = shown_variants | plus: 1
                endunless
              endif
            endfor
          endfor
        endfor
        for product in gift_collection.products
          if shown_variants >= 2
            break
          endif
          for variant in product.variants
            if shown_variants >= 2
              break
            endif
            if variant.available
              assign marker = ',' | append: variant.id | append: ','
              unless slot_ids contains marker
                assign slot_ids = slot_ids | append: variant.id | append: ','
                assign shown_variants = shown_variants | plus: 1
              endunless
            endif
          endfor
        endfor
        assign ordered_slots = slot_ids | split: ','
      %}
      {% for sid in ordered_slots %}
        {% if sid == '' %}{% continue %}{% endif %}
        {% for product in gift_collection.products %}
        {% for variant in product.variants %}
          {% assign vid = variant.id | append: '' %}
          {% if vid == sid %}
            {% liquid
              assign variant_id_marker = ',' | append: variant.id | append: ','
              assign is_current_gift = false
              if current_gift_variant_ids contains variant_id_marker
                assign is_current_gift = true
              endif
              assign tile_image = variant.featured_image | default: product.featured_image
            %}
            <div class="free_gift_widget__product{% if is_current_gift %} is-selected{% endif %}" data-free-gift-product data-variant-id="{{ variant.id }}">
              <div class="free_gift_widget__image">
                {% if tile_image %}
                  <img src="{{ tile_image | image_url: width: 120 }}" alt="{{ tile_image.alt | escape }}" loading="lazy" width="60" height="60">
                {% endif %}
              </div>
              <div class="free_gift_widget__info">
                <span class="free_gift_widget__name">{{ product.title }}</span>
                {% unless product.has_only_default_variant %}
                  <span class="free_gift_widget__variant">{{ variant.title }}</span>
                {% endunless %}
                <span class="free_gift_widget__price">
                  <s>{{ variant.price | money_without_currency }}</s>
                  <span class="free_gift_widget__free_tag">{{ 'sections.cart.free_gift_free_tag' | t }}</span>
                </span>
              </div>
              <button
                type="button"
                class="free_gift_widget__add-btn{% if gift_reached == false %} free_gift_widget__add-btn--locked{% endif %}"
                data-free-gift-add
                data-variant-id="{{ variant.id }}"
                {% if gift_reached == false %}disabled{% endif %}
              >
                {% if is_current_gift %}
                  {{ 'sections.cart.free_gift_added' | t }}
                {% elsif gift_reached == false %}
                  {{ 'sections.cart.free_gift_add_locked_html' | t: amount: gift_remaining }}
                {% else %}
                  {{ 'sections.cart.free_gift_add' | t }}
                {% endif %}
              </button>
            </div>
          {% endif %}
        {% endfor %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
{% endif %}
