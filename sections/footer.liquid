<script src="{{ 'localization-selector.js' | asset_url }}" defer="defer"></script>
<style>
  /* Footer branding banner */
  .footer-branding-bar {
    overflow: hidden;
    padding: 20px 0 12px;
    margin-top: 32px;
  }
  .footer-branding-text {
    display: block !important;
    width: 100% !important;
    font-family: 'Roboto', sans-serif !important;
    font-weight: 700 !important;
    color: #fff !important;
    text-align: center !important;
    text-transform: uppercase !important;
    font-size: 15vw !important;
    line-height: 1 !important;
    letter-spacing: -0.02em !important;
    white-space: nowrap !important;
  }
  @media screen and (min-width: 750px) {
    .footer-branding-text {
      font-size: 10vw !important;
    }
  }
  /* Footer link groups (collapsible, see the markup below) */
  .footer-links { align-items: start; column-gap: 32px; }
  .footer-links__group { border-bottom: 1px solid rgba(255, 255, 255, 0.18); }
  .footer-links__toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin: 0;
    padding: 14px 28px 14px 0;
    border: 0;
    background: none;
    color: #fff;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .footer-links__toggle .bold-title { color: #fff; margin: 0; }
  .footer-links__toggle:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .footer-links__icon::before,
  .footer-links__icon::after {
    content: "";
    position: absolute;
    right: 2px;
    top: 50%;
    width: 12px;
    height: 2px;
    margin-top: -1px;
    background: #fff;
    transition: transform 0.2s ease;
  }
  .footer-links__icon::after { transform: rotate(90deg); }
  .footer-links__group.is-open .footer-links__icon::after { transform: rotate(180deg); }
  .footer-links__panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.2s ease-out;
  }
  .footer-links__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 2px 28px 16px 0;
  }
  .footer-links__list a { color: #fff; opacity: 0.85; }
  .footer-links__list a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .footer-links__panel, .footer-links__icon::before, .footer-links__icon::after { transition: none; }
  }
  /* Footer bottom spacing for sticky ATC */
  footer.bg-black {
    padding-bottom: 120px !important;
  }
  @media screen and (min-width: 990px) {
    footer.bg-black {
      padding-bottom: 120px !important;
    }
  }
</style>
<footer class="bg-black py-12 md:py-16 mt-[-1px]">
  <div class="flex flex-col-reverse lg:flex-row footer-top">
    {%- comment -%}
      Footer link groups: collapsed by default on every screen. Same open /
      close behaviour as the info links on the product page: a plus that
      turns into a minus and a 200ms height glide. White on the black footer.
    {%- endcomment -%}
    <div class="footer-links grid grid-cols-1 md:grid-cols-3 justify-center mx-8 lg:w-4/5">
      {% for link in section.settings.footer_list.links %}
        <div class="footer-links__group" x-data="{ open: false }" x-bind:class="open && 'is-open'">
          {% if link.links != blank %}
            <button
              type="button"
              class="footer-links__toggle"
              @click="open = !open"
              x-bind:aria-expanded="open ? 'true' : 'false'"
              aria-expanded="false"
              aria-controls="FooterLinks-{{ forloop.index }}"
            >
              <span class="text-base-footer bold-title">{{ link.title | upcase }}</span>
              <span class="footer-links__icon" aria-hidden="true"></span>
            </button>
            <div
              class="footer-links__panel"
              id="FooterLinks-{{ forloop.index }}"
              x-ref="panel"
              x-bind:style="open ? 'max-height: ' + $refs.panel.scrollHeight + 'px' : ''"
            >
              <div class="footer-links__list">
                {% for childlink in link.links %}
                  <a href="{{ childlink.url }}" class="cursor-pointer bold-title text-white lowercase font-normal" x-bind:tabindex="open ? 0 : -1" tabindex="-1">
                    {{- childlink.title -}}
                  </a>
                {% endfor %}
              </div>
            </div>
          {% else %}
            <a href="{{ link.url }}" class="footer-links__toggle footer-links__toggle--plain">
              <span class="text-base-footer bold-title">{{ link.title | upcase }}</span>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    {%- unless section.settings.show_newsletter -%}<style>#shopify-section-footer .footer-form > h3, #shopify-section-footer .footer-form > form { display: none !important; }</style>{%- endunless -%}
    <div class="mx-11 footer-form flex flex-col">
      <h3 class="text-base-footer bold-title mb-[16px]">
        {{section.settings.newsletter_text}}
      </h3>
      <form
        id="subscribe"
        class="klaviyo_gdpr_embed_{{section.settings.klaviyo_id}} contact-form"
        action="//manage.kmail-lists.com/subscriptions/subscribe"
        data-ajax-submit="//manage.kmail-lists.com/ajax/subscriptions/subscribe"
        method="GET"
        target="_blank"
      >
      <input type="hidden" name="g" value="{{section.settings.klaviyo_id}}">
      <input type="hidden" name="$fields" value="$consent">
      <input type="hidden" name="$list_fields" value="$consent">
      <div class="newsletter_form_input_group klaviyo_field_group w-full md:w-fit flex items-center justify-end relative">
        <input
          id="newsletter-email-input"
          class="newsletter_input_email bg-black text-[#7D7D7D] border border-[#ABABAB] py-[11px] w-full md:w-[266px] tracking-[0.04em] font-light pl-[16px] pr-[46px]"
          type="email"
          name="email"
          placeholder="Email"
          action="//manage.kmail-lists.com/subscriptions/subscribe"
          data-ajax-submit="//manage.kmail-lists.com/ajax/subscriptions/subscribe"
          method="GET"
          target="_blank"
        >
        <button class="newsletter_input_button absolute right-[20px]" type="submit">
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8.537 0.969734C8.5684 0.893502 8.61816 0.826218 8.68186 0.773871C8.74555 0.721525 8.8212 0.68574 8.90207 0.669705C8.98294 0.65367 9.06652 0.65788 9.14537 0.681962C9.22422 0.706045 9.29589 0.749251 9.354 0.807734L13.354 4.80773C13.4006 4.85418 13.4375 4.90935 13.4627 4.9701C13.4879 5.03085 13.5009 5.09597 13.5009 5.16173C13.5009 5.2275 13.4879 5.29262 13.4627 5.35337C13.4375 5.41411 13.4006 5.46929 13.354 5.51573L9.354 9.51573C9.26011 9.60962 9.13278 9.66236 9 9.66236C8.86722 9.66236 8.73989 9.60962 8.646 9.51573C8.55211 9.42185 8.49937 9.29451 8.49937 9.16173C8.49937 9.02896 8.55211 8.90162 8.646 8.80773L11.793 5.66173H1C0.867392 5.66173 0.740215 5.60906 0.646447 5.51529C0.552678 5.42152 0.5 5.29434 0.5 5.16173C0.5 5.02913 0.552678 4.90195 0.646447 4.80818C0.740215 4.71441 0.867392 4.66173 1 4.66173H11.793L8.646 1.51573C8.57575 1.44578 8.52788 1.35653 8.50847 1.25931C8.48906 1.16209 8.49899 1.0613 8.537 0.969734Z" fill="white"/>
          </svg>
        </button>
      </div>
      <div class="klaviyo_messages">
        <div class="success_message_wrapper">
          <div class="success_message" style="display: none;"></div>
        </div>
        <div class="error_message" style="display: none;"></div>
      </div>
    </form>
    <script src="//www.klaviyo.com/media/js/public/klaviyo_subscribe.js"></script>
    <script>
      KlaviyoSubscribe.attachToForms('#subscribe', {
        hide_form_on_success: true,
        success_message: "<p class='newsletter-form__success-message regular-text text-white'>Thank you for joining!</p>",
        success: function () {
          document.querySelector('.newsletter_form_input_group').style.display = 'none';
        }
      });
    </script>

    {% if section.settings.footer_logo != blank %}
      <style>
        .footer-logo {
          aspect-ratio: {{ section.settings.footer_logo.aspect_ratio }};
          width: {{ section.settings.logo_width }}px;
        }

        @media (max-width: 768px) {
          .footer-logo {
            width: {{ section.settings.logo_width_monile }}px;
          }
        }
      </style>
      <div class="footer-logo">
        {{ section.settings.footer_logo | image_url: width: section.settings.logo_width | image_tag }}
      </div>
    {% endif %}
    </div>
  </div>
  <!-- Branding banner -->
  <div class="footer-branding-bar" aria-hidden="true">
    <span class="footer-branding-text">SOCKELOEN™</span>
  </div>

  <div class="md:px-8 md:mt-16">
    <div class="grid grid-cols-1 md2:grid-cols-3 place-items-center pt-6 px-8 footer-bottom">
      <localization-selector class="footer-locale-selector relative flex items-center">
        <label class="localization-label flex items-center gap-2 text-[#9a9a9a] hover:text-white transition-colors cursor-pointer text-[12px] tracking-[0.06em] uppercase" tabindex="0">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span>{{ localization.language.iso_code | upcase }} / {{ localization.country.currency.iso_code | upcase }}</span>
          <svg width="8" height="5" viewBox="0 0 8 5" fill="none" xmlns="http://www.w3.org/2000/svg" class="transition-transform duration-200">
            <path d="M4 5L8 0.833333L7.2 8.58591e-08L4 3.33333L0.8 9.5399e-09L4.9687e-08 0.833333L4 5Z" fill="currentColor"/>
          </svg>
        </label>
        <ul class="localization-list hidden absolute bottom-full left-0 mb-2 w-[160px] bg-white border border-[#ddd] rounded-sm overflow-hidden z-50 shadow-lg">
          <li class="localization-item"><a href="#" data-country-code="NL" data-language="en" class="block px-4 py-[10px] text-[12px] tracking-[0.04em] text-[#333] hover:text-black hover:bg-[#f0f0f0] transition-colors{% if localization.language.iso_code == 'en' and localization.country.currency.iso_code == 'EUR' %} !text-black !font-bold{% endif %}">EN / EUR</a></li>
          <li class="localization-item"><a href="#" data-country-code="NL" data-language="nl" class="block px-4 py-[10px] text-[12px] tracking-[0.04em] text-[#333] hover:text-black hover:bg-[#f0f0f0] transition-colors{% if localization.language.iso_code == 'nl' %} !text-black !font-bold{% endif %}">NL / EUR</a></li>
          <li class="localization-item"><a href="#" data-country-code="DE" data-language="de" class="block px-4 py-[10px] text-[12px] tracking-[0.04em] text-[#333] hover:text-black hover:bg-[#f0f0f0] transition-colors{% if localization.language.iso_code == 'de' %} !text-black !font-bold{% endif %}">DE / EUR</a></li>
          <li class="localization-item"><a href="#" data-country-code="NL" data-language="fr" class="block px-4 py-[10px] text-[12px] tracking-[0.04em] text-[#333] hover:text-black hover:bg-[#f0f0f0] transition-colors{% if localization.language.iso_code == 'fr' and localization.country.currency.iso_code == 'EUR' %} !text-black !font-bold{% endif %}">FR / EUR</a></li>
          <li class="localization-item"><a href="#" data-country-code="US" data-language="en" class="block px-4 py-[10px] text-[12px] tracking-[0.04em] text-[#333] hover:text-black hover:bg-[#f0f0f0] transition-colors{% if localization.language.iso_code == 'en' and localization.country.currency.iso_code == 'USD' %} !text-black !font-bold{% endif %}">EN / USD</a></li>
          <li class="localization-item"><a href="#" data-country-code="US" data-language="fr" class="block px-4 py-[10px] text-[12px] tracking-[0.04em] text-[#333] hover:text-black hover:bg-[#f0f0f0] transition-colors{% if localization.language.iso_code == 'fr' and localization.country.currency.iso_code == 'USD' %} !text-black !font-bold{% endif %}">FR / USD</a></li>
        </ul>
        {%- form 'localization', id: 'FooterLocalizationForm', class: 'hidden' -%}
          <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
          <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
        {%- endform -%}
      </localization-selector>
      <div class="flex gap-x-[18px] md2:col-start-2">
        {% assign payMethods = 'shop_pay,visa,mastercard,apple_pay,google_pay,amex' | split: ',' %}
        {% for payMethod in payMethods %}
          {% assign handle = payMethod | handleize %}
          {% assign iconName = handle | append: '.svg' %}
          <img src="{{ iconName | asset_url }}" alt="{{ payMethod }}" loading="lazy">
        {% endfor %}
      </div>
      <div class="md2:place-self-end">
        <p class="font-roboto font-light text-[10px] leading-3 text-white mt-3 md: footer-copy-text">
          &copy; Copyright {{ 'now' | date: '%Y' }} {{ section.settings.copyright }}
        </p>
      </div>
    </div>
  </div>
</footer>
<style>
  footer input:-webkit-autofill,
  footer input:-webkit-autofill:hover, 
  footer input:-webkit-autofill:focus, 
  footer input:-webkit-autofill:active{
      -webkit-box-shadow: 0 0 0 30px black inset !important;
  }
  footer input:-webkit-autofill{
    -webkit-text-fill-color: #7D7D7D !important;
  }
</style>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "Sockeloen Netherlands - Sockeloen"
    },
    {
      "type": "link_list",
      "id": "footer_list",
      "label": "Footer menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter heading",
      "default": "Subscribe to our NEWSLETTER"
    },
    {
      "type": "text",
      "id": "klaviyo_id",
      "label": "Klaviyo list id",
      "default": "YcGWXh"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width",
      "default": 200,
      "min": 100,
      "max": 500,
      "step": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_width_monile",
      "label": "Logo Width (Mobile)",
      "default": 200,
      "min": 50,
      "max": 300,
      "step": 50,
      "unit": "px"
    }
  ]
}
{% endschema %}
