  {{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign banner_id = 'Banner-' | append: section.id
  assign heading_block = section.blocks | where: 'type', 'heading' | first
  assign text_block = section.blocks | where: 'type', 'text' | first
  assign buttons_block = section.blocks | where: 'type', 'buttons' | first
-%}

{%- style -%}

#Banner-{{ section.id }} .banner__heading {
  background-color: none;
  display: inline;
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
  line-height: 1.1;
  padding: 0 0.15em;
  text-transform: none;
}

/* Algemene button styling (glass / transparant = standaard) */
#Banner-{{ section.id }} .button {
  font-size: 12px;
  font-weight: 700;
  padding-left: 1rem;
  padding-right: 1rem;
  background: rgba(255, 255, 255, 0.2) !important;
  backdrop-filter: blur(21px) saturate(180%) !important;
  -webkit-backdrop-filter: blur(21px) saturate(180%) !important;
  border: 1px solid rgba(255, 255, 255, 0.25) !important;
  color: #fff !important;
  box-shadow: 0 2px 2px rgba(0, 0, 0, 0.1) !important;
}
#Banner-{{ section.id }} .button:hover {
  background: rgba(255, 255, 255, 0.35) !important;
  border-color: rgba(255, 255, 255, 0.4) !important;
}

/* ---------- Heading: typografie + uitlijning (theme editor) ---------- */
{%- if heading_block -%}
  {%- assign hs = heading_block.settings -%}
  #Banner-{{ section.id }} .banner__heading {
    {%- if hs.heading_font_weight != 'default' and hs.heading_font_weight != blank %} font-weight: {{ hs.heading_font_weight }};{% endif -%}
    {%- if hs.heading_italic %} font-style: italic;{% endif -%}
    {%- if hs.heading_color != blank %} color: {{ hs.heading_color }};{% endif -%}
    {%- if hs.heading_letter_spacing != 0 %} letter-spacing: {{ hs.heading_letter_spacing }}px;{% endif -%}
    {%- if hs.heading_text_transform != 'default' and hs.heading_text_transform != blank %} text-transform: {{ hs.heading_text_transform }};{% endif -%}
  }
  @media screen and (min-width: 750px) {
    #Banner-{{ section.id }} .banner__heading {
      {%- if hs.heading_font_size_desktop > 0 %} font-size: {{ hs.heading_font_size_desktop }}px;{% endif -%}
      {%- if hs.heading_line_height_desktop > 0 %} line-height: {{ hs.heading_line_height_desktop }};{% endif -%}
    }
  }
  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} .banner__heading {
      {%- if hs.heading_font_size_mobile > 0 %} font-size: {{ hs.heading_font_size_mobile }}px;{% endif -%}
      {%- if hs.heading_line_height_mobile > 0 %} line-height: {{ hs.heading_line_height_mobile }};{% endif -%}
    }
  }
  {%- render 'banner-element-align', banner_id: banner_id, selector: '.banner__heading', kind: 'heading', align_desktop: hs.heading_align_desktop, align_mobile: hs.heading_align_mobile -%}
{%- endif -%}

/* ---------- Subtitle / text: typografie + uitlijning ---------- */
{%- if text_block -%}
  {%- assign ts = text_block.settings -%}
  #Banner-{{ section.id }} .banner__text {
    {%- if ts.text_max_width > 0 %} max-width: {{ ts.text_max_width }}px;{% endif -%}
    {%- if ts.text_font_weight != 'default' and ts.text_font_weight != blank %} font-weight: {{ ts.text_font_weight }};{% endif -%}
    {%- if ts.text_italic %} font-style: italic;{% endif -%}
    {%- if ts.text_color != blank %} color: {{ ts.text_color }};{% endif -%}
    {%- if ts.text_letter_spacing != 0 %} letter-spacing: {{ ts.text_letter_spacing }}px;{% endif -%}
    {%- if ts.text_text_transform != 'default' and ts.text_text_transform != blank %} text-transform: {{ ts.text_text_transform }};{% endif -%}
  }
  @media screen and (min-width: 750px) {
    #Banner-{{ section.id }} .banner__text {
      {%- if ts.text_font_size_desktop > 0 %} font-size: {{ ts.text_font_size_desktop }}px;{% endif -%}
      {%- if ts.text_line_height_desktop > 0 %} line-height: {{ ts.text_line_height_desktop }};{% endif -%}
    }
  }
  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} .banner__text {
      {%- if ts.text_font_size_mobile > 0 %} font-size: {{ ts.text_font_size_mobile }}px;{% endif -%}
      {%- if ts.text_line_height_mobile > 0 %} line-height: {{ ts.text_line_height_mobile }};{% endif -%}
      {%- if ts.text_hide_mobile %} display: none !important;{% endif -%}
    }
  }
  {%- render 'banner-element-align', banner_id: banner_id, selector: '.banner__text', kind: 'text', align_desktop: ts.text_align_desktop, align_mobile: ts.text_align_mobile -%}
{%- endif -%}

/* ---------- Buttons: stijl (glass / solid), tekst + uitlijning ---------- */
{%- if buttons_block -%}
  {%- assign bs = buttons_block.settings -%}
  #Banner-{{ section.id }} .banner__buttons .button {
    {%- if bs.button_font_weight != 'default' and bs.button_font_weight != blank %} font-weight: {{ bs.button_font_weight }};{% endif -%}
    {%- if bs.button_letter_spacing != 0 %} letter-spacing: {{ bs.button_letter_spacing }}px;{% endif -%}
    {%- if bs.button_text_transform != 'default' and bs.button_text_transform != blank %} text-transform: {{ bs.button_text_transform }};{% endif -%}
  }
  @media screen and (min-width: 750px) {
    #Banner-{{ section.id }} .banner__buttons .button {
      {%- if bs.button_font_size_desktop > 0 %} font-size: {{ bs.button_font_size_desktop }}px;{% endif -%}
    }
  }
  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} .banner__buttons .button {
      {%- if bs.button_font_size_mobile > 0 %} font-size: {{ bs.button_font_size_mobile }}px;{% endif -%}
    }
  }
  {%- if bs.button_style == 'solid' -%}
    {%- assign solid_bg = bs.button_bg_color | default: '#ffffff' -%}
    {%- assign solid_text = bs.button_text_color | default: '#000000' -%}
    /* Solid variant: achtergrond en tekstkleur omgewisseld t.o.v. glass.
       !important + ID-scope zodat dit wint van de hero-glass overrides in
       header-overrides.css (body.template--index .banner .button). */
    #Banner-{{ section.id }} .banner__buttons--solid .button {
      background: {{ solid_bg }} !important;
      color: {{ solid_text }} !important;
      border: 1px solid {{ solid_bg }} !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
    #Banner-{{ section.id }} .banner__buttons--solid .button:hover {
      background: {{ solid_bg | color_darken: 8 }} !important;
      border-color: {{ solid_bg | color_darken: 8 }} !important;
      color: {{ solid_text }} !important;
    }
  {%- endif -%}
  {%- render 'banner-element-align', banner_id: banner_id, selector: '.banner__buttons', kind: 'buttons', align_desktop: bs.buttons_align_desktop, align_mobile: bs.buttons_align_mobile -%}
{%- endif -%}

/* ---------- Social proof ---------- */
{%- if section.settings.show_social_proof -%}
  #Banner-{{ section.id }} .banner-social-proof {
    margin-top: {{ section.settings.sp_spacing_top }}px !important;
  }
  #Banner-{{ section.id }} .banner-social-proof .product-v2__sp-avatar {
    width: {{ section.settings.sp_avatar_size }}px;
    height: {{ section.settings.sp_avatar_size }}px;
  }
  #Banner-{{ section.id }} .banner-social-proof .product-v2__sp-text {
    {%- if section.settings.sp_text_color != blank %} color: {{ section.settings.sp_text_color }} !important;{% endif -%}
    {%- if section.settings.sp_line_height > 0 %} line-height: {{ section.settings.sp_line_height }};{% endif -%}
    {%- if section.settings.sp_font_weight != 'default' and section.settings.sp_font_weight != blank %} font-weight: {{ section.settings.sp_font_weight }};{% endif -%}
  }
  #Banner-{{ section.id }} .banner-social-proof .product-v2__sp-name-link {
    {%- if section.settings.sp_text_color != blank %} color: {{ section.settings.sp_text_color }} !important;{% endif -%}
  }
  @media screen and (min-width: 750px) {
    #Banner-{{ section.id }} .banner-social-proof .product-v2__sp-text {
      {%- if section.settings.sp_font_size_desktop > 0 %} font-size: {{ section.settings.sp_font_size_desktop }}px;{% endif -%}
    }
  }
  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} .banner-social-proof .product-v2__sp-text {
      {%- if section.settings.sp_font_size_mobile > 0 %} font-size: {{ section.settings.sp_font_size_mobile }}px;{% endif -%}
    }
  }
  {%- render 'banner-element-align', banner_id: banner_id, selector: '.banner-social-proof', kind: 'social', align_desktop: section.settings.sp_align_desktop, align_mobile: section.settings.sp_align_mobile -%}
{%- endif -%}

/* Hoogte-instellingen */
{%- if section.settings.adapt_height_first_image and section.settings.image != blank -%}
  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }}::before,
    #Banner-{{ section.id }} .banner__media::before,
    #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
      padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
      content: '';
      display: block;
    }
  }

  @media screen and (min-width: 750px) {
    #Banner-{{ section.id }}::before,
    #Banner-{{ section.id }} .banner__media::before {
      padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
      content: '';
      display: block;
    }
  }
{%- endif -%}

{% if section.settings.adapt_height_first_image and section.settings.image_mobile != blank %}
  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }}:not(.banner--mobile-bottom),
    #Banner-{{ section.id }}.banner--mobile-bottom .banner__media {
      aspect-ratio: {{ section.settings.image_mobile.aspect_ratio }};
    }
  }
{% endif %}

{% unless section.settings.adapt_height_first_image and section.settings.image == blank %}
  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} {
      min-height: {{ section.settings.image_height_mobile }}px;
    }
  }

  @media screen and (min-width: 750px) {
    #Banner-{{ section.id }} {
      min-height: {{ section.settings.banner_image_height }}px;
    }
  }
{% endunless %}

{%- endstyle -%}

{%- style -%}
  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

<div id="Banner-{{ section.id }}" class="banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} {% if section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank %} banner--stacked{% endif %}{% if section.settings.adapt_height_first_image and section.settings.image != blank %} banner--adapt{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}">
  {%- if section.settings.image != blank and section.settings.image == blank -%}
    <div class="banner__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}">
      {%-liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
        if section.settings.image_2 != blank
          assign image_class = "banner__media-image-half"
        endif
        if section.settings.image_2 != blank and section.settings.stack_images_on_mobile
          assign sizes = "(min-width: 750px) 50vw, 100vw"
        elsif section.settings.image_2 != blank
          assign sizes = "50vw"
        else
          assign sizes = "100vw"
        endif
      -%}
      {{ section.settings.image | image_url: width: 1500 | image_tag:
        loading: 'lazy',
        width: section.settings.image.width,
        height: image_height,
        class: image_class,
        sizes: sizes,
        widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
        alt: section.settings.image.alt | escape
      }}
    </div>
  {%- elsif section.settings.image != blank and section.settings.image != blank -%}
  <div class="banner__media hidden md:!block media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}">
    {%-liquid
      assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
      if section.settings.image_2 != blank
        assign image_class = "banner__media-image-half"
      endif
      if section.settings.image_2 != blank and section.settings.stack_images_on_mobile
        assign sizes = "(min-width: 750px) 50vw, 100vw"
      elsif section.settings.image_2 != blank
        assign sizes = "50vw"
      else
        assign sizes = "100vw"
      endif
    -%}
    {{ section.settings.image | image_url: width: 1500 | image_tag:
      loading: 'lazy',
      width: section.settings.image.width,
      height: image_height,
      class: image_class,
      sizes: sizes,
      widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
      alt: section.settings.image.alt | escape
    }}
  </div>
  <div class="banner__media media md:hidden">
    {% render 'image-element', image: section.settings.image_mobile, class: 'w-full' %}
  </div>
  {%- elsif section.settings.image_2 == blank -%}
    <div class="banner__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}">
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}
  {%- if section.settings.image_2 != blank -%}
    <div class="banner__media media{% if section.settings.image != blank %} banner__media-half{% endif %}">
      {%-liquid
        assign image_height_2 = section.settings.image_2.width | divided_by: section.settings.image_2.aspect_ratio
        if section.settings.image != blank
          assign image_class_2 = "banner__media-image-half"
        endif
        if section.settings.image != blank and section.settings.stack_images_on_mobile
          assign sizes = "(min-width: 750px) 50vw, 100vw"
        elsif section.settings.image != blank
          assign sizes = "50vw"
        else
          assign sizes = "100vw"
        endif
      -%}
      {{ section.settings.image_2 | image_url: width: 1500 | image_tag:
        loading: 'lazy',
        width: section.settings.image_2.width,
        height: image_height_2,
        class: image_class_2,
        sizes: sizes,
        widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
        alt: section.settings.image_2.alt | escape
      }}
    </div>
  {%- endif -%}
  {%- if section.settings.show_mobile_cats -%}
    {%- comment -%} Ekster-style category bar, mobile only, sits just under the floating header {%- endcomment -%}
    <nav class="banner-cats" aria-label="Categories">
      {%- for i in (1..3) -%}
        {%- assign lbl_key = 'cat_' | append: i | append: '_label' -%}
        {%- assign url_key = 'cat_' | append: i | append: '_link' -%}
        {%- assign lbl = section.settings[lbl_key] -%}
        {%- assign url = section.settings[url_key] -%}
        {%- if lbl != blank -%}
          <a class="banner-cats__item" href="{{ url | default: '#' }}">{{ lbl | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}
  <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width">
    <div class="banner__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }} gradient">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {% if block.settings.use_h1_tag %}
              <h1 class="banner__heading {% if block.settings.heading_size == 'h0' %} text-[56px] font-bold {% else %}{{ block.settings.heading_size }}{% endif %}" {{ block.shopify_attributes }}>
                <span>{{ block.settings.heading | escape }}</span>
              </h1>
            {% else %}
              <h3 class="banner__heading {% if block.settings.heading_size == 'h0' %} text-[56px] font-bold {% else %}{{ block.settings.heading_size }}{% endif %}" {{ block.shopify_attributes }}>
                <span>{{ block.settings.heading | escape }}</span>
              </h3>
            {% endif %}
          {%- when 'text' -%}
            <h2 class="banner__text max-w-[438px] {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
              <span>{{ block.settings.text | escape }}</span>
            </h2>
          {%- when 'buttons' -%}
            <div class="banner__buttons w-full md:w-[unset]{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} banner__buttons--multiple{% endif %}{% if block.settings.button_style == 'solid' %} banner__buttons--solid{% else %} banner__buttons--glass{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label_1 != blank -%}
                <a{% if block.settings.button_link_1 == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.button_link_1 }}"{% endif %} class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %} w-full sm:w-fit">{{ block.settings.button_label_1 | escape }}</a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a{% if block.settings.button_link_2 == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.button_link_2 }}"{% endif %} class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %} w-full sm:w-fit">{{ block.settings.button_label_2 | escape }}</a>
              {%- endif -%}

            </div>
            {%- if section.settings.show_social_proof -%}
              {%- liquid
                # Avatars: theme-editor uploads, falling back to the original hardcoded files.
                if section.settings.sp_avatar_1 != blank
                  assign bsp_av1 = section.settings.sp_avatar_1 | image_url: width: 80
                else
                  assign bsp_av1 = 'Scherm_afbeelding_2026-03-21_om_23.30.36.png' | file_img_url: '80x80', crop: 'center'
                endif
                if section.settings.sp_avatar_2 != blank
                  assign bsp_av2 = section.settings.sp_avatar_2 | image_url: width: 80
                else
                  assign bsp_av2 = 'Scherm_afbeelding_2026-03-21_om_23.31.47.png' | file_img_url: '80x80', crop: 'center'
                endif
                if section.settings.sp_avatar_3 != blank
                  assign bsp_av3 = section.settings.sp_avatar_3 | image_url: width: 80
                else
                  assign bsp_av3 = 'Scherm_afbeelding_2026-03-21_om_23.31.03.png' | file_img_url: '80x80', crop: 'center'
                endif
                assign sp_count = section.settings.sp_count | default: '78.342'
                assign sp_brand = section.settings.sp_brand | default: 'Sockeloen'
              -%}
              <div class="banner-social-proof">
                <div class="product-v2__social-proof-inner">
                  <div class="product-v2__sp-avatars">
                    <div class="product-v2__sp-avatar product-v2__sp-avatar--1"><img src="{{ bsp_av1 }}" alt="" width="40" height="40" loading="lazy"></div>
                    <div class="product-v2__sp-avatar product-v2__sp-avatar--2"><img src="{{ bsp_av2 }}" alt="" width="40" height="40" loading="lazy"></div>
                    <div class="product-v2__sp-avatar product-v2__sp-avatar--3"><img src="{{ bsp_av3 }}" alt="" width="40" height="40" loading="lazy"></div>
                  </div>
                  <p class="product-v2__sp-text banner-social-proof__text">
                    {%- if section.settings.sp_name != blank -%}
                      {%- if section.settings.sp_link != blank -%}
                        <a href="{{ section.settings.sp_link }}" target="_blank" rel="noopener" class="product-v2__sp-name-link"><strong>{{ section.settings.sp_name | escape }}</strong></a>
                      {%- else -%}
                        <strong>{{ section.settings.sp_name | escape }}</strong>
                      {%- endif -%}
                      {%- if section.settings.sp_verified_badge -%}
                        <span class="product-v2__sp-verified" aria-label="Verified">
                          <svg width="16" height="16" viewBox="0 0 40 40" fill="rgb(0, 149, 246)" xmlns="http://www.w3.org/2000/svg">
                            <path d="M19.998 3.094 14.638 0l-2.972 5.15H5.432v6.354L0 14.64 3.094 20 0 25.359l5.432 3.137v5.905h5.975L14.638 40l5.36-3.094L25.358 40l3.232-5.6h6.162v-6.01L40 25.359 36.905 20 40 14.641l-5.248-3.03v-6.46h-6.419L25.358 0l-5.36 3.094Zm7.415 11.225 2.254 2.287-11.43 11.5-6.835-6.93 2.244-2.258 4.587 4.581 9.18-9.18Z" fill-rule="evenodd"/>
                          </svg>
                        </span>
                      {%- endif -%}
                      &nbsp;
                    {%- endif -%}
                    {%- if section.settings.sp_custom_text != blank -%}
                      {{ section.settings.sp_custom_text }}
                    {%- else -%}
                      {{ 'products.v2.social_proof_text_html' | t: count: sp_count, brand: sp_brand }}
                    {%- endif -%}
                  </p>
                </div>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if template.name == 'index' -%}
<script>
  /* Homepage hero: the content group (title, subtitle, buttons, social
     proof) keeps its start position, then scrolls up with the page and
     docks under the floating header while the hero image stays pinned,
     the same behaviour as the labels of the pinned category banners.
     The offset goes into --hero-scroll, which the CSS adds to the
     group's own translateY. Phones dock below the category bar. */
  (function () {
    var banner = document.getElementById('Banner-{{ section.id }}');
    var box = banner && banner.querySelector('.banner__box');
    if (!box || !document.body.classList.contains('template--index')) return;
    var phone = window.matchMedia('(max-width: 749px)');
    var startTop = null;
    var ticking = false;
    function dock() { return phone.matches ? 160 : 108; }
    function measure() {
      box.style.setProperty('--hero-scroll', '0px');
      /* the hero is pinned at the top, so the group's viewport top is
         its start position whatever the scroll position */
      startTop = box.getBoundingClientRect().top;
      update();
    }
    function update() {
      ticking = false;
      if (startTop === null) return;
      var travel = Math.max(0, startTop - dock());
      var offset = Math.min(window.scrollY, travel);
      box.style.setProperty('--hero-scroll', (-offset) + 'px');
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      /* frames are paused in hidden tabs and throttled in some
         embedded previews; fall back to a timer there */
      if (document.hidden || !window.requestAnimationFrame) setTimeout(update, 0);
      else window.requestAnimationFrame(update);
    }
    var timer;
    function remeasure() {
      clearTimeout(timer);
      timer = setTimeout(measure, 100);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', remeasure);
    window.addEventListener('pageshow', remeasure);
    /* the hero markup is above this script, so measure right away (the
       load event can be held up for seconds by third-party scripts),
       then again whenever fonts or images settle the layout */
    measure();
    document.addEventListener('DOMContentLoaded', remeasure);
    window.addEventListener('load', remeasure);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(remeasure);
    if (window.ResizeObserver) {
      var ro = new ResizeObserver(remeasure);
      ro.observe(banner);
      ro.observe(box);
    }
  })();
</script>
