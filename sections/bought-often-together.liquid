{%- comment -%}
  Product carousel logic:
  1. "Recently viewed" — fully client-side (if selected)
  2. First 3 slots: product source metafield / manual list / fallback upsells metafield
  3. Remaining slots (up to max): filled from Collection setting (no duplicates)
  Layout setting: carousel (Swiper) or grid (all products in rows, no slider).
  4. If nothing else: global upsells fallback
{%- endcomment -%}

{%- liquid
  assign source_products = nil
  assign is_recently_viewed = false
  assign swiper_id = 'bot-swiper-' | append: section.id
  assign max_items = section.settings.max_products
  assign metafield_limit = 3
  assign is_grid = false
  if section.settings.layout == 'grid'
    assign is_grid = true
  endif

  if section.settings.product_source == 'recently_viewed'
    assign is_recently_viewed = true
  else
    comment
      Step 1: Gather metafield products (first 3 slots)
    endcomment
    assign meta_products = nil
    if section.settings.product_source != 'none' and section.settings.product_source != 'recently_viewed'
      assign meta_key = section.settings.product_source
      if meta_key == 'my_fields.product_upsells'
        assign meta_products = product.metafields.my_fields.product_upsells.value
      elsif meta_key == 'my_fields.collection_upsell'
        assign meta_products = product.metafields.my_fields.collection_upsell.value.products
      elsif meta_key == 'custom.related_products'
        assign meta_products = product.metafields.custom.related_products.value
      elsif meta_key == 'custom.cross_sell'
        assign meta_products = product.metafields.custom.cross_sell.value
      elsif meta_key != blank
        assign meta_parts = meta_key | split: '.'
        if meta_parts.size == 2
          assign meta_ns = meta_parts[0]
          assign meta_k = meta_parts[1]
          assign meta_products = product.metafields[meta_ns][meta_k].value
        endif
      endif
    elsif section.settings.product_list != blank and section.settings.product_list.size > 0
      assign meta_products = section.settings.product_list
    endif

    comment
      No fallback to metafields when 'none' is selected — only collection fills the carousel
    endcomment

    comment
      Step 2: Build combined list — metafield products first (up to 3), then fill from collection (up to max)
    endcomment
    assign combined_handles = ''
    assign combined_count = 0

    comment
      "Complete the look" only: the product's sold-out alternatives (variant metafield list
      custom.soldout_alternatives, see snippets/product-soldout-alternatives.liquid) always come first.
    endcomment
    if section.settings.smart_mode == 'complete' or section.settings.smart_order and section.settings.smart_mode == 'none'
      for alt_v in product.metafields.custom.soldout_alternatives.value
        assign alt_p = alt_v.product
        if alt_p.handle == product.handle or alt_p.available == false
          continue
        endif
        if settings.gate_enabled
          capture gate_flag
            render 'gate-product-check', product: alt_p
          endcapture
          if gate_flag contains 'true'
            continue
          endif
        endif
        assign handle_check = combined_handles | split: ','
        if handle_check contains alt_p.handle
          continue
        endif
        if combined_handles == ''
          assign combined_handles = alt_p.handle
        else
          assign combined_handles = combined_handles | append: ',' | append: alt_p.handle
        endif
        assign combined_count = combined_count | plus: 1
      endfor
    endif

    if meta_products != blank
      for item in meta_products
        if combined_count >= metafield_limit
          break
        endif
        if item.handle != product.handle and item.available
          if combined_handles == ''
            assign combined_handles = item.handle
          else
            assign combined_handles = combined_handles | append: ',' | append: item.handle
          endif
          assign combined_count = combined_count | plus: 1
        endif
      endfor
    endif

    comment
      Step 3: Fill remaining slots from collection
    endcomment
    assign smart_mode = section.settings.smart_mode | default: 'none'
    if section.settings.smart_order and smart_mode == 'none'
      assign smart_mode = 'complete'
    endif
    if section.settings.collection != blank and combined_count < max_items and smart_mode == 'new' or smart_mode == 'sale'
      comment
        "New" / "Sale" lists, see snippets/smart-product-list.liquid. The source collection can hold
        more than 50 products, so it is read inside a paginate.
      endcomment
      paginate section.settings.collection.products by 1000
        capture smart_handles
          render 'smart-product-list', mode: smart_mode, source: section.settings.collection, limit: max_items, days: section.settings.smart_days, exclude: product.handle
        endcapture
      endpaginate
      assign smart_arr = smart_handles | strip | split: ','
      for h in smart_arr
        if combined_count >= max_items
          break
        endif
        if h == ''
          continue
        endif
        assign already_added = false
        assign handle_check = combined_handles | split: ','
        for hc in handle_check
          if hc == h
            assign already_added = true
            break
          endif
        endfor
        if already_added
          continue
        endif
        if combined_handles == ''
          assign combined_handles = h
        else
          assign combined_handles = combined_handles | append: ',' | append: h
        endif
        assign combined_count = combined_count | plus: 1
      endfor
    elsif section.settings.collection != blank and combined_count < max_items and smart_mode == 'complete'
      comment
        "Complete the look" order, no metafields needed: the collection is sorted by best selling
        (automatic collection). Products of OTHER families than the viewed product come first,
        mixed (see the score below), so a row shows e.g. socks + gloves + base layer instead of
        three socks. Products of the SAME family (alternatives) fill the remaining slots, also
        best selling first.
      endcomment
      capture cur_family
        render 'product-family', type: product.type, title: product.title
      endcapture
      assign cur_family = cur_family | strip
      comment
        Score per complementary product = (position within its family × 6) + (position in the
        best-selling collection). Low score first. So the best product of each family comes early
        (first row mixes families), but a family's second product still beats the first product of
        a family that hardly sells.
      endcomment
      assign fam_keys = ''
      assign fam_counts = ''
      assign scored = ''
      assign same_list = ''
      assign pos = 0
      for col_product in section.settings.collection.products
        if col_product.handle == product.handle or col_product.available == false
          continue
        endif
        assign already_added = false
        assign handle_check = combined_handles | split: ','
        for h in handle_check
          if h == col_product.handle
            assign already_added = true
            break
          endif
        endfor
        if already_added
          continue
        endif
        capture fam
          render 'product-family', type: col_product.type, title: col_product.title
        endcapture
        assign fam = fam | strip
        if fam == cur_family
          if same_list == ''
            assign same_list = col_product.handle
          else
            assign same_list = same_list | append: ';' | append: col_product.handle
          endif
        else
          assign key_arr = fam_keys | split: ','
          assign count_arr = fam_counts | split: ','
          assign fam_index = -1
          for k in key_arr
            if k == fam
              assign fam_index = forloop.index0
              break
            endif
          endfor
          assign fam_pos = 0
          if fam_index == -1
            if fam_keys == ''
              assign fam_keys = fam
              assign fam_counts = '1'
            else
              assign fam_keys = fam_keys | append: ',' | append: fam
              assign fam_counts = fam_counts | append: ',1'
            endif
          else
            assign fam_pos = count_arr[fam_index] | plus: 0
            assign fam_counts = ''
            for c in count_arr
              assign entry = c
              if forloop.index0 == fam_index
                assign entry = c | plus: 1
              endif
              if forloop.first
                assign fam_counts = entry | append: ''
              else
                assign fam_counts = fam_counts | append: ',' | append: entry
              endif
            endfor
          endif
          assign score = fam_pos | times: 6 | plus: pos | plus: 10000
          assign entry = score | append: '|' | append: col_product.handle
          if scored == ''
            assign scored = entry
          else
            assign scored = scored | append: ';' | append: entry
          endif
        endif
        assign pos = pos | plus: 1
      endfor
      assign scored_arr = scored | split: ';' | sort
      for entry in scored_arr
        if combined_count >= max_items
          break
        endif
        if entry == ''
          continue
        endif
        assign h = entry | split: '|' | last
        if combined_handles == ''
          assign combined_handles = h
        else
          assign combined_handles = combined_handles | append: ',' | append: h
        endif
        assign combined_count = combined_count | plus: 1
      endfor
      if same_list != ''
        assign same_arr = same_list | split: ';'
        for h in same_arr
          if combined_count >= max_items
            break
          endif
          if combined_handles == ''
            assign combined_handles = h
          else
            assign combined_handles = combined_handles | append: ',' | append: h
          endif
          assign combined_count = combined_count | plus: 1
        endfor
      endif
    elsif section.settings.collection != blank and combined_count < max_items
      for col_product in section.settings.collection.products
        if combined_count >= max_items
          break
        endif
        if col_product.handle == product.handle
          continue
        endif
        if col_product.available == false
          continue
        endif
        assign already_added = false
        assign handle_check = combined_handles | split: ','
        for h in handle_check
          if h == col_product.handle
            assign already_added = true
            break
          endif
        endfor
        unless already_added
          if combined_handles == ''
            assign combined_handles = col_product.handle
          else
            assign combined_handles = combined_handles | append: ',' | append: col_product.handle
          endif
          assign combined_count = combined_count | plus: 1
        endunless
      endfor
    endif

    comment
      Step 4: If still no products, fall back to global upsells
    endcomment
    if combined_count == 0 and settings.global_upsells != blank
      for fallback_product in settings.global_upsells.products
        if combined_count >= max_items
          break
        endif
        if fallback_product.handle != product.handle and fallback_product.available
          if combined_handles == ''
            assign combined_handles = fallback_product.handle
          else
            assign combined_handles = combined_handles | append: ',' | append: fallback_product.handle
          endif
          assign combined_count = combined_count | plus: 1
        endif
      endfor
    endif

    assign combined_handle_array = combined_handles | split: ','
  endif
-%}

{%- style -%}
  .bot-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .bot-section-{{ section.id }} .bot-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-align: {{ section.settings.heading_alignment }};
    color: {{ section.settings.heading_color }};
    margin: 0;
    padding: 0 16px 16px;
  }
  .bot-section-{{ section.id }} .bot-heading em {
    font-style: italic;
    color: {{ section.settings.heading_italic_color }};
  }
  @media screen and (max-width: 749px) {
    .bot-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    .bot-section-{{ section.id }} .bot-heading {
      font-size: {{ section.settings.heading_size | times: 0.8 | round: 0 }}px;
    }
  }
  /* Ensure single-row carousel */
  .{{ swiper_id }} .swiper-wrapper {
    flex-wrap: nowrap !important;
  }
  /* Grid layout: every product in rows ({{ section.settings.mobile_columns }} per row on phones,
     {{ section.settings.desktop_columns }} from 768px), 12px gaps, no slider. */
  .{{ swiper_id }}.bot-grid .swiper-wrapper {
    display: grid !important;
    grid-template-columns: repeat({{ section.settings.mobile_columns }}, minmax(0, 1fr));
    column-gap: 12px !important;
    row-gap: 0 !important;
    transform: none !important;
    height: auto;
  }
  .{{ swiper_id }}.bot-grid .swiper-slide {
    width: auto !important;
    margin: 0 !important;
    min-width: 0;
    height: auto;
  }
  /* the grid is no slider: vertical touch scrolling must keep working over it
     (Swiper's touch-action: pan-x blocked it and people got stuck on this block) */
  .{{ swiper_id }}.bot-grid,
  .{{ swiper_id }}.bot-grid .swiper-wrapper,
  .{{ swiper_id }}.bot-grid .swiper-slide {
    touch-action: auto !important;
    cursor: auto;
  }
  .{{ swiper_id }}.bot-grid .bot-swiper-next,
  .{{ swiper_id }}.bot-grid .bot-swiper-prev {
    display: none !important;
  }
  @media screen and (min-width: 768px) {
    .{{ swiper_id }}.bot-grid .swiper-wrapper {
      grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
    }
  }
  /* Until the slider script has started (or if it never does): the same
     column widths and 12px gaps, and the row scrolls sideways so every
     product can be reached. Swiper takes over once it is initialised. */
  .{{ swiper_id }}:not(.swiper-initialized):not(.bot-grid) .swiper-wrapper {
    display: flex !important;
    gap: 12px !important;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .{{ swiper_id }}:not(.swiper-initialized):not(.bot-grid) .swiper-wrapper::-webkit-scrollbar { display: none; }
  .{{ swiper_id }}:not(.swiper-initialized):not(.bot-grid) .swiper-slide {
    flex: 0 0 calc((100% - {{ section.settings.mobile_columns | minus: 1 | times: 12 }}px) / {{ section.settings.mobile_columns }}) !important;
    width: auto;
    min-width: 0;
    margin-right: 0 !important;
  }
  @media screen and (min-width: 768px) {
    .{{ swiper_id }}:not(.swiper-initialized):not(.bot-grid) .swiper-slide {
      flex-basis: calc((100% - {{ section.settings.desktop_columns | minus: 1 | times: 12 }}px) / {{ section.settings.desktop_columns }}) !important;
    }
  }
  /* Hover: crossfade to second image. Real pointers only: on touch the crossfade showed up when a
     tile was touched, and iOS Safari spent the first tap on this "hover" (product opened on tap two). */
  @media (hover: hover) {
    .bot-section-{{ section.id }} .media.media--hover-effect > img {
      transition: opacity 0.35s ease;
    }
    .bot-section-{{ section.id }} .card-wrapper:hover .media.media--hover-effect:not(.no-has-second-image) > img:first-child:not(:only-child) {
      opacity: 0;
    }
    .bot-section-{{ section.id }} .card-wrapper:hover .media.media--hover-effect > img + img {
      opacity: 1;
    }
    .bot-section-{{ section.id }} .card-wrapper:hover .media.media--hover-effect:not(.no-has-second-image) > img:first-child {
      display: block !important;
    }
  }
{%- endstyle -%}

{%- if is_recently_viewed or combined_handle_array != blank and combined_handle_array.size > 0 -%}
<div class="bot-section-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h4 class="bot-heading">
      {{- section.settings.heading -}}
      {%- if section.settings.heading_italic != blank -%}
        {{ ' ' }}<em>{{ section.settings.heading_italic }}</em>
      {%- endif -%}
    </h4>
  {%- endif -%}

  <div class="{{ swiper_id }} bot-swiper overflow-hidden relative{% if is_grid %} bot-grid{% endif %}">
    <div class="swiper-wrapper">
      {%- unless is_recently_viewed -%}
        {%- comment -%}
          Product objects come from the source collection (read inside a paginate, so a big
          collection is fully visible); all_products is only the fallback for products that are
          not in it. Shopify allows just 20 all_products lookups per page, and two 12-product grids
          went over that: the extra tiles then repeated the last product.
        {%- endcomment -%}
        {%- comment -%} paginate only with a source collection set: on a blank one it throws "not paginateable" {%- endcomment -%}
        {%- if section.settings.collection != blank -%}
          {%- paginate section.settings.collection.products by 1000 -%}
          {%- for handle in combined_handle_array -%}
            {%- assign carouselProduct = section.settings.collection.products | where: 'handle', handle | first -%}
            {%- if carouselProduct == blank -%}
              {%- assign carouselProduct = all_products[handle] -%}
            {%- endif -%}
            {%- if carouselProduct != blank -%}
              <div class="swiper-slide">
                {% render 'card-product',
                  card_product: carouselProduct,
                  media_aspect_ratio: section.settings.image_ratio,
                  section_id: section.id,
                  show_secondary_image: true
                %}
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- endpaginate -%}
        {%- else -%}
          {%- for handle in combined_handle_array -%}
            {%- assign carouselProduct = all_products[handle] -%}
            {%- if carouselProduct != blank -%}
              <div class="swiper-slide">
                {% render 'card-product',
                  card_product: carouselProduct,
                  media_aspect_ratio: section.settings.image_ratio,
                  section_id: section.id,
                  show_secondary_image: true
                %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endunless -%}
    </div>
    <div class="{{ swiper_id }}-next bot-swiper-next">
      {% render 'icon-arrow-right' %}
    </div>
    <div class="{{ swiper_id }}-prev bot-swiper-prev">
      {% render 'icon-arraw-left' %}
    </div>
  </div>
</div>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var swiperId = '{{ swiper_id }}';
    var isRecentlyViewed = {{ is_recently_viewed }};
    var maxProducts = {{ section.settings.max_products }};
    var mobileColumns = {{ section.settings.mobile_columns }};
    var desktopColumns = {{ section.settings.desktop_columns }};
    var imageRatio = '{{ section.settings.image_ratio }}';

    var isGrid = {{ is_grid }};

    /* grid layout: the theme bundle (bundle.js) still runs `new Swiper` on the first .bot-swiper
       it finds; that instance set touch-action: pan-x and swallowed drags, so the page could not
       be scrolled over this block. Destroy any instance that lands on the grid. */
    function killSwiper() {
      var el = document.querySelector('.' + swiperId);
      if (!el) return;
      if (el.swiper && typeof el.swiper.destroy === 'function') {
        el.swiper.destroy(true, true);
      }
      el.classList.remove('swiper-initialized', 'swiper-horizontal', 'swiper-pointer-events', 'swiper-backface-hidden');
      el.style.touchAction = 'auto';
    }
    if (isGrid) {
      killSwiper();
      /* iOS Safari needed two taps on a tile here: the first tap was spent as a "hover". A clean tap
         (no movement, under half a second) on a card therefore navigates straight away, so the
         synthetic mouse events never get a say. Swatches keep their own click handling. */
      var tapEl = document.querySelector('.' + swiperId);
      if (tapEl && 'ontouchstart' in window) {
        var tap = null;
        tapEl.addEventListener('touchstart', function (e) {
          var t = e.touches[0];
          tap = t ? { x: t.clientX, y: t.clientY, time: Date.now() } : null;
        }, { passive: true });
        tapEl.addEventListener('touchmove', function (e) {
          if (!tap) return;
          var t = e.touches[0];
          if (t && (Math.abs(t.clientX - tap.x) > 10 || Math.abs(t.clientY - tap.y) > 10)) tap = null;
        }, { passive: true });
        tapEl.addEventListener('touchend', function (e) {
          if (!tap || Date.now() - tap.time > 500) { tap = null; return; }
          tap = null;
          if (e.target.closest('.ccr, button, input, select, form')) return;
          var card = e.target.closest('a.card-wrapper[href], .card-wrapper a[href]');
          if (!card) return;
          if (e.cancelable) e.preventDefault();
          window.location.href = card.href;
        }, { passive: false });
        tapEl.addEventListener('touchcancel', function () { tap = null; }, { passive: true });
      }
      document.addEventListener('DOMContentLoaded', killSwiper);
      window.addEventListener('load', killSwiper);
      var gridEl = document.querySelector('.' + swiperId);
      if (gridEl && window.MutationObserver) {
        new MutationObserver(function () {
          if (gridEl.classList.contains('swiper-initialized')) killSwiper();
        }).observe(gridEl, { attributes: true, attributeFilter: ['class'] });
      }
    }

    function initSwiper() {
      if (isGrid) return; /* grid layout: plain rows, no slider */
      if (typeof window.Swiper === 'undefined') {
        setTimeout(initSwiper, 100);
        return;
      }
      var el = document.querySelector('.' + swiperId);
      if (!el) return;
      new window.Swiper(el, {
        direction: 'horizontal',
        slidesPerView: mobileColumns,
        spaceBetween: 12,
        navigation: {
          nextEl: '.' + swiperId + '-next',
          prevEl: '.' + swiperId + '-prev'
        },
        preventClicks: false,
        breakpoints: {
          768: { slidesPerView: desktopColumns }
        }
      });
    }

    function loadRecentlyViewed() {
      var stored = localStorage.getItem('recentlyViewedProduct');
      if (!stored) {
        /* Hide section if no recently viewed products */
        var section = document.querySelector('.bot-section-' + sectionId);
        if (section) section.style.display = 'none';
        return;
      }

      var products;
      try { products = JSON.parse(stored); } catch(e) { return; }
      if (!products || !products.length) {
        var section = document.querySelector('.bot-section-' + sectionId);
        if (section) section.style.display = 'none';
        return;
      }

      /* Filter out current product */
      var currentHandle = '{{ product.handle }}';
      products = products.filter(function(p) { return p.productHandle !== currentHandle; });
      if (!products.length) {
        var section = document.querySelector('.bot-section-' + sectionId);
        if (section) section.style.display = 'none';
        return;
      }

      /* Limit to max_products */
      products = products.slice(0, maxProducts);

      var wrapper = document.querySelector('.' + swiperId + ' .swiper-wrapper');
      if (!wrapper) return;

      var fetches = products.map(function(item) {
        return fetch('/products/' + item.productHandle + '?section_id=card-product')
          .then(function(r) { return r.text(); })
          .then(function(html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var card = doc.querySelector('.shopify-section');
            return card ? card.innerHTML : null;
          })
          .catch(function() { return null; });
      });

      Promise.all(fetches).then(function(cards) {
        var html = '';
        cards.forEach(function(card) {
          if (card) html += '<div class="swiper-slide">' + card + '</div>';
        });
        if (html) {
          wrapper.innerHTML = html;
          initSwiper();
        } else {
          var section = document.querySelector('.bot-section-' + sectionId);
          if (section) section.style.display = 'none';
        }
      });
    }

    if (isRecentlyViewed) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadRecentlyViewed);
      } else {
        loadRecentlyViewed();
      }
    } else {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSwiper);
      } else {
        initSwiper();
      }
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Product Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Product source"
    },
    {
      "type": "select",
      "id": "product_source",
      "label": "Product source (metafield / recently viewed)",
      "info": "Select a metafield or 'Recently viewed'. First 3 slots come from this source, remaining slots are filled from the Collection below.",
      "options": [
        { "value": "none", "label": "— None (use manual list, collection, or fallback)" },
        { "value": "recently_viewed", "label": "Recently viewed products" },
        { "value": "my_fields.product_upsells", "label": "Upsells (my_fields.product_upsells)" },
        { "value": "my_fields.collection_upsell", "label": "Collection upsell (my_fields.collection_upsell)" },
        { "value": "custom.related_products", "label": "Related products (custom.related_products)" },
        { "value": "custom.cross_sell", "label": "Cross-sell (custom.cross_sell)" }
      ],
      "default": "none"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Manual product list",
      "info": "Highest priority (except Recently viewed). Pick specific products."
    },
    {
      "type": "collection",
      "id": "collection",
