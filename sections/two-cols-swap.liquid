{%- if section.settings.eme_banners -%}
{%- comment -%}
  emestudios.com category banners: tall cover image, glass label pill,
  whole banner is the link. Each block can carry a product grid
  (setting "mobile_collection"): 2 columns under its banner on phones,
  and from tablet up shown after the banner row (4 columns) unless
  "grids_on_desktop" is off.

  Two scroll effects:
  - sticky_label (default): the banners scroll through, the pill sticks
    at 75svh while its banner passes.
  - pinned. Desktop: both banners side by side in one pinned stage; the
    section starts one banner height early, underneath the section before
    it, so that section slides up and uncovers the banners, then the grids
    slide over them. Phone: the reverse of sticky_label. Each banner
    enters like any content and pins full-screen; its glass label travels
    up from the bottom of the screen and docks under the header; then the
    next banner, and finally the grid, slides over it. Layout lives in
    header-overrides.css (.tcs-eme--pinned).
{%- endcomment -%}
{%- liquid
  assign pinned = false
  if section.settings.scroll_effect == 'pinned'
    assign pinned = true
  endif
-%}
<section class="tcs-eme{% if pinned %} tcs-eme--pinned{% endif %}{% if section.settings.grids_on_desktop == false %} tcs-eme--grids-mobile-only{% endif %}">
  {%- if pinned -%}
    <div class="tcs-eme__box">
      <div class="tcs-eme__stage">
        {%- for block in section.blocks -%}
          {% render 'tcs-eme-banner', block: block %}
        {%- endfor -%}
      </div>
    </div>
    <div class="tcs-eme__after">
      {%- for block in section.blocks -%}
        {% render 'tcs-eme-grid', block: block, section: section %}
      {%- endfor -%}
    </div>
  {%- else -%}
    {%- for block in section.blocks -%}
      {% render 'tcs-eme-banner', block: block %}
      {% render 'tcs-eme-grid', block: block, section: section %}
    {%- endfor -%}
  {%- endif -%}
</section>
{%- else -%}
<section class="bg-[#E1E1E1]">
  <div id="shopify-section-{{ section.id }}" class="{% if template contains 'product' %} flex flex-col-reverse md:grid md:grid-cols-2 {% else %} grid grid-cols-1 md:grid-cols-2 {% endif %}">
    {% for block in section.blocks %}
      <a class="two-cols-{{ block.id }} relative min-h-[325px] block" {% if block.settings.button_url != blank %} href="{{ block.settings.button_url }}" {% else %} role="link" aria-disabled="true" {% endif %}>
        <style>
          #shopify-section-{{ section.id }} .two-cols-{{ block.id }} .text-color {
            color: {{ block.settings.text_color }}
          }
        </style>
        {% if block.settings.image != blank %}
          <div class="overflow-hidden">
            {% render 'c-image-element',
              image: block.settings.image,
              lazy: true,
              position: 'left bottom',
              class: 'object-cover w-full'
            %}
          </div>
        {% else %}
          <style>
            #shopify-section-{{ section.id }} .two-cols-{{ block.id }} .background-color {
              background-color: {{ block.settings.color }};
            }
          </style>
        {% endif %}
        <div class="absolute w-full h-full top-0 left-0 background-color">
          <div class="h-full flex flex-col p-8 {{ block.settings.horizontal_pos }} {{ block.settings.vertical_pos }}">
            {% if block.settings.heading %}
              <h2
                style="font-size: {{block.settings.font_size}}px;"
                class="
                  h1 text-color mb-4
                  {% if block.settings.horizontal_pos == 'items-center' %} text-center{% endif %}
                  {% if block.settings.button_pos == 'mt-auto' and block.settings.vertical_pos == 'justify-center' %}
                    mt-auto
                  {% endif %}
                "
              >
                {{ block.settings.heading | upcase }}
              </h2>
            {% endif %}
            {% if block.settings.description %}
              <div class="text-color regular-text flex flex-col {{ block.settings.horizontal_pos }} {% if block.settings.horizontal_pos == 'items-center' %} text-center{% endif %}">
                {{ block.settings.description }}
              </div>
            {% endif %}
            {% if block.settings.button_url != blank and block.settings.button_text != blank %}
  <div
    class="pt-4 flex flex-col {{ block.settings.horizontal_pos }}
      {% if block.settings.vertical_pos != 'justify-end' %}
        {{ block.settings.button_pos }}
      {% endif %}
    "
  >
    {% if block.settings.button_disclaimer != blank %}
      <p class="bold-title text-color">{{ block.settings.button_disclaimer }}</p>
    {% endif %}
<span class="regular-button text-color border pointer-events-none"
  style="font-size: 12px; font-weight: 700;">
  {{- block.settings.button_text | capitalize -}}
</span>
  </div>
{% endif %}
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Two columns swapable",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image selector"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Background color",
          "info": "In case you dont select an image, this is going to be the background"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Header Font Size",
          "default": 48,
          "min": 24,
          "max": 60,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Header"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "select",
          "id": "vertical_pos",
          "label": "Select text vertical position",
          "options": [
            {
              "label": "Up",
              "value": "justify-start"
            },
            {
              "label": "Center",
              "value": "justify-center"
            },
            {
              "label": "Down",
              "value": "justify-end"
            }
          ],
          "default": "justify-center"
        },
        {
          "type": "select",
          "id": "horizontal_pos",
          "label": "Select text horizontal position",
          "options": [
            {
              "label": "Left",
              "value": "items-start"
            },
            {
              "label": "Center",
              "value": "items-center"
            },
            {
              "label": "Right",
              "value": "items-end"
            }
          ],
          "default": "items-center"
        },
        {
          "type": "text",
          "id": "button_disclaimer",
          "label": "Disclaimer text"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_pos",
          "label": "Select button position",
          "options": [
            {
              "label": "With the content",
              "value": "mt-0"
            },
            {
              "label": "At the end",
              "value": "mt-auto"
            }
          ],
          "default": "mt-0"
        },
        {
          "type": "header",
          "content": "Mobile product grid (Eme banners only)"
        },
        {
          "type": "collection",
          "id": "mobile_collection",
          "label": "Collection shown under this banner on mobile"
        },
        {
          "type": "text",
          "id": "mobile_collection_title",
          "label": "Title"
        },
        {
          "type": "range",
          "id": "mobile_collection_limit",
          "min": 2,
          "max": 8,
          "step": 2,
          "default": 4,
          "label": "Products"
        },
        {
          "type": "text",
          "id": "mobile_variant_filter",
          "label": "Show variant containing",
          "info": "e.g. KNWU — products show their first variant whose title contains this text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cols with text"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "eme_banners",
      "label": "Eme-style category banners (tall image, sticky glass label)",
      "default": false
    },
    {
      "type": "select",
      "id": "scroll_effect",
      "label": "Scroll effect (Eme banners)",
      "options": [
        { "value": "sticky_label", "label": "Banners scroll, label pill sticks" },
        { "value": "pinned", "label": "Banners pinned, uncovered, grids slide over" }
      ],
      "default": "sticky_label"
    },
    {
      "type": "checkbox",
      "id": "grids_on_desktop",
      "label": "Show the collection grids on desktop too",
      "default": true
    }
  ]
}
{% endschema %}
