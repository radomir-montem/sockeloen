{%- if section.settings.eme_banners -%}
{%- comment -%}
  emestudios.com category banners: tall cover image, glass label pill that
  sticks at 75svh while the banner scrolls through, whole banner is the link.
  Optional per-block mobile-only product grid rendered right after the banner.
{%- endcomment -%}
<section class="tcs-eme">
  {%- for block in section.blocks -%}
    <a class="tcs-eme__item" {% if block.settings.button_url != blank %}href="{{ block.settings.button_url }}"{% else %}role="link" aria-disabled="true"{% endif %} {{ block.shopify_attributes }}>
      <div class="tcs-eme__media">
        {%- if block.settings.image != blank -%}
          {% render 'c-image-element', image: block.settings.image, lazy: true, position: 'center', class: 'tcs-eme__img' %}
        {%- else -%}
          <div class="tcs-eme__img" style="background: {{ block.settings.color | default: '#111' }};"></div>
        {%- endif -%}
      </div>
      {%- if block.settings.heading != blank -%}
        <div class="tcs-eme__overlay">
          <div class="tcs-eme__sticky">
            <span class="tcs-eme__pill"><span class="tcs-eme__label">{{ block.settings.heading }}</span></span>
          </div>
        </div>
      {%- endif -%}
    </a>
    {%- if block.settings.mobile_collection != blank -%}
      <div class="tcs-eme__mobile-collection collection">
        {%- if block.settings.mobile_collection_title != blank -%}
          <div class="fc-title"><h2 class="fc-title__heading">{{ block.settings.mobile_collection_title | escape }}</h2></div>
        {%- endif -%}
        <div class="grid grid-cols-2 tcs-eme__grid">
          {%- for product in block.settings.mobile_collection.products limit: block.settings.mobile_collection_limit -%}
            {%- liquid
              assign match_variant = nil
              if block.settings.mobile_variant_filter != blank
                assign needle = block.settings.mobile_variant_filter | downcase | strip
                for v in product.variants
                  assign vt = v.title | downcase
                  if vt contains needle
                    assign match_variant = v
                    break
                  endif
                endfor
              endif
            -%}
            <div>
              {%- if match_variant -%}
                {% render 'card-product-variant', card_product: match_variant, product: product, title: product.title, media_aspect_ratio: 'portrait', show_secondary_image: true, show_vendor: false, show_rating: false, show_quick_add: false, section_id: section.id %}
              {%- else -%}
                {% render 'card-product', card_product: product, media_aspect_ratio: 'portrait', show_secondary_image: true, show_vendor: false, show_rating: false, show_quick_add: false, section_id: section.id %}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</section>
{%- else -%}
<section class="bg-[#E1E1E1]">
  <div id="shopify-section-{{ section.id }}" class="{% if template contains 'product' %} flex flex-col-reverse md:grid md:grid-cols-2 {% else %} grid grid-cols-1 md:grid-cols-2 {% endif %}">
    {% for block in section.blocks %}
      <a class="two-cols-{{ block.id }} relative min-h-[325px] block" {% if block.settings.button_url != blank %} href="{{ block.settings.button_url }}" {% else %} role="link" aria-disabled="true" {% endif %}>
        <style>
          #shopify-section-{{ section.id }} .two-cols-{{ block.id }} .text-color {
            color: {{ block.settings.text_color }}
          }
        </style>
        {% if block.settings.image != blank %}
          <div class="overflow-hidden">
            {% render 'c-image-element',
              image: block.settings.image,
              lazy: true,
              position: 'left bottom',
              class: 'object-cover w-full'
            %}
          </div>
        {% else %}
          <style>
            #shopify-section-{{ section.id }} .two-cols-{{ block.id }} .background-color {
              background-color: {{ block.settings.color }};
            }
          </style>
        {% endif %}
        <div class="absolute w-full h-full top-0 left-0 background-color">
          <div class="h-full flex flex-col p-8 {{ block.settings.horizontal_pos }} {{ block.settings.vertical_pos }}">
            {% if block.settings.heading %}
              <h2
                style="font-size: {{block.settings.font_size}}px;"
                class="
                  h1 text-color mb-4
                  {% if block.settings.horizontal_pos == 'items-center' %} text-center{% endif %}
                  {% if block.settings.button_pos == 'mt-auto' and block.settings.vertical_pos == 'justify-center' %}
                    mt-auto
                  {% endif %}
                "
              >
                {{ block.settings.heading | upcase }}
              </h2>
            {% endif %}
            {% if block.settings.description %}
              <div class="text-color regular-text flex flex-col {{ block.settings.horizontal_pos }} {% if block.settings.horizontal_pos == 'items-center' %} text-center{% endif %}">
                {{ block.settings.description }}
              </div>
            {% endif %}
            {% if block.settings.button_url != blank and block.settings.button_text != blank %}
  <div
    class="pt-4 flex flex-col {{ block.settings.horizontal_pos }}
      {% if block.settings.vertical_pos != 'justify-end' %}
        {{ block.settings.button_pos }}
      {% endif %}
    "
  >
    {% if block.settings.button_disclaimer != blank %}
      <p class="bold-title text-color">{{ block.settings.button_disclaimer }}</p>
    {% endif %}
<span class="regular-button text-color border pointer-events-none"
  style="font-size: 12px; font-weight: 700;">
  {{- block.settings.button_text | capitalize -}}
</span>
  </div>
{% endif %}
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Two columns swapable",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image selector"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Background color",
          "info": "In case you dont select an image, this is going to be the background"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Header Font Size",
          "default": 48,
          "min": 24,
          "max": 60,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Header"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "select",
          "id": "vertical_pos",
          "label": "Select text vertical position",
          "options": [
            {
              "label": "Up",
              "value": "justify-start"
            },
            {
              "label": "Center",
              "value": "justify-center"
            },
            {
              "label": "Down",
              "value": "justify-end"
            }
          ],
          "default": "justify-center"
        },
        {
          "type": "select",
          "id": "horizontal_pos",
          "label": "Select text horizontal position",
          "options": [
            {
              "label": "Left",
              "value": "items-start"
            },
            {
              "label": "Center",
              "value": "items-center"
            },
            {
              "label": "Right",
              "value": "items-end"
            }
          ],
          "default": "items-center"
        },
        {
          "type": "text",
          "id": "button_disclaimer",
          "label": "Disclaimer text"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_pos",
          "label": "Select button position",
          "options": [
            {
              "label": "With the content",
              "value": "mt-0"
            },
            {
              "label": "At the end",
              "value": "mt-auto"
            }
          ],
          "default": "mt-0"
        },
        {
          "type": "header",
          "content": "Mobile product grid (Eme banners only)"
        },
        {
          "type": "collection",
          "id": "mobile_collection",
          "label": "Collection shown under this banner on mobile"
        },
        {
          "type": "text",
          "id": "mobile_collection_title",
          "label": "Title"
        },
        {
          "type": "range",
          "id": "mobile_collection_limit",
          "min": 2,
          "max": 8,
          "step": 2,
          "default": 4,
          "label": "Products"
        },
        {
          "type": "text",
          "id": "mobile_variant_filter",
          "label": "Show variant containing",
          "info": "e.g. KNWU — products show their first variant whose title contains this text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cols with text"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "eme_banners",
      "label": "Eme-style category banners (tall image, sticky glass label)",
      "default": false
    }
  ]
}
{% endschema %}
