{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{% liquid
  assign country_1 = settings.one_day_shipment
  assign country_2 = settings.two_days_shipment
  assign country_3_5 = settings.three_five_days_shipment
  assign country_5_7 = settings.five_seven_days_shipment
  assign country_7_10 = settings.seven_ten_days_shipment
  assign country_10_14 = settings.ten_fourteen_days_shipment
%}

<cart-items
  class="cart-page{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}"
  x-data="arriving"
  x-init="getCurrentData([ '{{ country_1 }}' ,'{{ country_2 }}','{{ country_3_5 }}' , '{{ country_5_7 }}', '{{ country_7_10 }}','{{ country_10_14 }}'])"
>
  {%- comment -%}
    Cart page in the cart drawer's design: same heading, shipping bar,
    item rows, quantity stepper and (in main-cart-footer) the same
    footer with checkout button. The element ids cart.js relies on stay:
    #main-cart-items > .js-contents, #CartItem-n, #Quantity-n,
    #Line-item-error-n and the cart-remove-button data-index.
  {%- endcomment -%}
  <div class="cart-page__header drawer__header">
    <h1 class="drawer__heading">{{ 'sections.cart.title' | t }}</h1>
  </div>

  {% if cart != empty %}
    <div class="drawer__shipping-bar cart-page__shipping">
      {% render 'free-shipping-progress-bar' %}
    </div>
  {% endif %}

  <div class="cart__warnings">
    <div class="drawer__shipping-bar cart-page__shipping">
      {% render 'free-shipping-progress-bar', hide_gift_widget: true %}
    </div>
    <div class="cart-page__empty">
      <p class="cart-drawer__empty-text cart__empty-text">{{ 'sections.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="cart-drawer__checkout-btn cart-page__empty-btn">
        {{ 'general.continue_shopping' | t }}
      </a>
      {%- if shop.customer_accounts_enabled and customer == null -%}
        <p class="cart-page__login">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>
  </div>

  <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
    <div class="cart__items cart-page__items" id="main-cart-items" data-id="{{ section.id }}">
      <div class="js-contents">
        {%- if cart != empty -%}
          <div class="drawer__cart-items-wrapper cart-page__list">
            {%- for item in cart.items -%}
              {%- liquid
                assign line_is_free_gift = false
                if item.properties['_free_gift'] == 'true' and item.final_line_price == 0 and item.original_line_price > 0
                  assign line_is_free_gift = true
                endif
                assign mczr = 'not-mczr'
                if item.properties._mczr_designId
                  assign mczr = item.properties._mczr_designId
                endif
              -%}
              <div
                id="CartItem-{{ item.index | plus: 1 }}"
                cart-item-id="{{ item.id }}"
                class="cart-item cart-drawer-item{% if item.properties['_free_gift'] == 'true' %} cart-drawer-item--free-gift{% endif %}"
                data-mczr="item-{{ mczr }}"
                {% if item.properties['_free_gift'] == 'true' %}
                  data-free-gift-line="true"
                  data-line="{{ item.index | plus: 1 }}"
                  data-variant-id="{{ item.variant_id }}"
                {% endif %}
              >
                <div class="cart-drawer-item__image">
                  <span class="cart-drawer-item__qty-badge">{{ item.quantity }}</span>
                  {% if item.image or item.properties._mczr_designId %}
                    <a href="{{ item.url }}">
                      <img
                        src="{{ item.image | image_url: width: 200 }}"
                        class="cart-item__image"
                        alt="{{ item.image.alt | escape }}"
                        loading="lazy"
                        width="100"
                        height="{{ 100 | divided_by: item.image.aspect_ratio | ceil }}"
                        data-mczr="item_image-{{ mczr }}"
                      >
                    </a>
                  {% endif %}
                </div>

                <div class="cart-drawer-item__info">
                  <div class="cart-drawer-item__top">
                    <div class="cart-drawer-item__details">
                      <a href="{{ item.url }}" class="cart-drawer-item__title cart-item__name" data-mczr="item_product_title-{{ mczr }}">
                        {{- item.product.title | escape -}}
                      </a>
                      {%- if line_is_free_gift -%}
                        <span class="cart-drawer-item__gift-tag">{{ 'sections.cart.free_gift_label' | t }}</span>
                      {%- endif -%}
                      {%- if item.product.has_only_default_variant == false -%}
                        <p class="cart-drawer-item__options">
                          {%- for option in item.options_with_values -%}
                            {{ option.name }}: {{ option.value }}{% unless forloop.last %} / {% endunless %}
                          {%- endfor -%}
                        </p>
                      {%- endif -%}
                      {%- for property in item.properties -%}
                        {%- assign property_first_char = property.first | slice: 0 -%}
                        {%- if property.last != blank and property_first_char != '_' -%}
                          <p class="cart-drawer-item__options">
                            {% if property.first contains 'customization reference' %}
                              <a href="#" class="colorlab-open-personalisation" data-colorlab="{{ property.last }}">Change customization</a>
                            {%- elsif property.last contains '/uploads/' -%}
                              {{ property.first }}: <a href="{{ property.last }}" class="link" target="_blank">{{ property.last | split: '/' | last }}</a>
                            {% else %}
                              {{ property.first }}: {{ property.last }}
                            {% endif %}
                          </p>
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if item.selling_plan_allocation != null -%}
                        <p class="cart-drawer-item__options">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                      {%- endif -%}
                      {%- if item.discounts.size > 0 and line_is_free_gift == false -%}
                        <ul class="discounts list-unstyled cart-page__line-discounts" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                          {%- for discount in item.discounts -%}
                            <li class="discounts__discount">
                              {%- render 'icon-discount' -%}
                              {{ discount.title }}
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                    <div class="cart-drawer-item__price cart-item__totals">
                      <div class="loading-overlay hidden">
                        <div class="loading-overlay__spinner">
                          <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                            <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                          </svg>
                        </div>
                      </div>
                      <div class="cart-item__price-wrapper{% if line_is_free_gift %} cart-item__price-wrapper--free{% endif %}">
                        {%- if line_is_free_gift -%}
                          <span class="cart-drawer-item__sale-price cart-drawer-item__free-price">{{ 'sections.cart.free_gift_free_tag' | t }}</span>
                          <s class="cart-drawer-item__old-price">{{ item.original_line_price | money_without_currency }}</s>
                        {%- elsif item.original_line_price != item.final_line_price -%}
                          <span class="cart-drawer-item__sale-price" data-mczr="item_final_line_price-{{ mczr }}">{{ item.final_line_price | money_without_currency }}</span>
                          <s class="cart-drawer-item__old-price" data-mczr="item_original_line_price-{{ mczr }}">{{ item.original_line_price | money_without_currency }}</s>
                        {%- else -%}
                          <span data-mczr="item_original_line_price-{{ mczr }}">{{ item.original_line_price | money_without_currency }}</span>
                        {%- endif -%}
                        {%- if item.variant.available and item.unit_price_measurement -%}
                          <div class="unit-price caption">
                            <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                            {{ item.variant.unit_price | money }}
                            <span aria-hidden="true">/</span>
                            <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
                            {%- if item.variant.unit_price_measurement.reference_value != 1 -%}
                              {{- item.variant.unit_price_measurement.reference_value -}}
                            {%- endif -%}
                            {{ item.variant.unit_price_measurement.reference_unit }}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>

                  <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                    <small class="cart-item__error-text"></small>
                    <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-error" viewBox="0 0 13 13">
                      <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                      <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                      <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                      <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7"/>
                    </svg>
                  </div>

                  <div class="cart-drawer-item__quantity-row">
                    <div class="cart-drawer-item__quantity">
                      <cart-remove-button id="Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                        <button type="button" class="cart-drawer-item__trash" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}">
                          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M2 4h12M5.333 4V2.667a1.333 1.333 0 011.334-1.334h2.666a1.333 1.333 0 011.334 1.334V4m2 0v9.333a1.333 1.333 0 01-1.334 1.334H4.667a1.333 1.333 0 01-1.334-1.334V4h9.334z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                      </cart-remove-button>
                      <quantity-input class="cart-drawer-item__qty-input">
                        <button class="cart-drawer-item__qty-btn no-js-hidden" name="minus" type="button">
                          <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}</span>
                          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        </button>
                        <input
                          class="cart-drawer-item__qty-number"
                          type="number"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          min="0"
                          aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                          id="Quantity-{{ item.index | plus: 1 }}"
                          data-index="{{ item.index | plus: 1 }}"
                        >
                        <button class="cart-drawer-item__qty-btn no-js-hidden" name="plus" type="button">
                          <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}</span>
                          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 2.5v7M2.5 6h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        </button>
                      </quantity-input>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
    <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">
      {{ 'accessibility.loading' | t }}
    </p>
  </form>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}