{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<link
  rel="preload"
  href="{{ 'component-rte.css' | asset_url }}"
  as="style"
  onload="this.onload=null;this.rel='stylesheet'"
>

{%- if section.settings.enable_quick_add -%}
  <link rel="stylesheet" href="{{ 'quick-add.css' | asset_url }}" media="print" onload="this.media='all'">
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding bg-background">
  {% if section.settings.navigation != blank %}
    {%- comment -%}
      Sits directly on top of the collection banner above (negative
      margin, see .collection-tags-wrapper in custom.css) instead of in
      its own white strip below it — the pills' backdrop-filter now
      blurs the real banner photo through natural visual overlap, no
      simulated backdrop image needed. main-collection-banner's own
      height setting is bumped by this menu's height (~72px) so the
      overlap doesn't eat into the photo's visible area.
    {%- endcomment -%}
    <div class="collection-tags-wrapper" id="CollectionTagsWrapper-{{ section.id }}">
      {%- liquid
        comment
          Is the current collection one of the menu links? If not, the bar
          gets the current collection as an extra, active first item, so
          the visitor always sees where they are (e.g. accessoires, KNWU).
        endcomment
        assign cat_has_active = false
        for link in section.settings.navigation.links
          if link.active or link.child_active or link.url == collection.url
            assign cat_has_active = true
            break
          endif
        endfor
      -%}
      <div class="collection-tags" id="CollectionTags-{{ section.id }}">
        {%- unless cat_has_active or collection == blank -%}
          {%- liquid
            comment
              Long titles are shortened at a word boundary so the bar keeps
              its rhythm: "KNWU x SOCKELOEN -- AERO CYCLING SOCKS" becomes
              "KNWU x SOCKELOEN…". Separators left dangling are dropped.
            endcomment
            assign cur_title = collection.title | strip
            if cur_title.size > 22
              assign cur_title = cur_title | truncatewords: 3, ''
              assign cur_title = cur_title | strip | replace: ' --', '' | replace: ' -', '' | replace: ' |', '' | replace: ' /', '' | strip
              if cur_title.size > 24
                assign cur_title = cur_title | truncate: 24, ''
              endif
              assign cur_title = cur_title | append: '…'
            endif
          -%}
          <div class="whitespace-nowrap">
            <a
              class="tag-button bg-white text-black active tag-button--current{% if collection.title contains 'UCI' or collection.title contains 'KNWU' %} tag-button--preserve-case{% endif %}"
              href="{{ collection.url }}"
              aria-current="page"
              title="{{ collection.title | escape }}"
            >{{ cur_title }}</a>
          </div>
        {%- endunless -%}
        {% for link in section.settings.navigation.links %}
          <div class="whitespace-nowrap">
            <a
              class="tag-button bg-white text-black {% if link.active or link.url == collection.url %}active{% endif %}{% if link.title contains 'UCI' %} tag-button--preserve-case{% endif %}"
              href="{{ link.url }}"
            >{{ link.title }}</a>
          </div>
        {% endfor %}
      </div>
    </div>
    <script>
      (function() {
        var wrapper = document.getElementById('CollectionTagsWrapper-{{ section.id }}');
        if (!wrapper) return;
        var track = wrapper.querySelector('.collection-tags');

        /* The bar lives on the banner (like the homepage category bar), so the
           product sheet can slide over it. Move it into the banner when there
           is one; otherwise it stays where it is rendered. */
        var banner = document.querySelector('#MainContent .banner');
        if (banner && banner.querySelector('.banner__media')) {
          banner.appendChild(wrapper);
          wrapper.classList.add('on-banner');
        }

        /* Scroll cue: fade the edge that still has items behind it. */
        function updateEdges() {
          var maxScroll = track.scrollWidth - track.clientWidth;
          wrapper.classList.toggle('is-scrollable', maxScroll > 1);
          wrapper.classList.toggle('at-start', track.scrollLeft <= 1);
          wrapper.classList.toggle('at-end', track.scrollLeft >= maxScroll - 1);
        }
        track.addEventListener('scroll', updateEdges, { passive: true });
        window.addEventListener('resize', updateEdges);
        updateEdges();

        /* Start with the active item in view. */
        var active = track.querySelector('.tag-button.active');
        if (active) {
          var a = active.parentElement;
          var target = a.offsetLeft - (track.clientWidth - a.offsetWidth) / 2;
          if (target > 0) track.scrollLeft = target;
          updateEdges();
        }

        /* Sheet corners: square at the top, rounded once the page scrolls. */
        var root = document.documentElement;
        var ticking = false;
        function updateScrolled() {
          root.classList.toggle('is-scrolled', window.scrollY > 4);
          ticking = false;
        }
        window.addEventListener('scroll', function() {
          if (!ticking) { ticking = true; requestAnimationFrame(updateScrolled); }
        }, { passive: true });
        updateScrolled();
      })();
    </script>
  {% endif %}
  {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
  {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
    <facet-filters-form class="facets facets-vertical-sort page-width small-hide no-js-hidden">
      <form class="facets-vertical-form" id="FacetSortForm">
        <div class="facet-filters sorting caption">
          <div class="facet-filters__field">
            <h2 class="facet-filters__label caption-large text-body">
              <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
            </h2>
            <div class="select">
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              <select
                name="sort_by"
                class="facet-filters__sort select__select caption-large"
                id="SortBy"
                aria-describedby="a11y-refresh-page-message"
              >
                {%- for option in collection.sort_options -%}
                  <option
                    value="{{ option.value | escape }}"
                    {% if option.value == sort_by %}
                      selected="selected"
                    {% endif %}
                  >
                    {{ option.name | escape }}
                  </option>
                {%- endfor -%}
              </select>
              {% render 'icon-caret' %}
            </div>
          </div>
          <noscript>
            <button type="submit" class="facets__button-no-js button button--secondary">
              {{ 'products.facets.sort_button' | t }}
            </button>
          </noscript>
        </div>

        <div class="product-count-vertical light" role="status">
          <h2 class="product-count__text text-body">
            <span id="ProductCountDesktop">
              {%- if collection.results_count -%}
                {{
                  'templates.search.results_with_count'
                  | t: terms: collection.terms, count: collection.results_count
                }}
              {%- elsif collection.products_count == collection.all_products_count -%}
                {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
              {%- else -%}
                {{
                  'products.facets.product_count'
                  | t: product_count: collection.products_count, count: collection.all_products_count
                }}
              {%- endif -%}
            </span>
          </h2>
          <div class="loading-overlay__spinner">
            <svg
              aria-hidden="true"
              focusable="false"
              role="presentation"
              class="spinner"
              viewBox="0 0 66 66"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
            </svg>
          </div>
        </div>
      </form>
    </facet-filters-form>
  {%- endif -%}

  <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
    {{ 'component-facets.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
    {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
      <aside
        aria-labelledby="verticalTitle"
        class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
        id="main-collection-filters"
        data-id="{{ section.id }}"
      >
        {% render 'facets',
          results: collection,
          enable_filtering: section.settings.enable_filtering,
          enable_sorting: section.settings.enable_sorting,
          filter_type: section.settings.filter_type
        %}
      </aside>
    {%- endif -%}
    {% render 'breadcrumbs' %}

    <div class="product-grid-container mt-16" id="ProductGridContainer">
      {%- paginate collection.products by 1000 -%}
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}">
            <div class="loading-overlay gradient"></div>

            {%- if section.settings.alternate_second_image -%}
            <style>
              /* checkerboard cards: .card-swap-d (4-column layout, from 768px) / .card-swap-m (2 columns below) open with the 2nd photo and show the 1st on hover */
              @media screen and (min-width: 768px) {
                #product-grid .card-swap-d .media.media--hover-effect:not(.no-has-second-image) > img:first-child:not(:only-child) { opacity: 0; }
                #product-grid .card-swap-d .media.media--hover-effect:not(.no-has-second-image) > img + img { opacity: 1; }
              }
              @media screen and (min-width: 990px) {
                #product-grid .card-swap-d .card-wrapper:hover .media.media--hover-effect:not(.no-has-second-image) > img:first-child:not(:only-child) { opacity: 1; display: block; transform: scale(1.03); transition: transform var(--duration-long) ease; }
                #product-grid .card-swap-d .card-wrapper:hover .media.media--hover-effect:not(.no-has-second-image) > img + img { opacity: 0; }
              }
              @media screen and (max-width: 767px) {
                #product-grid .card-swap-m .media.media--hover-effect:not(.no-has-second-image) > img:first-child:not(:only-child) { opacity: 0; }
                #product-grid .card-swap-m .media.media--hover-effect:not(.no-has-second-image) > img + img { opacity: 1; }
              }
            </style>
            {%- endif -%}
            {%- if section.settings.disable_image_hover -%}
            <style>
              /* no photo change on hover (after the checkerboard rules on purpose: same specificity, later wins): each card keeps the photo it opened with (also for the checkerboard cards) */
              @media screen and (min-width: 990px) {
                #product-grid .card-wrapper:hover .media.media--hover-effect:not(.no-has-second-image) > img:first-child:not(:only-child) { opacity: 1; display: block; transform: none; }
                #product-grid .card-wrapper:hover .media.media--hover-effect > img + img { opacity: 0; transform: none; }
                #product-grid .card-swap-d .card-wrapper:hover .media.media--hover-effect:not(.no-has-second-image) > img:first-child:not(:only-child) { opacity: 0; }
                #product-grid .card-swap-d .card-wrapper:hover .media.media--hover-effect:not(.no-has-second-image) > img + img { opacity: 1; }
                #product-grid .card-wrapper:hover .media.media--hover-effect > img:only-child { transform: none; }
              }
            </style>
            {%- endif -%}
            {%- assign grid_cols = section.settings.columns_desktop | default: 4 | plus: 0 -%}
            {%- if grid_cols == 3 -%}
            <style>
              @media screen and (min-width: 990px) { #product-grid.product-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
            </style>
            {%- endif -%}
            {%- if grid_cols == 6 -%}
            <style>
              @media screen and (min-width: 990px) { #product-grid.product-grid--6 { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
            </style>
            {%- endif -%}
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="grid grid-cols-2 md:grid-cols-4{% if grid_cols == 6 %} product-grid--6{% elsif grid_cols == 3 %} product-grid--3{% endif %}"
            >
              {%- comment -%}
                On by default everywhere. Set the collection's
                custom.show_color_swatches metafield to false to opt a
                specific collection OUT — can't use the `default` filter
                here since Liquid's `default` also replaces an explicit
                `false` with the fallback, which would make "turn it off"
                impossible.
              {%- endcomment -%}
              {% assign show_color_swatches_for_collection = true %}
              {% if collection.metafields.custom.show_color_swatches == false %}
                {% assign show_color_swatches_for_collection = false %}
              {% endif %}
              {% if section.settings.force_variant_cards %}
                {% assign show_color_swatches_for_collection = false %}
              {% endif %}
              {%- assign card_n = 0 -%}
              {%- comment -%}
                Smart lists (no metafields): 'new' = published in the last X days, best selling first,
                always exactly `smart_limit` products; 'sale' = discounted products ranked by sales and
                discount. The page's own collection is the source (sorted by best selling, in stock), see
                snippets/smart-product-list.liquid. Pagination is off in that case.
              {%- endcomment -%}
              {%- assign smart_mode = section.settings.smart_mode | default: 'none' -%}
              {%- assign grid_products = collection.products -%}
              {%- if smart_mode == 'new' or smart_mode == 'sale' -%}
                {%- capture smart_handles -%}{%- render 'smart-product-list', mode: smart_mode, source: collection, limit: section.settings.smart_limit, days: section.settings.smart_days -%}{%- endcapture -%}
                {%- assign smart_arr = smart_handles | strip | split: ',' -%}
                {%- assign grid_products = '' | split: '' -%}
                {%- for h in smart_arr -%}
                  {%- if h == '' -%}{%- continue -%}{%- endif -%}
                  {%- assign hit = collection.products | where: 'handle', h -%}
                  {%- assign grid_products = grid_products | concat: hit -%}
                {%- endfor -%}
              {%- endif -%}
              {%- for product in grid_products -%}
                {% assign lazy_load = false %}
                {% assign coming_soon = product.metafields.custom.coming_soon | default: false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}
                {% for option in product.options %}
                  {% if product.options_by_name.Color == null %}
                    {% assign optionByName = product.options_by_name.Kleur %}
                  {% else %}
                    {% assign optionByName = product.options_by_name.Color %}
                  {% endif %}
                  {% if optionByName.values == null or optionByName.values.size == 1 %}
                    {% if shop.metafields.soldout_variants.enable or product.available or coming_soon or section.settings.show_sold_out %}
                      {%- assign card_n = card_n | plus: 1 -%}
                      {%- assign swap_cls = '' -%}
                      {%- if section.settings.alternate_second_image -%}
                        {%- comment -%} checkerboard over the desktop column count (4 or 6), 2 columns on phones; a card opens with its 2nd photo when row + column is odd {%- endcomment -%}
                        {%- assign i0 = card_n | minus: 1 -%}
                        {%- assign d_sum = i0 | modulo: grid_cols | plus: 1 -%}{%- assign d_row = i0 | divided_by: grid_cols | plus: 1 -%}{%- assign d_sum = d_sum | plus: d_row | modulo: 2 -%}
                        {%- assign m_sum = i0 | modulo: 2 | plus: 1 -%}{%- assign m_row = i0 | divided_by: 2 | plus: 1 -%}{%- assign m_sum = m_sum | plus: m_row | modulo: 2 -%}
                        {%- if d_sum == 1 -%}{%- assign swap_cls = swap_cls | append: ' card-swap-d' -%}{%- endif -%}
                        {%- if m_sum == 1 -%}{%- assign swap_cls = swap_cls | append: ' card-swap-m' -%}{%- endif -%}
                      {%- endif -%}
                      <li id="product" class="w-full{{ swap_cls }}">
                        {% render 'card-product',
                          card_product: product,
                          hide_color_row: section.settings.force_variant_cards,
                          product_title: product.title,
                          media_aspect_ratio: section.settings.image_ratio,
                          show_secondary_image: section.settings.show_secondary_image,
                          show_vendor: section.settings.show_vendor,
                          show_rating: section.settings.show_rating,
                          lazy_load: lazy_load,
                          show_quick_add: section.settings.enable_quick_add,
                          section_id: section.id
                        %}
                      </li>
                    {% endif %}
                  {% elsif option == 'Color' or option == 'Kleur' %}
                    {% assign index = forloop.index0 %}
                    {% assign colorlist = '' %}
                    {% assign color = '' %}
                    {% assign atLeastOneAvailable = false %}
                    {%- comment -%}
                      "Variant first": when a rule matches this collection (section setting
                      "handle:text" pairs, or the collection metafield custom.variant_first),
                      the first colour card rendered for a multi-colour product is the
                      variant whose title contains that text (e.g. KNWU). Pass 1 renders
                      only that variant, pass 2 the remaining colours as before.
                    {%- endcomment -%}
                    {%- assign variant_first = collection.metafields.custom.variant_first | default: '' -%}
                    {%- if variant_first == blank and section.settings.variant_first_rules != blank -%}
                      {%- assign vf_rules = section.settings.variant_first_rules | split: ',' -%}
                      {%- for rule in vf_rules -%}
                        {%- assign parts = rule | split: ':' -%}
                        {%- assign rule_handle = parts[0] | strip | downcase -%}
                        {%- if rule_handle == collection.handle -%}
                          {%- assign variant_first = parts[1] | strip -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    {%- comment -%}
                      A product metafield custom.card_variant (text, e.g. "Black") picks the
                      colour shown on this product's card everywhere, above collection rules.
                    {%- endcomment -%}
                    {%- if product.metafields.custom.card_variant != blank -%}
                      {%- assign variant_first = product.metafields.custom.card_variant -%}
                    {%- endif -%}
                    {%- assign vf_needle = variant_first | downcase | strip -%}
                    {%- assign vf_done = false -%}
                    {% for vf_pass in (1..2) %}
                    {% if vf_done %}{% break %}{% endif %}
                    {% if vf_pass == 1 and vf_needle == blank %}{% continue %}{% endif %}
                    {% for variant in product.variants %}
                      {%- comment -%} variant metafield custom.disable = true hides the colour from the grid, like it hides it on the product page {%- endcomment -%}
                      {%- if variant.metafields.custom.disable -%}{% continue %}{%- endif -%}
                      {%- if vf_pass == 1 -%}
                        {%- assign vf_title = variant.title | downcase -%}
                        {%- unless vf_title contains vf_needle -%}{% continue %}{%- endunless -%}
                      {%- endif -%}
                      {% if shop.metafields.soldout_variants.enable or variant.available or coming_soon or section.settings.show_sold_out %}
                        {% capture color %}
                          {{ variant.options[index] }}
                        {% endcapture %}
                        {% for variant2 in product.variants %}
                          {% if variant2.option1 == variant.options[index] %}
                            {% if variant2.inventory_quantity >= 1 %}
                              {% assign atLeastOneAvailable = true %}
                              {% break %}
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                      {% unless colorlist contains color %}
                        {% if shop.metafields.soldout_variants.enable or variant.available or coming_soon or section.settings.show_sold_out %}
                          {%- assign card_n = card_n | plus: 1 -%}
                      {%- assign swap_cls = '' -%}
                      {%- if section.settings.alternate_second_image -%}
                        {%- comment -%} checkerboard over the desktop column count (4 or 6), 2 columns on phones; a card opens with its 2nd photo when row + column is odd {%- endcomment -%}
                        {%- assign i0 = card_n | minus: 1 -%}
                        {%- assign d_sum = i0 | modulo: grid_cols | plus: 1 -%}{%- assign d_row = i0 | divided_by: grid_cols | plus: 1 -%}{%- assign d_sum = d_sum | plus: d_row | modulo: 2 -%}
                        {%- assign m_sum = i0 | modulo: 2 | plus: 1 -%}{%- assign m_row = i0 | divided_by: 2 | plus: 1 -%}{%- assign m_sum = m_sum | plus: m_row | modulo: 2 -%}
                        {%- if d_sum == 1 -%}{%- assign swap_cls = swap_cls | append: ' card-swap-d' -%}{%- endif -%}
                        {%- if m_sum == 1 -%}{%- assign swap_cls = swap_cls | append: ' card-swap-m' -%}{%- endif -%}
                      {%- endif -%}
                      <li id="product" class="w-full relative{{ swap_cls }}">
                            {% render 'card-product-variant',
                              card_product: variant,
                              hide_color_row: section.settings.force_variant_cards,
                              tags: product.tags,
                              title: product.title,
                              color: color,
                              product: product,
                              media_aspect_ratio: section.settings.image_ratio,
                              show_secondary_image: section.settings.show_secondary_image,
                              show_vendor: section.settings.show_vendor,
                              show_rating: section.settings.show_rating,
                              lazy_load: lazy_load,
                              show_quick_add: section.settings.enable_quick_add,
                              section_id: section.id,
                              atLeastOneAvailable: atLeastOneAvailable,
                              show_color_swatches: show_color_swatches_for_collection
                            %}
                          </li>
                          {% if show_color_swatches_for_collection %}
                            {%- assign vf_done = true -%}
                            {% break %}
                          {% endif %}
                        {% endif %}
                        {% capture tempList %}
                        {{ colorlist | append: color | append: " " }}
                      {% endcapture %}
                        {% assign colorlist = tempList %}
                      {% endunless %}
                                          {%- if vf_pass == 1 and colorlist contains color and show_color_swatches_for_collection -%}
                        {%- assign vf_done = true -%}
                      {%- endif -%}
                      {%- if vf_pass == 1 and colorlist contains color -%}{% break %}{%- endif -%}
                    {% endfor %}
                    {% endfor %}
                  {% endif %}
                  {% break %}
                {% endfor %}
              {%- endfor -%}
            </ul>

            {%- if paginate.next and smart_mode == 'none' -%}
              {% comment %} {% render 'pagination', paginate: paginate, anchor: '' %} {% endcomment %}

              <a href="{{ paginate.next.url }}" id="more" class="pointer-events-none w-full text-center"></a>
            {%- endif -%}
            <div class="w-full flex justify-center">
              <div id="load-spinner" class="lds-dual-ring text-pdpbg">.</div>
            </div>
          </div>
        {%- endif -%}
      {%- endpaginate -%}

      {% if section.settings.filter_type == 'drawer' and section.settings.enable_filtering %}
        <facets-open-button>
          <button class="open-facet-drawer">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M3 14L3 13L11 13L11 14L3 14ZM12 17L12 10L14 10L14 13L17 13L17 14L14 14L14 17L12 17Z" fill="black"></path>
              <path fill-rule="evenodd" clip-rule="evenodd" d="M3 7L3 6L6 6L6 7L3 7ZM7 10L7 3L9 3L9 6L17 6L17 7L9 7L9 10L7 10Z" fill="black"></path>
            </svg>
            {{ 'products.facets.filter_and_sort' | t }}
          </button>
        </facets-open-button>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "navigation",
      "label": "Collection Navigation"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 16,
