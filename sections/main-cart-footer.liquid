{%- comment -%}
  Cart page footer in the cart drawer's footer design (subtotal, shipping,
  checkout button, payment icons). cart.js re-renders
  #main-cart-footer > .js-contents, so only the totals sit inside it.
{%- endcomment -%}
<div
  class="cart-page__footer-wrap{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
  x-data="arriving"
  x-init="shippingValues({{ settings.shipping_netherlands_belgium }},{{ settings.shipping_rest_of_the_eu }},{{ settings.shipping_rest_of_the_world }}); getCurrentData([])"
>
  <div class="cart__footer cart-drawer__footer cart-page__footer">
    <div class="cart-drawer__footer-inner">
      {% for block in section.blocks %}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'subtotal' -%}
            <div class="js-contents" {{ block.shopify_attributes }}>
              {%- liquid
                assign free_shipping_cents = settings.free_shipping | times: 100
                assign savings = cart.original_total_price | minus: cart.total_price
                assign code_savings = 0
                for discount in cart.cart_level_discount_applications
                  assign code_savings = code_savings | plus: discount.total_allocated_amount
                endfor
                assign line_savings = savings | minus: code_savings
              -%}
              <div class="cart-drawer__totals cart-page__totals" role="status">
                {%- if savings > 0 -%}
                  <div class="cart-drawer__total-row cart-drawer__total-row--shipping">
                    <span class="cart-drawer__total-label small-text">{{ 'sections.cart.subtotal' | t }}</span>
                    <span class="cart-drawer__total-value small-text">{{ cart.original_total_price | money_without_currency }}</span>
                  </div>
                  {%- for discount in cart.cart_level_discount_applications -%}
                    <div class="cart-drawer__total-row cart-drawer__total-row--shipping cart-page__total-row--discount">
                      <span class="cart-drawer__total-label small-text">{{ 'customer.order.discount' | t }} · {{ discount.title }}</span>
                      <span class="cart-drawer__total-value small-text">-{{ discount.total_allocated_amount | money_without_currency }}</span>
                    </div>
                  {%- endfor -%}
                  {%- if line_savings > 0 -%}
                    <div class="cart-drawer__total-row cart-drawer__total-row--shipping cart-page__total-row--discount">
                      <span class="cart-drawer__total-label small-text">{{ 'customer.order.discount' | t }}</span>
                      <span class="cart-drawer__total-value small-text">-{{ line_savings | money_without_currency }}</span>
                    </div>
                  {%- endif -%}
                {%- endif -%}
                <div class="cart-drawer__total-row cart-drawer__total-row--shipping">
                  <span class="cart-drawer__total-label small-text">{{ 'sections.cart.shipping' | t }}</span>
                  <span class="cart-drawer__total-value small-text">
                    <span class="money {% if cart.total_price >= free_shipping_cents %}hidden{% endif %}" x-text="shipping_value != null ? shipping_value.toLocaleString('nl-NL', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : ''"></span>
                    <span class="font-semibold {% if cart.total_price < free_shipping_cents %}hidden{% endif %}" id="its_free">{{ 'sections.cart.shipping_free' | t }}</span>
                  </span>
                </div>
                <div class="cart-drawer__total-row cart-page__total-row--grand">
                  <span class="cart-drawer__total-label">{%- if savings > 0 -%}{{ 'sections.cart.headings.total' | t }}{%- else -%}{{ 'sections.cart.subtotal' | t }}{%- endif -%}</span>
                  <span class="cart-drawer__total-value" data-mczr="cart_total_price">{{ cart.total_price | money_without_currency }}</span>
                </div>
              </div>
            </div>
          {%- else -%}
            <div class="cart__ctas cart-drawer__buttons" {{ block.shopify_attributes }}>
              <noscript>
                <button type="submit" class="cart__update-button button button--secondary" form="cart">
                  {{ 'sections.cart.update' | t }}
                </button>
              </noscript>
              <button
                type="submit"
                id="checkout"
                class="cart__checkout-button cart-drawer__checkout-btn"
                name="checkout"
                {% if cart == empty %}
                  disabled
                {% endif %}
                form="cart"
              >
                {%- if settings.cart_drawer_button_1_cta != blank -%}
                  {{- settings.cart_drawer_button_1_cta -}}
                {%- else -%}
                  {{- 'sections.cart.checkout_securely' | t -}}
                {%- endif -%}
              </button>
              <div class="cart-drawer__payment-icons">
                {% assign payMethods = 'shop_pay,visa,mastercard,apple_pay,google_pay,amex' | split: ',' %}
                {% for payMethod in payMethods %}
                  {% assign handle = payMethod | handleize %}
                  {% assign iconName = handle | append: '.svg' %}
                  <img src="{{ iconName | asset_url }}" alt="{{ payMethod }}" loading="lazy">
                {% endfor %}
              </div>
            </div>
            {%- comment -%} express checkout buttons left out: the drawer has none {%- endcomment -%}
        {%- endcase -%}
      {% endfor %}

      <small class="tax-note caption-large rte cart-page__tax-note">
        {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
          {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
        {%- elsif cart.taxes_included -%}
          {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
        {%- elsif shop.shipping_policy.body != blank -%}
          {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
        {%- else -%}
          {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
        {%- endif -%}
      </small>

      <div id="cart-errors"></div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function isIE() {
      const ua = window.navigator.userAgent;
      const msie = ua.indexOf('MSIE ');
      const trident = ua.indexOf('Trident/');

      return msie > 0 || trident > 0;
    }

    if (!isIE()) return;
    const cartSubmitInput = document.createElement('input');
    cartSubmitInput.setAttribute('name', 'checkout');
    cartSubmitInput.setAttribute('type', 'hidden');
    document.querySelector('#cart').appendChild(cartSubmitInput);
    document.querySelector('#checkout').addEventListener('click', function (event) {
      document.querySelector('#cart').submit();
    });
  });
</script>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
