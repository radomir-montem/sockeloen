{% assign coming_soon = product.metafields.custom.coming_soon | default: false %}

{% render 'product-structured-data', product: product %}

<section
  id="MainProduct-{{ section.id }}"
  class="page-width section-{{ section.id }}-padding product-section"
  data-section="{{ section.id }}"
  data-uci-badge-text="{{ 'uci_sale.badge_text' | t | escape }}"
>
  {{ 'section-main-product-v2.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-rte.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-v2.js' | asset_url }}" defer="defer"></script>

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {%- comment -%}
    Default size: without a variant in the URL, the page opens on the best-selling
    size (product metafield custom.default_size) of the first colour, unless that
    size is sold out. Done as an early redirect so the whole page renders with it.
  {%- endcomment -%}
  {%- liquid
    assign default_size = product.metafields.custom.default_size
    assign default_variant_id = nil
    if default_size != blank and product.variants.size > 1
      assign size_index = nil
      for opt in product.options_with_values
        assign opt_name = opt.name | downcase
        if opt_name contains 'size' or opt_name contains 'maat' or opt_name contains 'größe'
          assign size_index = forloop.index0
        endif
      endfor
      if size_index != nil
        assign base = product.selected_or_first_available_variant
        for v in product.variants
          if v.available == false or v.options[size_index] != default_size
            continue
          endif
          assign same = true
          for o in v.options
            if forloop.index0 != size_index and o != base.options[forloop.index0]
              assign same = false
            endif
          endfor
          if same
            assign default_variant_id = v.id
            break
          endif
        endfor
      endif
    endif
  -%}
  {%- if default_variant_id != nil and default_variant_id != product.selected_or_first_available_variant.id -%}
    <script>
      (function () {
        var u = new URL(location.href);
        if (u.searchParams.has('variant')) return;
        u.searchParams.set('variant', '{{ default_variant_id }}');
        location.replace(u.toString());
      })();
    </script>
  {%- endif -%}
  {{ 'pdp-gallery-layout.css' | asset_url | stylesheet_tag }}
  <div class="product-v2 product--medium product--left product--thumbnail grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}{% if settings.pdp_desktop_layout == 'gallery' %} product-v2--gallery{% endif %}">
    {%- comment -%}
      Desktop layout experiment ("gallery": full-height photo strip with the
      buy box as glass tiles over it, see assets/pdp-gallery-layout.css).
      The theme setting decides; ?pdp=gallery or ?pdp=classic in the URL
      overrides it for this browser tab, to compare the two.
    {%- endcomment -%}
    <script>
      (function () {
        try {
          var m = /[?&]pdp=(gallery|classic)/.exec(location.search);
          if (m) sessionStorage.setItem('pdpLayout', m[1]);
          var v = sessionStorage.getItem('pdpLayout');
          var root = document.currentScript.parentElement;
          if (v === 'gallery') root.classList.add('product-v2--gallery');
          if (v === 'classic') root.classList.remove('product-v2--gallery');
        } catch (e) {}
      })();
    </script>

    {%- comment -%} ========== LEFT COLUMN: MEDIA ========== {%- endcomment -%}
    <div class="grid__item product-v2__media-wrapper relative">

      {%- comment -%} Breadcrumb overlay {%- endcomment -%}
      {% render 'breadcrumb-overlay' %}
      <script src="{{ 'pdp-gallery.js' | asset_url }}" defer></script>

      {%- comment -%}
        Benefit tags over the photo (bottom-left, like a "model wears M"
        note): the same benefit metafields as the checklist in the buy box
        (1-3 with the theme-editor fallbacks, 4-5 only when filled in). Styled as the product
        card badges. Phone widths only; on desktop the gallery is a grid.
      {%- endcomment -%}
      {%- liquid
        assign tag1 = product.metafields.custom.custom_benefit_1.value | default: product.metafields.custom.custom_benefit_1
        assign tag2 = product.metafields.custom.custom_benefit_2.value | default: product.metafields.custom.custom_benefit_2
        assign tag3 = product.metafields.custom.custom_benefit_3.value | default: product.metafields.custom.custom_benefit_3
        if tag1 == blank
          assign tag1 = 'products.v2.default_benefit_1' | t
        endif
        if tag2 == blank
          assign tag2 = 'products.v2.default_benefit_2' | t
        endif
        if tag3 == blank
          assign tag3 = 'products.v2.default_benefit_3' | t
        endif
        assign tag4 = product.metafields.custom.custom_benefit_4.value | default: product.metafields.custom.custom_benefit_4
        assign tag5 = product.metafields.custom.custom_benefit_5.value | default: product.metafields.custom.custom_benefit_5
      -%}
      {%- if tag1 != blank or tag2 != blank or tag3 != blank or tag4 != blank or tag5 != blank -%}
        <div class="pdp-tags" aria-hidden="true" id="PdpTags-{{ section.id }}">
          {%- if tag1 != blank -%}<span class="pdp-tag is-visible" data-photo="0">{{ tag1 | strip | remove: '.' }}</span>{%- endif -%}
          {%- if tag2 != blank -%}<span class="pdp-tag" data-photo="1">{{ tag2 | strip | remove: '.' }}</span>{%- endif -%}
          {%- if tag3 != blank -%}<span class="pdp-tag" data-photo="2">{{ tag3 | strip | remove: '.' }}</span>{%- endif -%}
          {%- if tag4 != blank -%}<span class="pdp-tag" data-photo="3">{{ tag4 | strip | remove: '.' }}</span>{%- endif -%}
          {%- if tag5 != blank -%}<span class="pdp-tag" data-photo="4">{{ tag5 | strip | remove: '.' }}</span>{%- endif -%}
        </div>
        <script>
          /* One benefit per photo: the tag shown follows the active slide
             (1st photo = 1st benefit, ... 5th = 5th, then none; a benefit
             that is not filled in leaves its photo without a tag). */
          (function init() {
            /* the gallery is rendered after this script; wait for the DOM */
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', init);
              return;
            }
            var tags = document.getElementById('PdpTags-{{ section.id }}');
            var list = document.querySelector('.product-v2 .product__media-list');
            if (!tags || !list) return;
            var items = Array.prototype.slice.call(tags.querySelectorAll('.pdp-tag'));
            if (!items.length) return;
            function update() {
              var slides = Array.prototype.slice.call(list.querySelectorAll('.product__media-item:not(.pdp-clone)')).filter(function (s) {
                return s.style.display !== 'none';
              });
              /* the desktop gallery layout shows the photos in its own order (data-pdp-order) */
              if (slides.length && slides[0].hasAttribute('data-pdp-order')) {
                slides.sort(function (a, b) { return a.getAttribute('data-pdp-order') - b.getAttribute('data-pdp-order'); });
              }
              var active = slides.findIndex(function (s) { return s.classList.contains('is-active'); });
              if (active < 0) active = 0;
              /* photo 1 > benefit 1, photo 2 > benefit 2, ...; later photos show none */
              items.forEach(function (t) { t.classList.toggle('is-visible', Number(t.getAttribute('data-photo')) === active); });
            }
            new MutationObserver(update).observe(list, { attributes: true, attributeFilter: ['class', 'style', 'data-pdp-order'], subtree: true });
            update();
          })();
        </script>
      {%- endif -%}

      {%- comment -%}
        Custom merchandising badges (product.metafields.custom.badge,
        e.g. "UCI SALE -30%") and the sold-out badge, both shown over the
        product image gallery. Restored after being removed along with
        the AOV sale campaign's own "UCI SALE 3 + 1 FREE" badge — that
        was a different thing (JS-injected onto the AOV widget itself,
        not this block), and removing this too silently broke the custom
        badge on any product that had one configured (e.g. Aero Toe
        Cover, Base Layer).
      {%- endcomment -%}
      {% assign showOthersBadges = true %}
      <div class="absolute top-[15px] left-[12px] card-badge !py-6 z-[1]" style="top: 44px;">
        {%- if product.available == false -%}
          {% assign renderComingSoon = product.metafields.custom.coming_soon | default: false %}
          {% unless renderComingSoon %}
            <span
              id="Badge-{{ section.id }}-{{ product.id }}"
              class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}"
            >
              {{- 'products.product.sold_out' | t -}}
            </span>
          {% endunless %}
        {%- elsif product.compare_at_price > product.price and product.available -%}
          {%- comment -%} Sale badge hidden — using save badge in price area instead {%- endcomment -%}
          {% assign showOthersBadges = false %}
        {%- endif -%}
        {% if showOthersBadges %}
          {% for badge in product.metafields.custom.badge.value %}
            {%- comment -%}
              Badge values starting with "uci" are permanently skipped —
              the UCI name/flag were removed on legal request from the
              UCI (2026-07) and the raw metafield texts must never
              resurface.
            {%- endcomment -%}
            {%- assign badge_prefix = badge | slice: 0, 3 | downcase -%}
            {%- if badge_prefix == 'uci' -%}{% continue %}{%- endif -%}
            <span
              id="Badge-{{ section.id }}-{{ product.id }}"
              class="badge badge--bottom-left uppercase mr-[6px] z-50"
              {% if product.metafields.custom.first_badge_color and forloop.index == 1 %}
                style="background-color: {{ product.metafields.custom.first_badge_color.value }};"
              {% elsif product.metafields.custom.second_badge_color and forloop.index == 2 %}
                style="background-color: {{ product.metafields.custom.second_badge_color.value }};"
              {% elsif product.metafields.custom.third_badge_color and forloop.index == 3 %}
                style="background-color: {{ product.metafields.custom.third_badge_color.value }};"
              {% else %}
                style="background-color: {{ settings.sold_out_badge_color }};"
              {% endif %}
            >
              {{ badge }}
            </span>
          {% endfor %}
        {% endif %}
      </div>

      {%- comment -%} Media Gallery {%- endcomment -%}
      <media-gallery
        id="MediaGallery-{{ section.id }}"
        role="region"
        {% if section.settings.enable_sticky_info %}
          class="product__media-gallery"
        {% endif %}
        aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
        data-desktop-layout="thumbnail"
      >
        <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>
        <slider-component id="GalleryViewer-{{ section.id }}" class="slider-mobile-gutter show-arrow-button">
          <a class="skip-to-content-link button visually-hidden quick-add-hidden" href="#ProductInfo-{{ section.id }}">
            {{ 'accessibility.skip_to_product_info' | t }}
          </a>
          <ul
            id="Slider-Gallery-{{ section.id }}"
            class="product__media-list contains-media grid grid--peek list-unstyled slider slider--mobile"
            role="list"
          >
            {%- liquid
              assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
              if section.settings.hide_variants and variant_images.size == product.media.size
                assign single_media_visible = true
              endif

              assign media_count = product.media.size
              if section.settings.hide_variants and media_count > 1 and variant_images.size > 0
                assign media_count = media_count | minus: variant_images.size | plus: 1
              endif

              if media_count == 1 or single_media_visible
                assign single_media_visible_mobile = true
              endif

              assign media_width = 0.55
            -%}
            {%- if product.selected_or_first_available_variant.featured_media != null -%}
              {%- assign featured_media = product.selected_or_first_available_variant.featured_media -%}
              <li
                id="Slide-{{ section.id }}-{{ featured_media.id }}"
                class="product__media-item grid__item slider__slide is-active{% if single_media_visible %} product__media-item--single{% endif %}{% if featured_media.media_type != 'image' %} product__media-item--full{% endif %}{% if section.settings.hide_variants and variant_images contains featured_media.src %} product__media-item--variant{% endif %}"
                data-media-id="{{ section.id }}-{{ featured_media.id }}"
                data-variant-alt="{{ featured_media.alt | escape }}"
              >
                {%- assign media_position = 1 -%}
                {% render 'product-thumbnail',
                  inline_video: true,
                  media: featured_media,
                  media_count: media_count,
                  position: media_position,
                  desktop_layout: 'thumbnail',
                  mobile_layout: 'show',
                  loop: section.settings.enable_video_looping,
                  modal_id: section.id,
                  xr_button: true,
                  media_width: media_width,
                  lazy_load: false
                %}
              </li>
            {%- endif -%}
            {%- for media in product.media -%}
              {%- unless media.id == product.selected_or_first_available_variant.featured_media.id -%}
                {%- comment -%} a video without alt text (Liquid then reports the product title) is shown for every colour; images keep the colour filter {%- endcomment -%}
                {%- assign media_all = false -%}
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}{%- if media.alt == product.title -%}{%- assign media_all = true -%}{%- endif -%}{%- endif -%}
                <li
                  data-variant-alt="{{ media.alt | escape }}"
                  {% if media_all %}data-media-all{% endif %}
                  {% assign variants_size = product.variants | size %}
                  {% if variants_size > 1 and media.alt != blank and media_all == false %}
                    {% unless media.alt == product.selected_or_first_available_variant.featured_media.alt -%}
                      style="display: none"
                    {%- endunless %}
                  {% endif %}
                  id="Slide-{{ section.id }}-{{ media.id }}"
                  class="product__media-item grid__item slider__slide{% if single_media_visible %} product__media-item--single{% endif %}{% if product.selected_or_first_available_variant.featured_media == null and forloop.index == 1 %} is-active{% endif %}{% if media.media_type != 'image' %} product__media-item--full{% endif %}{% if section.settings.hide_variants and variant_images contains media.src %} product__media-item--variant{% endif %}"
                  data-media-id="{{ section.id }}-{{ media.id }}"
                >
                  {%- liquid
                    assign media_position = media_position | default: 0 | plus: 1
                    assign lazy_load = false
                    if media_position > 1
                      assign lazy_load = true
                    endif
                    render 'product-thumbnail', inline_video: true, media: media, media_count: media_count, position: media_position, desktop_layout: 'thumbnail', mobile_layout: 'show', loop: section.settings.enable_video_looping, modal_id: section.id, xr_button: true, media_width: media_width, lazy_load: lazy_load
                  -%}
                </li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
          {%- unless single_media_visible_mobile -%}
            <div class="slider-buttons no-js-hidden quick-add-hidden">
              <button
                type="button"
                class="slider-button slider-button--prev"
                name="previous"
                aria-label="{{ 'general.slider.previous_slide' | t }}"
              >
                {% render 'icon-caret' %}
              </button>
              <div class="slider-counter caption">
                <span class="slider-counter--current">1</span>
                <span aria-hidden="true"> / </span>
                <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                <span class="slider-counter--total">{{ media_count }}</span>
              </div>
              <button
                type="button"
                class="slider-button slider-button--next"
                name="next"
                aria-label="{{ 'general.slider.next_slide' | t }}"
              >
                {% render 'icon-caret' %}
              </button>
            </div>
          {%- endunless -%}
        </slider-component>

        {%- comment -%} Thumbnails — always shown on mobile {%- endcomment -%}
        {%- if media_count > 1 -%}
          <slider-component
            id="GalleryThumbnails-{{ section.id }}"
            class="thumbnail-slider slider-mobile-gutter quick-add-hidden{% if media_count <= 3 %} thumbnail-slider--no-slide{% endif %}"
          >
            <button
              type="button"
              class="slider-button slider-button--prev{% if media_count <= 3 %} small-hide{% endif %}{% if media_count <= 4 %} medium-hide large-up-hide{% endif %}"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="GalleryThumbnails-{{ section.id }}"
              data-step="3"
            >
              {% render 'icon-caret' %}
            </button>
            <ul
              id="Slider-Thumbnails-{{ section.id }}"
              class="thumbnail-list list-unstyled slider slider--mobile{% if section.settings.gallery_layout == 'thumbnail_slider' %} slider--tablet-up{% endif %}"
            >
              {%- if featured_media != null -%}
                {%- liquid
                  capture media_index
                    if featured_media.media_type == 'model'
                      increment model_index
                    elsif featured_media.media_type == 'video' or featured_media.media_type == 'external_video'
                      increment video_index
                    elsif featured_media.media_type == 'image'
                      increment image_index
                    endif
                  endcapture
                  assign media_index = media_index | plus: 1
                -%}
                <li
                  id="Slide-Thumbnails-{{ section.id }}-0"
                  class="thumbnail-list__item slider__slide{% if section.settings.hide_variants and variant_images contains featured_media.src %} thumbnail-list_item--variant{% endif %}"
                  data-target="{{ section.id }}-{{ featured_media.id }}"
                  data-media-position="{{ media_index }}"
                  data-variant-alt="{{ featured_media.alt | escape }}"
                >
                  <button
                    class="thumbnail global-media-settings global-media-settings--no-shadow {% if featured_media.preview_image.aspect_ratio > 1 %}thumbnail--wide{% else %}thumbnail--narrow{% endif %}"
                    aria-label="{%- if featured_media.media_type == 'image' -%}{{ 'products.product.media.load_image' | t: index: media_index }}{%- elsif featured_media.media_type == 'model' -%}{{ 'products.product.media.load_model' | t: index: media_index }}{%- elsif featured_media.media_type == 'video' or featured_media.media_type == 'external_video' -%}{{ 'products.product.media.load_video' | t: index: media_index }}{%- endif -%}"
                    aria-current="true"
                    aria-controls="GalleryViewer-{{ section.id }}"
                    aria-describedby="Thumbnail-{{ section.id }}-0"
                  >
                    <img
                      id="Thumbnail-{{ section.id }}-0"
                      srcset="
                        {% if featured_media.preview_image.width >= 54 %}{{ featured_media.preview_image | image_url: width: 54 }} 54w,{% endif %}
                        {% if featured_media.preview_image.width >= 74 %}{{ featured_media.preview_image | image_url: width: 74 }} 74w,{% endif %}
                        {% if featured_media.preview_image.width >= 104 %}{{ featured_media.preview_image | image_url: width: 104 }} 104w,{% endif %}
                        {% if featured_media.preview_image.width >= 162 %}{{ featured_media.preview_image | image_url: width: 162 }} 162w,{% endif %}
                        {% if featured_media.preview_image.width >= 208 %}{{ featured_media.preview_image | image_url: width: 208 }} 208w,{% endif %}
                        {{ featured_media.preview_image | image_url }} {{ featured_media.preview_image.width }}w
                      "
                      src="{{ featured_media | image_url: width: 208 }}"
                      sizes="(min-width: 990px) 72px, 60px"
                      alt="{{ featured_media.alt | escape }}"
                      height="208"
                      width="208"
                      loading="lazy"
                    >
                  </button>
                </li>
              {%- endif -%}
              {%- for media in product.media -%}
                {%- unless media.id == product.selected_or_first_available_variant.featured_media.id -%}
                  {%- liquid
                    capture media_index
                      if media.media_type == 'model'
                        increment model_index
                      elsif media.media_type == 'video' or media.media_type == 'external_video'
                        increment video_index
                      elsif media.media_type == 'image'
                        increment image_index
                      endif
                    endcapture
                    assign media_index = media_index | plus: 1
                  -%}
                  <li
                    id="Slide-Thumbnails-{{ section.id }}-{{ forloop.index }}"
                    class="thumbnail-list__item slider__slide{% if section.settings.hide_variants and variant_images contains media.src %} thumbnail-list_item--variant{% endif %}"
                    data-target="{{ section.id }}-{{ media.id }}"
                    data-media-position="{{ media_index }}"
                    {%- assign media_all = false -%}
                    {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}{%- if media.alt == product.title -%}{%- assign media_all = true -%}{%- endif -%}{%- endif -%}
                    data-variant-alt="{{ media.alt | escape }}"
                    {% if media_all %}data-media-all{% endif %}
                    {% if product.variants.size > 1 and media.alt != blank and media_all == false and media.alt != product.selected_or_first_available_variant.featured_media.alt %}
                      style="display: none"
                    {% endif %}
                  >
                    {%- if media.media_type == 'model' -%}
                      <span class="thumbnail__badge" aria-hidden="true">
                        {%- render 'icon-3d-model' -%}
                      </span>
                    {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                      <span class="thumbnail__badge" aria-hidden="true">
                        {%- render 'icon-play' -%}
                      </span>
                    {%- endif -%}
                    <button
                      class="thumbnail global-media-settings global-media-settings--no-shadow {% if media.preview_image.aspect_ratio > 1 %}thumbnail--wide{% else %}thumbnail--narrow{% endif %}"
                      aria-label="{%- if media.media_type == 'image' -%}{{ 'products.product.media.load_image' | t: index: media_index }}{%- elsif media.media_type == 'model' -%}{{ 'products.product.media.load_model' | t: index: media_index }}{%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}{{ 'products.product.media.load_video' | t: index: media_index }}{%- endif -%}"
                      {% if media == product.selected_or_first_available_variant.featured_media
                        or product.selected_or_first_available_variant.featured_media == null
                        and forloop.index == 1
                      %}
                        aria-current="true"
                      {% endif %}
                      aria-controls="GalleryViewer-{{ section.id }}"
                      aria-describedby="Thumbnail-{{ section.id }}-{{ forloop.index }}"
                    >
                      <img
                        id="Thumbnail-{{ section.id }}-{{ forloop.index }}"
                        srcset="
                          {% if media.preview_image.width >= 59 %}{{ media.preview_image | image_url: width: 59 }} 59w,{% endif %}
                          {% if media.preview_image.width >= 118 %}{{ media.preview_image | image_url: width: 118 }} 118w,{% endif %}
                          {% if media.preview_image.width >= 84 %}{{ media.preview_image | image_url: width: 84 }} 84w,{% endif %}
                          {% if media.preview_image.width >= 168 %}{{ media.preview_image | image_url: width: 168 }} 168w,{% endif %}
                          {{ media.preview_image | image_url }} {{ media.preview_image.width }}w
                        "
                        src="{{ media | image_url: width: 84, height: 84 }}"
                        sizes="(min-width: 990px) 72px, 60px"
                        alt="{{ media.alt | escape }}"
                        height="200"
                        width="200"
                        loading="lazy"
                      >
                    </button>
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
            <button
              type="button"
              class="slider-button slider-button--next{% if media_count <= 3 %} small-hide{% endif %}{% if media_count <= 4 %} medium-hide large-up-hide{% endif %}"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="GalleryThumbnails-{{ section.id }}"
              data-step="3"
            >
              {% render 'icon-caret' %}
            </button>
          </slider-component>
        {%- endif -%}
      </media-gallery>
    </div>

    {%- comment -%} ========== RIGHT COLUMN: PRODUCT INFO ========== {%- endcomment -%}
    <div class="product-v2__info-wrapper grid__item">
      <div
        id="ProductInfo-{{ section.id }}"
        class="{% if section.settings.enable_sticky_info %}product-v2__info-container--sticky{% endif %}"
      >
        {%- assign product_form_id = 'product-form-' | append: section.id -%}
        {%- comment -%} .pdp-tile wrappers are invisible (display: contents) unless the desktop gallery layout is on: tile 1 = social proof to the buy button, tile 2 = shipping and payment lines, tile 3 = the info links {%- endcomment -%}
        <div class="pdp-tile pdp-tile--buy">

        {%- comment -%} 1. Social proof bar — switchable between Trustpilot stars and athlete social proof {%- endcomment -%}
        {%- if section.settings.social_proof_type == 'trustpilot' -%}
          {%- assign review_count = 5082 -%}
          {%- assign full_stars = 4 -%}
          {%- assign partial_star = full_stars | plus: 1 -%}
          {%- assign star_fraction = 50 -%}
          <div class="product-v2__reviews-bar">
            <div class="product-v2__stars">
              {%- for i in (1..5) -%}
                {%- if i <= full_stars -%}
                  <span class="product-v2__star-block product-v2__star-block--full">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#fff"/></svg>
                  </span>
                {%- elsif i == partial_star -%}
                  <span class="product-v2__star-block product-v2__star-block--partial">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <defs><linearGradient id="tp-grad-{{ section.id }}"><stop offset="{{ star_fraction }}%" stop-color="#00b67a"/><stop offset="{{ star_fraction }}%" stop-color="#dcdce6"/></linearGradient></defs>
                      <rect width="24" height="24" fill="url(#tp-grad-{{ section.id }})"/>
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#fff"/>
                    </svg>
                  </span>
                {%- else -%}
                  <span class="product-v2__star-block product-v2__star-block--empty">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#fff"/></svg>
                  </span>
                {%- endif -%}
              {%- endfor -%}
              <span class="product-v2__rating-text"><strong>4.5 / 5</strong> based on <em>{{ review_count }} real reviews</em></span>
            </div>
          </div>
        {%- elsif section.settings.social_proof_type == 'athletes' -%}
          {%- comment -%}
            Random athlete rotation per product.
            Featured athlete = product.id modulo 3 (0→athlete 1, 1→athlete 2, 2→athlete 3).
            Avatar order: two non-featured first, featured LAST (3rd/rightmost = matches name).
          {%- endcomment -%}
          {%- assign sp_seed = product.id | modulo: 3 -%}

          {%- if sp_seed == 0 -%}
            {%- assign sp_featured_name = section.settings.sp_athlete_1_name -%}
            {%- assign sp_featured_link = section.settings.sp_athlete_1_link -%}
            {%- assign sp_order = '2,3,1' | split: ',' -%}
          {%- elsif sp_seed == 1 -%}
            {%- assign sp_featured_name = section.settings.sp_athlete_2_name -%}
            {%- assign sp_featured_link = section.settings.sp_athlete_2_link -%}
            {%- assign sp_order = '1,3,2' | split: ',' -%}
          {%- else -%}
            {%- assign sp_featured_name = section.settings.sp_athlete_3_name -%}
            {%- assign sp_featured_link = section.settings.sp_athlete_3_link -%}
            {%- assign sp_order = '1,2,3' | split: ',' -%}
          {%- endif -%}

          <div class="product-v2__social-proof" style="background-color: {{ section.settings.sp_bg_color }};">
            <div class="product-v2__social-proof-inner">
              <div class="product-v2__sp-avatars">
                {%- for idx_str in sp_order -%}
                  {%- assign idx = idx_str | plus: 0 -%}
                  {%- if idx == 1 -%}
                    {%- assign av_img = section.settings.sp_avatar_1 -%}
                    {%- assign av_link = section.settings.sp_athlete_1_link -%}
                  {%- elsif idx == 2 -%}
                    {%- assign av_img = section.settings.sp_avatar_2 -%}
                    {%- assign av_link = section.settings.sp_athlete_2_link -%}
                  {%- else -%}
                    {%- assign av_img = section.settings.sp_avatar_3 -%}
                    {%- assign av_link = section.settings.sp_athlete_3_link -%}
                  {%- endif -%}
                  {%- comment -%} Fallback avatars when no image is set in theme editor {%- endcomment -%}
                  {%- if av_img == blank -%}
                    {%- if idx == 1 -%}
                      {%- assign av_fallback_url = 'Scherm_afbeelding_2026-03-21_om_23.30.36.png' | file_img_url: '80x80', crop: 'center' -%}
                    {%- elsif idx == 2 -%}
                      {%- assign av_fallback_url = 'Scherm_afbeelding_2026-03-21_om_23.31.03.png' | file_img_url: '80x80', crop: 'center' -%}
                    {%- else -%}
                      {%- assign av_fallback_url = 'Scherm_afbeelding_2026-03-21_om_23.31.47.png' | file_img_url: '80x80', crop: 'center' -%}
                    {%- endif -%}
                  {%- endif -%}
                  {%- if av_img != blank or av_fallback_url != blank -%}
                    {%- assign sp_pos_class = 'product-v2__sp-avatar--' | append: forloop.index -%}
                    <{% if av_link != blank %}a href="{{ av_link }}" target="_blank" rel="noopener"{% else %}div{% endif %} class="product-v2__sp-avatar {{ sp_pos_class }}">
                      {%- if av_img != blank -%}
                        <img src="{{ av_img | image_url: width: 80 }}" alt="" width="40" height="40" loading="lazy">
                      {%- else -%}
                        <img src="{{ av_fallback_url }}" alt="" width="40" height="40" loading="lazy">
                      {%- endif -%}
                    </{% if av_link != blank %}a{% else %}div{% endif %}>
                  {%- endif -%}
                  {%- assign av_fallback_url = nil -%}
                {%- endfor -%}
              </div>
              <p class="product-v2__sp-text" style="color: {{ section.settings.sp_text_color }};">
                {%- if sp_featured_link != blank -%}
                  <a href="{{ sp_featured_link }}" target="_blank" rel="noopener" class="product-v2__sp-name-link"><strong>{{ sp_featured_name }}</strong></a>
                {%- else -%}
                  <strong>{{ sp_featured_name }}</strong>
                {%- endif -%}
                {%- if section.settings.sp_verified_badge -%}
                  <span class="product-v2__sp-verified" aria-label="Verified">
                    <svg width="16" height="16" viewBox="0 0 40 40" fill="rgb(0, 149, 246)" xmlns="http://www.w3.org/2000/svg">
                      <path d="M19.998 3.094 14.638 0l-2.972 5.15H5.432v6.354L0 14.64 3.094 20 0 25.359l5.432 3.137v5.905h5.975L14.638 40l5.36-3.094L25.358 40l3.232-5.6h6.162v-6.01L40 25.359 36.905 20 40 14.641l-5.248-3.03v-6.46h-6.419L25.358 0l-5.36 3.094Zm7.415 11.225 2.254 2.287-11.43 11.5-6.835-6.93 2.244-2.258 4.587 4.581 9.18-9.18Z" fill-rule="evenodd"/>
                    </svg>
                  </span>
                {%- endif -%}
                &nbsp;{{ 'products.v2.social_proof_text_html' | t: count: section.settings.sp_follower_count, brand: section.settings.sp_brand_name }}
              </p>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} 2. Title {%- endcomment -%}
        <h1 class="product-v2__title">{{ product.title | escape }}</h1>

        {%- comment -%} 3. Subtitle {%- endcomment -%}
        {%- if product.metafields.descriptors.subtitle.value != blank -%}
          <p class="product-v2__subtitle">{{ product.metafields.descriptors.subtitle.value }}</p>
        {%- endif -%}

        {%- comment -%} 4. Price (€ symbol removed via JS) {%- endcomment -%}
        {%- comment -%} --has-sale: some variant is discounted; the gallery layout then keeps room for the old price and badge so nothing jumps between variants {%- endcomment -%}
        <div class="product-v2__price no-js-hidden{% if product.compare_at_price_max > product.price_min %} product-v2__price--has-sale{% endif %}" id="price-{{ section.id }}" role="status">
          {%- render 'price',
            product: product,
            use_variant: true,
            show_badges: false,
            price_class: 'price--large',
            save_badge: true
          -%}
        </div>
        <script>
          (function(){
            var _stripping = false;
            function stripEuro(root){
              if (_stripping) return;
              _stripping = true;
              /* the desktop gallery layout shows the price with its € sign, next to the title */
              var keepEuro = window.matchMedia('(min-width: 990px)').matches;
              root.querySelectorAll('.regular-text, .price-item, .real-price, .product-v2-sticky-bar__price').forEach(function(el){
                if (keepEuro && el.closest('.product-v2--gallery .product-v2__price')) return;
                el.childNodes.forEach(function(n){
                  if(n.nodeType===3) n.textContent = n.textContent.replace(/€\s*/g,'');
                });
              });
              _stripping = false;
            }
            /* Strip immediately for elements already in DOM */
            stripEuro(document);
            /* Re-run after full DOM is ready (sticky bar renders later) */
            document.addEventListener('DOMContentLoaded', function(){
              stripEuro(document);
              /* Observe price wrapper for variant changes — debounced to avoid loops */
              var _priceTimer = null;
              var priceWrap = document.getElementById('price-{{ section.id }}');
              if(priceWrap){
                new MutationObserver(function(){
                  clearTimeout(_priceTimer);
                  _priceTimer = setTimeout(function(){ stripEuro(priceWrap); }, 50);
                }).observe(priceWrap, {childList:true, subtree:true});
              }
              var stickyPrice = document.querySelector('.product-v2-sticky-bar__price');
              if(stickyPrice){
                new MutationObserver(function(){
                  clearTimeout(_priceTimer);
                  _priceTimer = setTimeout(function(){ stripEuro(stickyPrice.parentElement); }, 50);
                }).observe(stickyPrice, {childList:true, subtree:true});
              }
            });
          })();
        </script>
        <div>
          {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
          {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            {{ form | payment_terms }}
          {%- endform -%}
        </div>

        {%- comment -%} 5. Product benefits — metafields with theme editor fallback {%- endcomment -%}
        {%- liquid
          assign ben1 = product.metafields.custom.custom_benefit_1.value | default: product.metafields.custom.custom_benefit_1
          assign ben2 = product.metafields.custom.custom_benefit_2.value | default: product.metafields.custom.custom_benefit_2
          assign ben3 = product.metafields.custom.custom_benefit_3.value | default: product.metafields.custom.custom_benefit_3
          if ben1 == blank
            assign ben1 = 'products.v2.default_benefit_1' | t
          endif
          if ben2 == blank
            assign ben2 = 'products.v2.default_benefit_2' | t
          endif
          if ben3 == blank
            assign ben3 = 'products.v2.default_benefit_3' | t
          endif
          comment
            benefits 4 and 5 are optional: no fallback, shown only when filled in
          endcomment
          assign ben4 = product.metafields.custom.custom_benefit_4.value | default: product.metafields.custom.custom_benefit_4
          assign ben5 = product.metafields.custom.custom_benefit_5.value | default: product.metafields.custom.custom_benefit_5
        -%}
        {%- if ben1 != blank or ben2 != blank or ben3 != blank or ben4 != blank or ben5 != blank -%}
          <ul class="product-v2__benefits">
            {%- if ben1 != blank -%}
              {%- assign ben1_first = ben1 | slice: 0 | upcase -%}{%- assign ben1_rest = ben1 | slice: 1, 999 -%}{%- assign ben1_cap = ben1_first | append: ben1_rest -%}
              {%- unless ben1_cap contains '.' or ben1_cap contains '!' -%}{%- assign ben1_cap = ben1_cap | append: '.' -%}{%- endunless -%}
              <li class="product-v2__benefit">
                {% render 'icon-checkmark' %}
                <span>{{ ben1_cap }}</span>
              </li>
            {%- endif -%}
            {%- if ben2 != blank -%}
              {%- assign ben2_first = ben2 | slice: 0 | upcase -%}{%- assign ben2_rest = ben2 | slice: 1, 999 -%}{%- assign ben2_cap = ben2_first | append: ben2_rest -%}
              {%- unless ben2_cap contains '.' or ben2_cap contains '!' -%}{%- assign ben2_cap = ben2_cap | append: '.' -%}{%- endunless -%}
              <li class="product-v2__benefit">
                {% render 'icon-checkmark' %}
                <span>{{ ben2_cap }}</span>
              </li>
            {%- endif -%}
            {%- if ben3 != blank -%}
              {%- assign ben3_first = ben3 | slice: 0 | upcase -%}{%- assign ben3_rest = ben3 | slice: 1, 999 -%}{%- assign ben3_cap = ben3_first | append: ben3_rest -%}
              {%- unless ben3_cap contains '.' or ben3_cap contains '!' -%}{%- assign ben3_cap = ben3_cap | append: '.' -%}{%- endunless -%}
              <li class="product-v2__benefit">
                {% render 'icon-checkmark' %}
                <span>{{ ben3_cap }}</span>
              </li>
            {%- endif -%}
            {%- if ben4 != blank -%}
              {%- assign ben4_first = ben4 | slice: 0 | upcase -%}{%- assign ben4_rest = ben4 | slice: 1, 999 -%}{%- assign ben4_cap = ben4_first | append: ben4_rest -%}
              {%- unless ben4_cap contains '.' or ben4_cap contains '!' -%}{%- assign ben4_cap = ben4_cap | append: '.' -%}{%- endunless -%}
              <li class="product-v2__benefit">
                {% render 'icon-checkmark' %}
                <span>{{ ben4_cap }}</span>
              </li>
            {%- endif -%}
            {%- if ben5 != blank -%}
              {%- assign ben5_first = ben5 | slice: 0 | upcase -%}{%- assign ben5_rest = ben5 | slice: 1, 999 -%}{%- assign ben5_cap = ben5_first | append: ben5_rest -%}
              {%- unless ben5_cap contains '.' or ben5_cap contains '!' -%}{%- assign ben5_cap = ben5_cap | append: '.' -%}{%- endunless -%}
              <li class="product-v2__benefit">
                {% render 'icon-checkmark' %}
                <span>{{ ben5_cap }}</span>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- comment -%} 6. Sale banner {%- endcomment -%}
        {%- if section.settings.show_sale_banner and section.settings.sale_banner_text != blank -%}
          <div
            class="product-v2__sale-banner"
            style="background-color: {{ section.settings.sale_banner_bg_color }}; color: {{ section.settings.sale_banner_text_color }};"
          >
            {{ section.settings.sale_banner_text }}
          </div>
        {%- endif -%}

        {%- comment -%} 7. Blocks: variant picker, quantity, buy buttons, collapsible tabs, USPs, etc. {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                {%- if block.settings.picker_type == 'button' -%}
                  <variant-radios
                    class="no-js-hidden"
                    data-section="{{ section.id }}"
                    data-url="{{ product.url }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- comment -%} Render options in Shopify order (required for variant matching), use CSS order to show color first {%- endcomment -%}
                    {%- assign swatch_style = block.settings.color_swatch_style | default: 'colors' -%}
                    {%- for option in product.options_with_values -%}
                      {% assign option_name = option.name | handleize %}
                      {%- assign is_color = false -%}
                      {%- if option_name contains 'color' or option_name contains 'kleur' or option_name contains 'couleur' -%}
                        {%- assign is_color = true -%}
                      {%- endif -%}

                      {%- if option.values.size > 1 -%}
                        <fieldset class="js product-form__input product-form__input--pill {% if is_color %}color-input{% if swatch_style == 'images' %} color-input--thumbs{% endif %}{% else %}size-input{% endif %}">
                          <legend class="form__label">{{ option.name }}</legend>
                          {% if is_color %}<div class="color-input__track">{% endif %}
                          {%- for value in option.values -%}
                            {%- liquid
                              assign variant_hidden = true
                              for variant in product.variants
                                for opt in variant.options
                                  if opt == value
                                    unless variant.metafields.custom.disable == true
                                      assign variant_hidden = false
                                    endunless
                                  endif
                                endfor
                              endfor
                            -%}
                            <input
                              type="radio"
                              id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                              name="{{ option.name }}"
                              value="{{ value | escape }}"
                              form="{{ product_form_id }}"
                              {% if option.selected_value == value %}
                                checked
                              {% endif %}
                              {% if variant_hidden %}class="disabled"{% endif %}
                            >
                            <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" {% if variant_hidden %}class="hidden" style="display:none;"{% endif %}>
                              {% if is_color %}
                                {%- comment -%}
                                  Same swatch as the product cards: colour from
                                  snippets/color-swatch-hex (shop metafield
                                  custom.swatch_colors overrides), variant photo
                                  when the value is not a colour.
                                {%- endcomment -%}
                                {%- assign swatch_img = nil -%}
                                {%- for variant in product.variants -%}
                                  {%- if variant.options contains value and variant.featured_image -%}
                                    {%- assign swatch_img = variant.featured_image -%}
                                    {%- break -%}
                                  {%- endif -%}
                                {%- endfor -%}
                                {%- capture swatch_bg -%}{% render 'color-swatch-hex', name: value %}{%- endcapture -%}
                                {%- assign swatch_bg = swatch_bg | strip -%}
                                {%- if swatch_style == 'images' and swatch_img -%}
                                  {%- comment -%} "Product images" style: the variant's own photo as a 4:5 thumbnail {%- endcomment -%}
                                  <span class="color-thumb">
                                    <img src="{{ swatch_img | image_url: width: 200 }}" alt="{{ value | escape }}" width="80" height="100">
                                  </span>
                                {%- elsif swatch_bg != blank -%}
                                  <span class="color-dot color-dot--swatch" style="background: {{ swatch_bg }};"></span>
                                {%- else -%}
                                  {%- if swatch_img -%}
                                    <span class="color-dot color-dot--swatch color-dot--image">
                                      <img src="{{ swatch_img | image_url: width: 80 }}" alt="{{ value | escape }}" loading="lazy" width="40" height="40">
                                    </span>
                                  {%- else -%}
                                    <span class="color-dot color-dot--swatch"></span>
                                  {%- endif -%}
                                {%- endif -%}
                                <span class="color-input__name">{{ value | escape }}</span>
                              {% else %}
                                <span class="size-label-text">{{ value | escape }}</span>
                              {% endif %}
                            </label>
                          {%- endfor -%}
                          {% if is_color %}</div>{% endif %}
                          {%- if is_color -%}
                            <span class="color-input__selected-name" data-label="{{ option.name | escape }}">{{ option.selected_value | escape }}</span>
                          {%- endif -%}
                        </fieldset>
                        {%- comment -%} Size guide link moved below ATC button {%- endcomment -%}
                      {%- else -%}
                        {%- comment -%} Single-value option: hidden fieldset for JS variant matching {%- endcomment -%}
                        <fieldset class="js product-form__input{% if is_color %} color-input{% endif %}" style="display:none !important;">
                          <input
                            type="radio"
                            name="{{ option.name }}"
                            value="{{ option.values.first | escape }}"
                            form="{{ product_form_id }}"
                            checked
                          >
                        </fieldset>
                        {%- unless is_color -%}
                          {%- comment -%} Visible read-only tile — div not fieldset so updateOptions() skips it {%- endcomment -%}
                          <div class="product-form__input product-form__input--pill size-input size-input--single">
                            <div class="size-pill-single">
                              <span class="size-label-text">{{ option.values.first | escape }}</span>
                            </div>
                          </div>
                        {%- endunless -%}
                      {%- endif -%}
                    {%- endfor -%}
                    <script type="application/json">
                      {{ product.variants | json }}
                    </script>
                    <script type="application/json" class="tags">
                      {{ product.tags | json }}
                    </script>
                    <div class="hidden product-metafields">
                      {% for variant in product.variants %}
                        <span data-variant-id="{{ variant.id }}" data-disabled="{{ variant.metafields.custom.disable }}"></span>
                      {% endfor %}
                    </div>
                    <script>
                      (function(){
                        function syncHiddenVariants() {
                          document.querySelectorAll('.product-v2 .product-form__input--pill').forEach(function(fieldset) {
                            fieldset.querySelectorAll('label').forEach(function(label) {
                              var radio = label.previousElementSibling;
                              if (!radio || radio.type !== 'radio') return;
                              if (label.classList.contains('hidden')) {
                                label.style.display = 'none';
                              }
                            });
                          });
                        }

                        function initColorPicker() {
                          var fieldset = document.querySelector('.product-v2 .color-input');
                          if (!fieldset) return;
                          var nameEl = fieldset.querySelector('.color-input__selected-name');

                          fieldset.querySelectorAll('input[type="radio"]').forEach(function(radio) {
                            radio.addEventListener('change', function() {
                              if (nameEl) {
                                var label = this.nextElementSibling;
                                var nameSpan = label ? label.querySelector('.color-input__name') : null;
                                if (nameSpan) nameEl.textContent = nameSpan.textContent;
                              }
                              filterSizesByColor();
                            });
                          });

                          /* Initial filter on load */
                          filterSizesByColor();
                        }

                        function filterSizesByColor() {
                          var variants = {{ product.variants | json }};
                          var options = {{ product.options_with_values | json }};

                          /* Find the color option position (1-indexed) */
                          var colorPos = -1;
                          var sizePos = -1;
                          for (var i = 0; i < options.length; i++) {
                            var name = options[i].name.toLowerCase().replace(/:$/, '');
                            if (name === 'color' || name === 'kleur' || name === 'couleur') {
                              colorPos = i;
                            } else if (name === 'size' || name === 'maat') {
                              sizePos = i;
                            }
                          }
                          if (colorPos === -1 || sizePos === -1) return;

                          /* Get selected color */
                          var colorFieldset = document.querySelector('.product-v2 .color-input');
                          if (!colorFieldset) return;
                          var checkedColor = colorFieldset.querySelector('input[type="radio"]:checked');
                          if (!checkedColor) return;
                          var selectedColor = checkedColor.value;

                          /* Find sizes available for this color */
                          var availableSizes = {};
                          for (var v = 0; v < variants.length; v++) {
                            var variant = variants[v];
                            if (variant.options[colorPos] === selectedColor) {
                              availableSizes[variant.options[sizePos]] = true;
                            }
                          }

                          /* Show/hide size radios */
                          var sizeFieldset = document.querySelector('.product-v2 .size-input');
                          if (!sizeFieldset) return;
                          var needsReselect = false;
                          sizeFieldset.querySelectorAll('input[type="radio"]').forEach(function(radio) {
                            var label = radio.nextElementSibling;
                            if (!label) return;
                            if (availableSizes[radio.value]) {
                              radio.style.display = '';
                              label.style.display = '';
                            } else {
                              radio.style.display = 'none';
                              label.style.display = 'none';
                              if (radio.checked) needsReselect = true;
                            }
                          });

                          /* If the currently selected size is no longer visible, select the first available */
                          if (needsReselect) {
                            var firstVisible = sizeFieldset.querySelector('input[type="radio"]:not([style*="display: none"])');
                            if (firstVisible) {
                              firstVisible.checked = true;
                              firstVisible.dispatchEvent(new Event('change', { bubbles: true }));
                            }
                          }
                        }

                        function updateMediaByAlt(targetAlt) {
                          if (!targetAlt) return;

                          /* Main gallery slides */
                          var slider = document.getElementById('Slider-Gallery-{{ section.id }}');
                          if (slider) {
                            slider.querySelectorAll('li[data-variant-alt]').forEach(function(item) {
                              var itemAlt = item.getAttribute('data-variant-alt') || '';
                              if (!itemAlt || itemAlt === targetAlt || item.hasAttribute('data-media-all')) {
                                item.style.removeProperty('display');
                              } else {
                                item.style.display = 'none';
                              }
                            });
                          }

                          /* Thumbnail strip */
                          var thumbs = document.getElementById('Slider-Thumbnails-{{ section.id }}');
                          if (thumbs) {
                            thumbs.querySelectorAll('li[data-variant-alt]').forEach(function(item) {
                              var itemAlt = item.getAttribute('data-variant-alt') || '';
                              if (!itemAlt || itemAlt === targetAlt || item.hasAttribute('data-media-all')) {
                                item.style.removeProperty('display');
                              } else {
                                item.style.display = 'none';
                              }
                            });
                          }
                        }

                        function initMediaSwitching() {
                          var variantRadios = document.querySelector('.product-v2 variant-radios');
                          if (!variantRadios) return;

                          variantRadios.addEventListener('change', function() {
                            /* setTimeout(0) ensures onVariantChange() has finished setting currentVariant */
                            setTimeout(function() {
                              var variant = variantRadios.currentVariant;
                              if (variant && variant.featured_media) {
                                var slideId = 'Slide-{{ section.id }}-' + variant.featured_media.id;
                                var slide = document.getElementById(slideId);
                                var targetAlt = slide ? slide.getAttribute('data-variant-alt') : variant.featured_media.alt;
                                updateMediaByAlt(targetAlt);
                              }
                            }, 0);
                          });
                        }

                        function init() {
                          initColorPicker();
                          syncHiddenVariants();
                          initMediaSwitching();
                          /* Re-sync after global.js checkAvaiable runs (fires ~500ms after page load) */
                          setTimeout(syncHiddenVariants, 600);
                          setTimeout(syncHiddenVariants, 1200);

                          /* Also observe for dynamic class changes */
                          var container = document.querySelector('.product-v2 variant-radios');
                          if (container) {
                            new MutationObserver(syncHiddenVariants).observe(container, { attributes: true, attributeFilter: ['class'], subtree: true });
                          }
                        }

                        if (document.readyState === 'loading') {
                          document.addEventListener('DOMContentLoaded', init);
                        } else {
                          init();
                        }
                      })();
                    </script>
                  </variant-radios>
