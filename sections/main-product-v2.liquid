            {%- when 'shipping_info' -%}
              </div><div class="pdp-tile pdp-tile--trust">
              {%- comment -%}
                Ship date logic (v2):
                - Before 15:00 CET/CEST on a working day → shipped today
                - After 15:00 or on a weekend → shipped next working day
                - Automatically handles CET ↔ CEST via Intl timezone

                The secure_checkout block is also rendered here (after ship date, before USP accordions)
                so it always appears in the right visual position regardless of block order.
              {%- endcomment -%}
              {%- liquid
                comment
                  Free-shipping threshold for the market the visitor shops in:
                  the cart-bar setting for EUR markets, its own setting for USD.
                  Country and currency are exposed for the script and for
                  debugging (data-geo is filled from the geolocation cookie).
                endcomment
                assign ship_threshold = settings.free_shipping
                if cart.currency.iso_code == 'USD'
                  assign ship_threshold = settings.free_shipping_usd | default: 100
                endif
              -%}
              <script type="application/json" id="ShipPrices-{{ section.id }}">{ {%- for v in product.variants -%}"{{ v.id }}":{{ v.price }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }</script>
              <div id="shipment-message-v2" class="shipment-container !m-0 product-v2__trust-row product-v2__shipping-row" data-threshold="{{ ship_threshold }}" data-currency="{{ cart.currency.iso_code }}" data-country="{{ localization.country.iso_code }}" data-market="{{ localization.market.handle }}" {{ block.shopify_attributes }}>
                <svg class="product-v2__shipping-icon" width="39" height="24" viewBox="0 0 39 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="0.5" y="0.5" width="38" height="23" rx="3.5" fill="#FFFFFF" stroke="#E0E0E0"/>
                  <g clip-path="url(#clip_ship_{{ section.id }})">
                    <path d="M15.2539 16.2399C17.1739 18.1666 20.1406 18.5599 22.4939 17.1999C24.8472 15.8466 25.9939 13.0732 25.2939 10.4532C24.5939 7.82658 22.2139 6.00659 19.5006 6.00659" stroke="#0F1A2B" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M13.5 12H13.5067" stroke="#0F1A2B" stroke-linecap="round"/>
                    <path d="M17.168 6.33325H17.1746" stroke="#0F1A2B" stroke-linecap="round"/>
                    <path d="M13.9531 14.2532H13.9598" stroke="#0F1A2B" stroke-linecap="round"/>
                    <path d="M13.9531 9.68652H13.9598" stroke="#0F1A2B" stroke-linecap="round"/>
                    <path d="M15.2461 7.74658H15.2528" stroke="#0F1A2B" stroke-linecap="round"/>
                    <path d="M19.0469 9.6001V12.3001L20.8535 14.1001" stroke="#0F1A2B" stroke-linecap="round" stroke-linejoin="round"/>
                  </g>
                  <defs>
                    <clipPath id="clip_ship_{{ section.id }}">
                      <rect width="16" height="16" fill="white" transform="translate(11.5 4)"/>
                    </clipPath>
                  </defs>
                </svg>
                <p class="shipping-text" id="ship-date-text" style="display:none;"></p>
              </div>
              <script>
                (function() {
                  var isNl = window.location.pathname.indexOf('/nl') !== -1;
                  var cutoffHour = 15;

                  function getNLTime() {
                    var opts = { timeZone: 'Europe/Amsterdam', hour: 'numeric', minute: 'numeric', hour12: false };
                    var parts = new Date().toLocaleString('en-GB', opts).split(':');
                    return { hour: parseInt(parts[0], 10), minute: parseInt(parts[1], 10) };
                  }

                  function getNLDay() {
                    var dayStr = new Date().toLocaleString('en-GB', { timeZone: 'Europe/Amsterdam', weekday: 'short' });
                    return ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].indexOf(dayStr);
                  }

                  function formatDate(date) {
                    var dEN = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
                    var dNL = ['Zondag','Maandag','Dinsdag','Woensdag','Donderdag','Vrijdag','Zaterdag'];
                    var mEN = ['January','February','March','April','May','June','July','August','September','October','November','December'];
                    var mNL = ['Januari','Februari','Maart','April','Mei','Juni','Juli','Augustus','September','Oktober','November','December'];
                    var day = date.getDate();
                    var s = 'th';
                    if (day % 10 === 1 && day !== 11) s = 'st';
                    else if (day % 10 === 2 && day !== 12) s = 'nd';
                    else if (day % 10 === 3 && day !== 13) s = 'rd';
                    if (isNl) return dNL[date.getDay()] + ', ' + day + ' ' + mNL[date.getMonth()];
                    return dEN[date.getDay()] + ', ' + day + s + ' of ' + mEN[date.getMonth()];
                  }

                  function getNextWorkday() {
                    var d = new Date();
                    d.setDate(d.getDate() + 1);
                    while (d.getDay() === 0 || d.getDay() === 6) d.setDate(d.getDate() + 1);
                    return d;
                  }

                  function getShipInfo() {
                    var t = getNLTime();
                    var nlDay = getNLDay();
                    var isWorkday = nlDay >= 1 && nlDay <= 5;
                    var beforeCutoff = t.hour < cutoffHour;

                    if (isWorkday && beforeCutoff) {
                      var minsLeft = (cutoffHour - t.hour - 1) * 60 + (60 - t.minute);
                      var h = Math.floor(minsLeft / 60);
                      var m = minsLeft % 60;
                      return { countdown: true, hours: h, minutes: m };
                    }
                    return { countdown: false, date: getNextWorkday() };
                  }

                  /* ---- free shipping: does the current selection reach the threshold? ---- */
                  var box = document.getElementById('shipment-message-v2');
                  var threshold = box ? parseFloat(box.getAttribute('data-threshold')) : NaN;
                  var prices = {};
                  try { prices = JSON.parse((document.getElementById('ShipPrices-{{ section.id }}') || {}).textContent || '{}'); } catch (e) {}
                  try {
                    var geo = JSON.parse(localStorage.getItem('geolocation') || 'null');
                    if (geo && box) box.setAttribute('data-geo', geo.country_code || '');
                  } catch (e) {}

                  function parseMoney(str) {
                    var s = (str || '').replace(/[^\d.,]/g, '');
                    if (!s) return null;
                    var dec = Math.max(s.lastIndexOf(','), s.lastIndexOf('.'));
                    if (dec > -1 && s.length - dec - 1 === 2) {
                      return parseFloat(s.slice(0, dec).replace(/[.,]/g, '') + '.' + s.slice(dec + 1));
                    }
                    return parseFloat(s.replace(/[.,]/g, ''));
                  }
                  function selectedTotal() {
                    /* bundle widget (AOV): the selected offer's total wins */
                    var offer = document.querySelector('.Avada-Volume__Item--Selected .AOV-Offer__DiscountPrice');
                    if (offer) {
                      var v = parseMoney(offer.textContent);
                      if (v !== null && !isNaN(v)) return v;
                    }
                    var form = document.querySelector('.product-v2 form[action*="/cart/add"]');
                    var idInput = form && form.querySelector('input[name="id"]');
                    var cents = idInput ? prices[idInput.value] : null;
                    var qtyEl = document.querySelector('.product-v2 input[name="quantity"]');
                    var qty = qtyEl ? (parseInt(qtyEl.value, 10) || 1) : 1;
                    return cents ? (cents / 100) * qty : 0;
                  }
                  function freeShipping() {
                    if (!threshold || isNaN(threshold)) return false;
                    var total = selectedTotal();
                    if (box) box.setAttribute('data-selected-total', total.toFixed(2));
                    return total >= threshold;
                  }

                  function render() {
                    var el = document.getElementById('ship-date-text');
                    if (!el) return;
                    var info = getShipInfo();
                    var free = freeShipping();
                    if (box) box.classList.toggle('is-free-shipping', free);

                    if (info.countdown) {
                      var timeStr = info.hours > 0
                        ? '<span class="ship-countdown">' + info.hours + 'h ' + info.minutes + 'm</span>'
                        : '<span class="ship-countdown">' + info.minutes + 'm</span>';
                      if (isNl) {
                        el.innerHTML = free
                          ? 'Bestel binnen ' + timeStr + ', <span class="ship-free">gratis verzending vandaag</span>'
                          : 'Bestel binnen ' + timeStr + ', wordt <span class="ship-date">vandaag</span> verzonden';
                      } else {
                        el.innerHTML = free
                          ? 'Order within ' + timeStr + ', <span class="ship-free">free shipping today</span>'
                          : 'Order within ' + timeStr + ', ships <span class="ship-date">today</span>';
                      }
                    } else {
                      var f = formatDate(info.date);
                      if (isNl) {
                        el.innerHTML = free
                          ? 'Voor <strong>15u00</strong> besteld, <span class="ship-free">gratis verzonden</span> op <span class="ship-date">' + f + '</span>'
                          : 'Voor <strong>15u00</strong> besteld, wordt verzonden op <span class="ship-date">' + f + '</span>';
                      } else {
                        el.innerHTML = free
                          ? 'Ordered before <strong>15hr00</strong>, <span class="ship-free">free shipping</span> on <span class="ship-date">' + f + '</span>'
                          : 'Ordered before <strong>15hr00</strong>, ships on <span class="ship-date">' + f + '</span>';
                      }
                    }
                    el.style.display = '';
                  }

                  var renderTimer = null;
                  function scheduleRender() {
                    clearTimeout(renderTimer);
                    renderTimer = setTimeout(render, 120);
                  }

                  render();
                  /* re-evaluate when the variant, the quantity or the bundle offer changes */
                  document.addEventListener('change', scheduleRender, true);
                  document.addEventListener('input', function (e) {
                    if (e.target && e.target.name === 'quantity') scheduleRender();
                  }, true);
                  document.addEventListener('click', function (e) {
                    if (e.target && e.target.closest && e.target.closest('.Avada-Volume__Item, .Avada-VolumeItem__Container')) scheduleRender();
                  }, true);
                  new MutationObserver(function (muts) {
                    for (var i = 0; i < muts.length; i++) {
                      var t = muts[i].target;
                      if (t && t.closest && (t.closest('.Avada-VolumeItem__Container') || (t.matches && t.matches('input[name="id"]')))) { scheduleRender(); return; }
                    }
                  }).observe(document.body, { attributes: true, attributeFilter: ['class', 'value'], childList: true, subtree: true });
                  // Update countdown every 60s (only ticks when there's a countdown)
                  setInterval(function() {
                    var info = getShipInfo();
                    if (info.countdown) render();
                  }, 60000);
                })();
              </script>

