{%- comment -%}
  Phone gallery slider. Same touch model as Swiper's defaults (the slider
  on cloudpillo.com): the photo row follows the finger 1:1 through a
  transform, and on release it glides 300ms to a photo:
  - a quick swipe (under 300ms, more than 5px) always goes one photo on;
  - a slow drag goes on once it is past half a photo, else it returns;
  - never more than one photo per swipe; rubber-band at both ends;
  - a swipe steeper than 45 degrees scrolls the page instead.
  Thumbnail taps and variant changes (media-gallery.js sets .is-active)
  glide the row the same way; after a swipe the photo in view is set
  through media-gallery.setActiveMedia so thumbnails and benefit tags follow.
{%- endcomment -%}
<script>
  (function () {
    var mq = window.matchMedia('(max-width: 989px)');
    var section = document.getElementById('MainProduct-{{ section.id }}');
    if (!section) return;
    var list = section.querySelector('.product__media-list');
    var gallery = section.querySelector('media-gallery');
    if (!list || !gallery) return;

    var SPEED = 300, THRESHOLD = 5, LONG_MS = 300, LONG_RATIO = 0.5, RESISTANCE = 0.85;
    var index = 0, translate = 0, drag = null, selfChange = false;

    function items() {
      return Array.prototype.filter.call(list.querySelectorAll('.product__media-item'), function (li) {
        return li.style.display !== 'none';
      });
    }
    function width() { return list.clientWidth || 1; }
    function setTranslate(x, ms) {
      translate = x;
      list.style.transitionDuration = (ms || 0) + 'ms';
      list.style.transform = 'translate3d(' + x + 'px, 0, 0)';
    }
    function activeIndex() {
      var i = items().findIndex(function (li) { return li.classList.contains('is-active'); });
      return i < 0 ? 0 : i;
    }
    function slideTo(i, ms) {
      var all = items();
      index = Math.max(0, Math.min(i, all.length - 1));
      setTranslate(-index * width(), ms);
      var target = all[index];
      if (target && !target.classList.contains('is-active')) {
        selfChange = true;
        gallery.setActiveMedia(target.dataset.mediaId, false);
        selfChange = false;
      }
      centerThumb(ms);
    }
    /* the selected thumbnail sits in the middle of the strip (as far as the
       ends allow), so the next and previous photos are visible beside it */
    function centerThumb(ms) {
      var strip = section.querySelector('.thumbnail-list');
      var current = strip && strip.querySelector('button[aria-current="true"]');
      var li = current && current.closest('.thumbnail-list__item');
      if (!li) return;
      var left = li.offsetLeft - (strip.clientWidth - li.offsetWidth) / 2;
      left = Math.max(0, Math.min(left, strip.scrollWidth - strip.clientWidth));
      strip.scrollTo({ left: left, behavior: ms ? 'smooth' : 'auto' });
    }
    function sync(ms) {
      if (!mq.matches) {
        /* the desktop gallery layout has its own slider (below) */
        if (!section.querySelector('.product-v2--gallery')) {
          list.style.removeProperty('transform');
          list.style.removeProperty('transition-duration');
        }
        return;
      }
      list.scrollLeft = 0;
      slideTo(activeIndex(), ms);
    }

    /* thumbnail tap / variant change / variant photo filter -> the row follows */
    new MutationObserver(function (records) {
      if (selfChange || drag) return;
      var filtered = records.some(function (r) { return r.attributeName === 'style' && r.target !== list; });
      var active = records.some(function (r) { return r.attributeName === 'class'; });
      if (filtered) sync(0); else if (active && activeIndex() !== index) sync(SPEED);
    }).observe(list, { attributes: true, attributeFilter: ['class', 'style'], subtree: true });

    function point(e) {
      var t = e.touches ? e.touches[0] : e;
      return t ? { x: t.clientX, y: t.clientY } : null;
    }
    function start(e) {
      if (!mq.matches || (e.touches && e.touches.length !== 1)) { drag = null; return; }
      var p = point(e);
      /* pick the row up where it is, also in the middle of a glide */
      var live = new DOMMatrixReadOnly(getComputedStyle(list).transform).m41;
      setTranslate(live, 0);
      drag = { x: p.x, y: p.y, from: live, time: Date.now(), moving: false, scrolling: null, dx: 0 };
    }
    function move(e) {
      if (!drag) return;
      if (e.touches && e.touches.length !== 1) return;
      var p = point(e);
      var dx = p.x - drag.x, dy = p.y - drag.y;
      if (drag.scrolling === null) {
        if (Math.abs(dx) < THRESHOLD && Math.abs(dy) < THRESHOLD) return;
        /* steeper than 45 degrees: this is a page scroll */
        drag.scrolling = Math.atan2(Math.abs(dy), Math.abs(dx)) * 180 / Math.PI > 45;
        /* the first 5px are not part of the drag, as in Swiper */
        drag.x += dx > 0 ? THRESHOLD : -THRESHOLD;
        dx = p.x - drag.x;
      }
      if (drag.scrolling) return;
      drag.moving = true;
      drag.dx = dx;
      var min = 0, max = -(items().length - 1) * width();
      var x = drag.from + dx;
      if (x > min) x = min - 1 + Math.pow(-min + drag.from + dx, RESISTANCE);
      else if (x < max) x = max + 1 - Math.pow(max - drag.from - dx, RESISTANCE);
      setTranslate(x, 0);
      if (e.cancelable && !e.touches) e.preventDefault();
    }
    function end() {
      if (!drag) return;
      var d = drag;
      drag = null;
      if (!d.moving) { slideTo(index, SPEED); return; }
      var w = width(), count = items().length;
      var pos = Math.max(0, Math.min(-translate, (count - 1) * w));
      var stop = Math.min(Math.floor(pos / w), count - 1);
      var ratio = (pos - stop * w) / w;
      var next = d.dx < 0;
      var target;
      if (Date.now() - d.time > LONG_MS) {
        target = next ? (ratio >= LONG_RATIO ? stop + 1 : stop) : (ratio > 1 - LONG_RATIO ? stop + 1 : stop);
      } else {
        target = next ? stop + 1 : stop;
      }
      /* never more than one photo away from where the swipe began */
      target = Math.max(index - 1, Math.min(target, index + 1));
      suppressClick = true;
      setTimeout(function () { suppressClick = false; }, 350);
      slideTo(target, SPEED);
    }

    list.addEventListener('touchstart', start, { passive: true });
    list.addEventListener('touchmove', move, { passive: true });
    list.addEventListener('touchend', end, { passive: true });
    list.addEventListener('touchcancel', end, { passive: true });
    /* mouse drag in a narrow desktop window */
    list.addEventListener('mousedown', function (e) { if (e.button === 0) start(e); });
    window.addEventListener('mousemove', move);
    window.addEventListener('mouseup', end);
    list.addEventListener('dragstart', function (e) { if (mq.matches) e.preventDefault(); });

    /* a drag is not a tap on the photo */
    var suppressClick = false;
    list.addEventListener('click', function (e) {
      if (suppressClick) { e.preventDefault(); e.stopPropagation(); }
    }, true);

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () { sync(0); }, 60);
    });
    mq.addEventListener && mq.addEventListener('change', function () { sync(0); });
    window.addEventListener('load', function () { sync(0); });
    sync(0);
  })();
</script>

{%- comment -%}
  Product videos in the gallery play in place (muted, looping, no
  controls). A video plays while at least half of it is on screen and
  pauses otherwise (other photo in the phone slider, scrolled away); the
  theme pauses all media on a photo or variant change, so a visible video
  is started again.
{%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('MainProduct-{{ section.id }}');
    if (!section || !('IntersectionObserver' in window)) return;
    var videos = section.querySelectorAll('video.pdp-inline-video');
    if (!videos.length) return;
    function play(v) {
      v.muted = true;
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var v = entry.target;
        v._onScreen = entry.isIntersecting && entry.intersectionRatio >= 0.5;
        if (v._onScreen) play(v); else v.pause();
      });
    }, { threshold: [0, 0.5, 1] });
    Array.prototype.forEach.call(videos, function (v) {
      v.muted = true;
      v.setAttribute('playsinline', '');
      v.removeAttribute('controls');
      v.addEventListener('pause', function () {
        if (v._onScreen) requestAnimationFrame(function () { if (v._onScreen) play(v); });
      });
      io.observe(v);
    });
  })();
</script>

{%- comment -%}
  The shipping and secure-checkout lines stay on one line on every
  screen. The text is scaled down from 14px until it fits the column
  (never below 9px; below that it wraps again). Re-runs on resize and when the
  shipping text is filled in.
{%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('MainProduct-{{ section.id }}');
    if (!section) return;
    var MAX = 14, MIN = 9;

    function textEl(row) {
      var els = row.querySelectorAll('.shipping-text, :scope > span');
      for (var i = 0; i < els.length; i++) {
        if (els[i].offsetParent !== null && els[i].textContent.trim()) return els[i];
      }
      return null;
    }

    function fit() {
      section.querySelectorAll('.product-v2__trust-row').forEach(function (row) {
        var el = textEl(row);
        if (!el) return;
        /* our own style writes re-trigger the observer: skip when nothing changed */
        var key = el.textContent + '|' + row.clientWidth;
        if (row._fitKey === key) return;
        row._fitKey = key;
        el.style.removeProperty('font-size');
        row.classList.add('is-one-line');
        var size = MAX;
        el.style.setProperty('font-size', size + 'px', 'important');
        while (el.scrollWidth > el.clientWidth + 1 && size > MIN) {
          size -= 0.5;
          el.style.setProperty('font-size', size + 'px', 'important');
        }
        if (el.scrollWidth > el.clientWidth + 1) {
          row.classList.remove('is-one-line');
          el.style.removeProperty('font-size');
        }
      });
    }

    var timer;
    function schedule() { clearTimeout(timer); timer = setTimeout(fit, 60); }
    window.addEventListener('resize', schedule);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    var ship = section.querySelector('.product-v2__shipping-row');
    if (ship && window.MutationObserver) {
      new MutationObserver(schedule).observe(ship, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ['style'] });
    }
    fit();
  })();
</script>

{%- comment -%}
  Desktop gallery layout (experiment, .product-v2--gallery, 990px and up).
  Modelled on representclo.com: the photo strip is pinned at full window
  height with two photos side by side and is moved sideways by dragging
  (Swiper's defaults: follows the pointer, 300ms glide, a quick flick or a
  drag past a quarter photo moves on), by a sideways trackpad swipe, or by
  the thumbnail rail on the left (a tap makes that photo the left one). The
  buy box scrolls over the pinned photos; the page moves on after it.
  The info links open and close with a 200ms height glide and a plus that
  turns into a minus (as on emestudios.com).
{%- endcomment -%}
<script>
  (function () {
    var mq = window.matchMedia('(min-width: 990px)');
    var section = document.getElementById('MainProduct-{{ section.id }}');
    if (!section) return;
    var root = section.querySelector('.product-v2');
    var list = section.querySelector('.product__media-list');
    var gallery = section.querySelector('media-gallery');
    if (!root || !list || !gallery) return;
    function on() { return mq.matches && root.classList.contains('product-v2--gallery'); }

    var SPEED = 300, THRESHOLD = 5, LONG_MS = 300, LONG_RATIO = 0.25, RESISTANCE = 0.85, PER_VIEW = 2;
    var index = 0, translate = 0, drag = null, selfChange = false, suppressClick = false;

    /* Photo order in this layout: the photos were sorted for the classic
       page. Here photos 3/4 and 7/8 (and 9/10, ...) swap places, so an
       overview and a close-up alternate; photos 5/6 stay as they are.
       The order is only visual (data-pdp-order + CSS order); the DOM and
       the classic and phone pages keep the admin order. */
    function domItems() {
      return Array.prototype.filter.call(list.querySelectorAll('.product__media-item:not(.pdp-clone)'), function (li) {
        return li.style.display !== 'none';
      });
    }
    function items() {
      var all = domItems();
      for (var i = 2; i + 1 < all.length; i += 2) {
        if (i === 4) continue; /* photos 5 and 6 keep their order */
        var t = all[i]; all[i] = all[i + 1]; all[i + 1] = t;
      }
      return all;
    }
    function setOrder(el, value) {
      if (value === null) { if (el.hasAttribute('data-pdp-order')) el.removeAttribute('data-pdp-order'); return; }
      if (el.getAttribute('data-pdp-order') !== String(value)) el.setAttribute('data-pdp-order', value);
    }
    function applyOrder() {
      var thumbs = section.querySelectorAll('.thumbnail-list__item');
      if (!on()) {
        list.querySelectorAll('[data-pdp-order]').forEach(function (el) { setOrder(el, null); });
        thumbs.forEach(function (el) { setOrder(el, null); });
        return;
      }
      var all = items();
      list.querySelectorAll('.product__media-item:not(.pdp-clone)').forEach(function (li) {
        var pos = all.indexOf(li);
        setOrder(li, pos < 0 ? null : pos);
      });
      thumbs.forEach(function (th) {
        var pos = all.findIndex(function (li) { return li.dataset.mediaId === th.dataset.target; });
        setOrder(th, pos < 0 ? null : pos);
      });
    }
    /* a copy of the first photo closes the strip, so the last photo has the
       first one beside it instead of an empty half */
    function closeStrip() {
      var old = list.querySelector('.pdp-clone');
      var all = on() ? items() : [];
      var first = all[0];
      if (!first || all.length < 2) { if (old) old.remove(); return; }
      if (old && old._source === first && old.style.display !== 'none' && old === list.lastElementChild) return;
      if (old) old.remove();
      var clone = first.cloneNode(true);
      clone._source = first;
      clone.classList.add('pdp-clone');
      clone.classList.remove('is-active');
      clone.removeAttribute('id');
      clone.removeAttribute('data-media-id');
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('data-pdp-order', '99');
      clone.querySelectorAll('[id]').forEach(function (el) { el.removeAttribute('id'); });
      clone.querySelectorAll('button, a, video').forEach(function (el) { el.setAttribute('tabindex', '-1'); });
      list.appendChild(clone);
    }
    function slideWidth() { return (list.clientWidth || 1) / PER_VIEW; }
    /* every photo can be the left one; the last then has no neighbour on the right */
    function maxIndex() { return Math.max(0, items().length - 1); }
    function setTranslate(x, ms) {
      translate = x;
      list.style.transitionDuration = (ms || 0) + 'ms';
      list.style.transform = 'translate3d(' + x + 'px, 0, 0)';
    }
    function activeIndex() {
      var i = items().findIndex(function (li) { return li.classList.contains('is-active'); });
      return i < 0 ? 0 : i;
    }

    /* thumbnail rail: keep the selected thumbnail in view */
    var strip = section.querySelector('.thumbnail-list');
    function showThumb() {
      var current = strip && strip.querySelector('button[aria-current="true"]');
      var li = current && current.closest('.thumbnail-list__item');
      var rail = strip && strip.parentElement;
      if (li && rail && rail.scrollHeight > rail.clientHeight) {
        rail.scrollTo({ top: li.offsetTop - (rail.clientHeight - li.offsetHeight) / 2, behavior: 'smooth' });
      }
    }

    function slideTo(i, ms, setActive) {
      var all = items();
      index = Math.max(0, Math.min(i, maxIndex()));
      setTranslate(-index * slideWidth(), ms);
      if (setActive && all[index] && !all[index].classList.contains('is-active')) {
        selfChange = true;
        gallery.setActiveMedia(all[index].dataset.mediaId, false);
        selfChange = false;
      }
      showThumb();
    }
    function sync(ms) {
      applyOrder();
      closeStrip();
      if (!on()) {
        if (mq.matches) {
          list.style.removeProperty('transform');
          list.style.removeProperty('transition-duration');
        }
        return;
      }
      /* the selected photo becomes the left photo */
      slideTo(activeIndex(), ms, false);
    }

    /* Choosing another size keeps the photo that was selected (the theme
       jumps back to the variant's first photo); another colour shows that
       colour's first photo as before. */
    var keep = null;
    section.addEventListener('change', function (e) {
      if (!on() || !e.target.matches || !e.target.matches('variant-radios input[type="radio"]')) return;
      if (e.target.closest('.color-input')) { keep = null; return; }
      var active = items()[activeIndex()];
      keep = active ? { id: active.dataset.mediaId, until: Date.now() + 1500 } : null;
    }, true);
    function restoreKept() {
      if (!keep || Date.now() > keep.until) { keep = null; return false; }
      var li = items().find(function (x) { return x.dataset.mediaId === keep.id; });
      if (!li) return false;
      if (!li.classList.contains('is-active')) {
        selfChange = true;
        gallery.setActiveMedia(keep.id, false);
        selfChange = false;
      }
      applyOrder();
      closeStrip();
      slideTo(items().indexOf(li), 0, false);
      return true;
    }

    new MutationObserver(function (records) {
      if (selfChange || drag || !on()) return;
      if (records.every(function (r) { return r.target.classList && r.target.classList.contains('pdp-clone'); })) return;
      if (restoreKept()) return;
      var filtered = records.some(function (r) { return r.attributeName === 'style' && r.target !== list; });
      if (filtered) { index = 0; sync(0); } else sync(SPEED);
    }).observe(list, { attributes: true, attributeFilter: ['class', 'style'], subtree: true });

    function point(e) {
      var t = e.touches ? e.touches[0] : e;
      return t ? { x: t.clientX, y: t.clientY } : null;
    }
    function start(e) {
      if (!on() || (e.touches && e.touches.length !== 1)) { drag = null; return; }
      var p = point(e);
      var live = new DOMMatrixReadOnly(getComputedStyle(list).transform).m41;
      setTranslate(live, 0);
      drag = { x: p.x, y: p.y, from: live, time: Date.now(), moving: false, scrolling: null, dx: 0 };
    }
    function move(e) {
      if (!drag) return;
      var p = point(e);
      if (!p) return;
      var dx = p.x - drag.x, dy = p.y - drag.y;
      if (drag.scrolling === null) {
        if (Math.abs(dx) < THRESHOLD && Math.abs(dy) < THRESHOLD) return;
        drag.scrolling = !!e.touches && Math.atan2(Math.abs(dy), Math.abs(dx)) * 180 / Math.PI > 45;
        drag.x += dx > 0 ? THRESHOLD : -THRESHOLD;
        dx = p.x - drag.x;
      }
      if (drag.scrolling) return;
      drag.moving = true;
      drag.dx = dx;
      root.classList.add('is-dragging');
      var min = 0, max = -maxIndex() * slideWidth();
      var x = drag.from + dx;
      if (x > min) x = min - 1 + Math.pow(-min + drag.from + dx, RESISTANCE);
      else if (x < max) x = max + 1 - Math.pow(max - drag.from - dx, RESISTANCE);
      setTranslate(x, 0);
      if (!e.touches && e.cancelable) e.preventDefault();
    }
    function end() {
      if (!drag) return;
      var d = drag;
      drag = null;
      root.classList.remove('is-dragging');
      if (!d.moving) { slideTo(index, SPEED, false); return; }
      var w = slideWidth();
      var pos = Math.max(0, Math.min(-translate, maxIndex() * w));
      var stop = Math.min(Math.floor(pos / w), maxIndex());
      var ratio = (pos - stop * w) / w;
      var next = d.dx < 0;
      var target;
      if (Date.now() - d.time > LONG_MS) {
        target = next ? (ratio >= LONG_RATIO ? stop + 1 : stop) : (ratio > 1 - LONG_RATIO ? stop + 1 : stop);
      } else {
        target = next ? stop + 1 : stop;
      }
      suppressClick = true;
      setTimeout(function () { suppressClick = false; }, 350);
      slideTo(target, SPEED, true);
    }
    list.addEventListener('mousedown', function (e) { if (e.button === 0) start(e); });
    window.addEventListener('mousemove', move);
    window.addEventListener('mouseup', end);
    list.addEventListener('touchstart', start, { passive: true });
    list.addEventListener('touchmove', move, { passive: true });
    list.addEventListener('touchend', end, { passive: true });
    list.addEventListener('touchcancel', end, { passive: true });
    list.addEventListener('dragstart', function (e) { if (on()) e.preventDefault(); });
    list.addEventListener('click', function (e) {
      if (on() && suppressClick) { e.preventDefault(); e.stopPropagation(); }
    }, true);

    /* sideways trackpad swipe: one photo per gesture */
    var wheelLock = 0;
    list.addEventListener('wheel', function (e) {
      if (!on() || Math.abs(e.deltaX) <= Math.abs(e.deltaY) || Math.abs(e.deltaX) < 12) return;
      e.preventDefault();
      var now = Date.now();
      if (now < wheelLock) return;
      wheelLock = now + 450;
      slideTo(index + (e.deltaX > 0 ? 1 : -1), SPEED, true);
    }, { passive: false });

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () { sync(0); }, 60);
    });
    mq.addEventListener && mq.addEventListener('change', function () { index = 0; sync(0); });
    window.addEventListener('load', function () { sync(0); });
    sync(0);

    /* The three tiles should fit the window without scrolling. The compact
       spacing in pdp-gallery-layout.css does that on most screens; on a
       short window the buy box is scaled down a little (never below 85%).
       Not while an info link is open: that is allowed to grow. */
    var info = root.querySelector('.product-v2__info-wrapper');
    /* the social proof line always fits one line: scaled down from its own
       size until it does (never below 10px) */
    function fitSocialProof() {
      var text = info && info.querySelector('.product-v2__sp-text');
      if (!text) return;
      text.style.removeProperty('font-size');
      text.style.removeProperty('white-space');
      if (!on()) return;
      text.style.whiteSpace = 'nowrap';
      /* the text does not shrink by itself: it pushes its row wider, so measure the row */
      var row = text.closest('.product-v2__social-proof-inner') || text.parentElement;
      var size = parseFloat(getComputedStyle(text).fontSize) || 13;
      while (row.scrollWidth > row.clientWidth + 1 && size > 10) {
        size -= 0.25;
        text.style.setProperty('font-size', size + 'px', 'important');
      }
    }
    /* Older Firefox has no CSS zoom: there the column keeps its full size. */
    var zoomOK = !!(window.CSS && CSS.supports && CSS.supports('zoom', '1'));
    function fitInfo() {
      if (!info) return;
      fitSocialProof();
      if (!on()) { info.style.removeProperty('--pdp-zoom'); return; }
      if (info.querySelector('.pdp-tile--links details[open]')) return;
      info.style.setProperty('--pdp-zoom', '1');
      if (!zoomOK) return;
      var top = info.getBoundingClientRect().top + window.scrollY;
      var available = window.innerHeight - top - 12;
      var total = info.offsetHeight;
      var z = available / total;
      /* When all three tiles would need more than 10% shrinking, keep the
         text readable instead: fit the buy tile and the shipping/payment
         tile, and let the info links start below the fold. */
      var tiles = info.querySelectorAll('.pdp-tile');
      if (z < 0.9 && tiles.length > 2) {
        z = available / (total - tiles[tiles.length - 1].offsetHeight - 8);
      }
      z = Math.max(0.85, Math.min(1, z));
      info.style.setProperty('--pdp-zoom', String(Math.round(z * 1000) / 1000));
      fitSocialProof();
    }
    var fitTimer;
    function scheduleFit() { clearTimeout(fitTimer); fitTimer = setTimeout(fitInfo, 80); }
    window.addEventListener('resize', scheduleFit);
    window.addEventListener('load', scheduleFit);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(scheduleFit);
    if (window.ResizeObserver && info) {
      var lastH = 0;
      new ResizeObserver(function () {
        /* only react to content changes, not to our own zoom */
        var h = info.scrollHeight;
        if (Math.abs(h - lastH) > 2) { lastH = h; scheduleFit(); }
      }).observe(info.firstElementChild || info);
    }
    fitInfo();

    /* Size guide pop-up: it is rendered inside a glass tile, and a tile's
       backdrop-filter would pin the "fixed" overlay to that tile instead
       of the window. Move it to <body> before it opens, so it is centred
       on the page; a click on the blurred page or Escape closes it. */
    function sizeGuide() { return document.getElementById('size-guide-overlay'); }
    function closeSizeGuide() {
      var overlay = sizeGuide();
      if (!overlay) return;
      overlay.style.display = 'none';
      document.body.classList.remove('noscroll');
    }
    section.addEventListener('click', function (e) {
      if (!on() || !e.target.closest('.size-guide-link')) return;
      var overlay = sizeGuide();
      if (overlay && overlay.parentElement !== document.body) document.body.appendChild(overlay);
    }, true);
    document.addEventListener('click', function (e) {
      if (on() && e.target === sizeGuide()) closeSizeGuide();
    });
    document.addEventListener('keydown', function (e) {
      var overlay = sizeGuide();
      if (on() && e.key === 'Escape' && overlay && overlay.style.display !== 'none') closeSizeGuide();
    });

    /* info links: height glide and plus/minus */
    section.addEventListener('click', function (e) {
      if (!on()) return;
      var summary = e.target.closest('.pdp-tile--links .product__accordion summary');
      if (!summary) return;
      var details = summary.parentElement;
      var content = details.querySelector('.accordion__content');
      if (!content || !content.animate) return;
      e.preventDefault();
      if (details._anim) details._anim.cancel();
      var opening = !details.open || details.classList.contains('is-closing');
      if (opening) {
        details.open = true;
        details.classList.remove('is-closing');
        var h = content.scrollHeight;
        details._anim = content.animate([{ height: '0px' }, { height: h + 'px' }], { duration: 200, easing: 'ease-out' });
      } else {
        details.classList.add('is-closing');
        var from = content.offsetHeight;
        details._anim = content.animate([{ height: from + 'px' }, { height: '0px' }], { duration: 200, easing: 'ease-out' });
        details._anim.onfinish = function () {
          details.open = false;
          details.classList.remove('is-closing');
        };
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Product Hero V2",
  "tag": "section",
  "class": "section bg-pdpbg",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "options": [
            {
              "value": "dropdown",
              "label": "Dropdown"
            },
            {
              "value": "button",
              "label": "Buttons"
            }
          ],
          "default": "button",
          "label": "Picker type"
        },
        {
          "type": "select",
          "id": "color_swatch_style",
          "options": [
            {
              "value": "colors",
              "label": "Color dots"
            },
            {
              "value": "images",
              "label": "Product images"
            }
          ],
          "default": "colors",
          "label": "Color swatch style"
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Quantity & Add to cart",
      "limit": 1
    },
    {
      "type": "size_guide",
      "name": "Size guide",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "guide_type",
          "label": "Size guide type",
          "options": [
            { "value": "auto", "label": "Auto-detect from product" },
            { "value": "socks", "label": "Socks" },
            { "value": "baselayer", "label": "Base layers" },
            { "value": "gloves", "label": "Gloves" },
            { "value": "overshoes", "label": "Overshoes" }
          ],
          "default": "auto",
          "info": "Choose which size chart to show in the pop-up. 'Auto-detect' picks based on product type and title."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Not sure about your size?"
        }
      ]
    },
    {
      "type": "secure_checkout",
      "name": "Secure checkout",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Trust text",
          "default": "Safe & secure checkout — pay with iDEAL, creditcard or PayPal"
        }
      ]
    },
    {
      "type": "shipping_info",
      "name": "Shipping info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "no_shipment_text",
          "label": "No shipment text",
          "default": "There is no shipment for your country"
        }
      ]
    },
