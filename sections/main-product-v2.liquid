                          data-low-stock-singular="{{ 'products.v2.low_stock_singular' | t | escape }}"
                          data-low-stock-plural="{{ 'products.v2.low_stock_plural' | t: qty: '[qty]' | escape }}">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <circle cx="8" cy="8" r="7" stroke="#F76503" stroke-width="1.5"/>
                            <path d="M8 4.5V9" stroke="#F76503" stroke-width="1.5" stroke-linecap="round"/>
                            <circle cx="8" cy="11.5" r="0.75" fill="#F76503"/>
                          </svg>
                          <span id="low-stock-text-{{ section.id }}"></span>
                        </div>
                        <script>
                          (function() {
                            var stockData = {};
                            {%- for variant in product.variants -%}
                              {%- if variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 10 -%}
                                stockData['{{ variant.id }}'] = {{ variant.inventory_quantity }};
                              {%- endif -%}
                            {%- endfor -%}
                            var el = document.getElementById('low-stock-{{ section.id }}');
                            var txt = document.getElementById('low-stock-text-{{ section.id }}');
                            function updateStock() {
                              var radios = document.querySelectorAll('variant-radios input[type="radio"]:checked');
                              var opts = [];
                              radios.forEach(function(r) { opts.push(r.value); });
                              var variants = {{ product.variants | json }};
                              var match = variants.find(function(v) {
                                return v.options.every(function(o, i) { return o === opts[i]; });
                              });
                              if (match && stockData[match.id]) {
                                var qty = stockData[match.id];
                                txt.textContent = qty === 1 ? el.getAttribute('data-low-stock-singular') : el.getAttribute('data-low-stock-plural').replace('[qty]', qty);
                                el.style.display = 'flex';
                              } else {
                                el.style.display = 'none';
                              }
                            }
                            updateStock();
                            document.addEventListener('change', function(e) {
                              if (e.target.closest('variant-radios')) updateStock();
                            });
                          })();
