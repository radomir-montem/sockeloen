    { "type": "text", "id": "klaviyo_company_id", "label": "Klaviyo public API key", "default": "S82fvg" },
    { "type": "text", "id": "custom_source", "label": "Custom source", "default": "Black Friday early access page" },
    { "type": "text", "id": "klaviyo_form_id", "label": "Klaviyo form ID (optional)", "info": "Fill in to open a form built in Klaviyo instead of the built-in sign-up sheet." },

    { "type": "header", "content": "Sign-up sheet, step 1: e-mail" },
    { "type": "text", "id": "form_kicker", "label": "Kicker", "default": "Exclusive access" },
    { "type": "text", "id": "form_heading", "label": "Title", "default": "Get in the early break away" },
    { "type": "text", "id": "form_text", "label": "Text", "default": "Drop your e-mail and get our Black Friday deals before anyone else." },
    { "type": "text", "id": "form_placeholder", "label": "E-mail placeholder", "default": "E-mail address" },
    { "type": "text", "id": "form_button", "label": "Button", "default": "Get exclusive access" },
    { "type": "text", "id": "form_consent", "label": "Small print", "default": "By signing up you agree to receive e-mails from Sockeloen. Unsubscribe anytime." },
    { "type": "text", "id": "error_text", "label": "Error message", "default": "Please enter a valid e-mail address." },

    { "type": "header", "content": "Sign-up sheet, step 2: mobile number" },
    { "type": "checkbox", "id": "phone_enabled", "label": "Ask for a mobile number after the e-mail", "default": true, "info": "Optional step. SMS consent is only recorded when the box is ticked." },
    { "type": "text", "id": "phone_kicker", "label": "Kicker", "default": "One more thing" },
    { "type": "text", "id": "phone_heading", "label": "Title", "default": "Want a text the moment the doors open?" },
    { "type": "text", "id": "phone_text", "label": "Text", "default": "One SMS when early access starts, so you're first in line. Nothing else." },
    { "type": "text", "id": "phone_country", "label": "Default country code", "default": "+31" },
    { "type": "text", "id": "phone_placeholder", "label": "Number placeholder", "default": "6 12345678" },
    { "type": "text", "id": "phone_consent", "label": "Consent text (required by law)", "default": "Yes, text me when early access opens. Message and data rates may apply. Reply STOP to unsubscribe." },
    { "type": "text", "id": "phone_button", "label": "Button", "default": "Text me when it opens" },
    { "type": "text", "id": "phone_skip", "label": "Skip link", "default": "No thanks, e-mail is enough" },
    { "type": "text", "id": "phone_error", "label": "Error message", "default": "Please enter a valid mobile number and tick the box." },

    { "type": "header", "content": "Sign-up sheet, step 3: success" },
    { "type": "text", "id": "success_heading", "label": "Title", "default": "You're in the break away" },
    { "type": "text", "id": "success_text", "label": "Text", "default": "Keep an eye on your inbox. You'll get the Black Friday deals before they go public." },
    { "type": "text", "id": "success_button", "label": "Close button", "default": "Done" }
  ],
  "presets": [
    { "name": "Black Friday sign-up hero" }
  ]
}
