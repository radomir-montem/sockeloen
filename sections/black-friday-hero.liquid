<script>
  (function () {
    var root = document.getElementById('BfSignup-{{ sid }}');
    var hero = document.getElementById('BfHero-{{ sid }}');
    if (!root || !hero) return;
    var STORAGE_KEY = 'bf-early-access';
    var endpoint = 'https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(root.getAttribute('data-company') || '');
    var listId = root.getAttribute('data-list');
    var source = root.getAttribute('data-source') || 'Black Friday early access';

    /* ---- video: autoplay muted (browser rule), sound on tap ---- */
    var video = hero.querySelector('video');
    if (video) {
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.muted = true;
      video.loop = true;
      var p = video.play();
      if (p && p.catch) p.catch(function () {});
    }
    var sound = hero.querySelector('[data-bf-sound]');
    if (sound && video) {
      var soundText = sound.querySelector('[data-bf-sound-text]');
      function setSound(on) {
        sound.setAttribute('aria-pressed', on ? 'true' : 'false');
        var label = sound.getAttribute(on ? 'data-on' : 'data-off');
        sound.setAttribute('aria-label', label);
        if (soundText) soundText.textContent = label;
      }
      sound.addEventListener('click', function () {
        var turnOn = video.muted;
        video.muted = !turnOn;
        if (turnOn) {
          video.volume = 1;
          var pp = video.play();
          if (pp && pp.catch) pp.catch(function () { video.muted = true; setSound(false); });
        }
        setSound(turnOn);
      });
    }

    /* ---- countdown to the early-access opening ---- */
    var count = hero.querySelector('[data-bf-countdown]');
    var target = Date.parse(hero.getAttribute('data-countdown') || '');
    if (count && !isNaN(target)) {
      var d = count.querySelector('[data-bf-d]'), h = count.querySelector('[data-bf-h]'), m = count.querySelector('[data-bf-m]'), sEl = count.querySelector('[data-bf-s]');
      var boxes = count.querySelector('[data-bf-count-boxes]'), label = count.querySelector('[data-bf-count-label]'), done = count.querySelector('[data-bf-count-done]');
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      function tick() {
        var left = target - Date.now();
        if (left <= 0) {
          boxes.hidden = true; label.hidden = true; done.hidden = false;
          return false;
        }
        var secs = Math.floor(left / 1000);
        d.textContent = Math.floor(secs / 86400);
        h.textContent = pad(Math.floor(secs % 86400 / 3600));
        m.textContent = pad(Math.floor(secs % 3600 / 60));
        sEl.textContent = pad(secs % 60);
        return true;
      }
      count.hidden = false;
      if (tick()) {
        var timer = setInterval(function () { if (!tick()) clearInterval(timer); }, 1000);
      }
    }

    /* ---- sheet ---- */
    var form = root.querySelector('[data-bf-form]');
    var input = root.querySelector('input[type="email"]');
    var errorEl = root.querySelector('[data-bf-error]');
    var submit = root.querySelector('[data-bf-submit]');
    var submitLabel = root.querySelector('[data-bf-submit-label]');
    var submitText = submitLabel ? submitLabel.textContent : '';
    var phoneForm = root.querySelector('[data-bf-phone-form]');
    var phoneInput = phoneForm && phoneForm.querySelector('input[type="tel"]');
    var phoneConsent = phoneForm && phoneForm.querySelector('[data-bf-sms-consent]');
    var phoneError = phoneForm && phoneForm.querySelector('[data-bf-phone-error]');
    var phoneSubmit = phoneForm && phoneForm.querySelector('[data-bf-phone-submit]');
    var phoneLabel = phoneForm && phoneForm.querySelector('[data-bf-phone-label]');
    var phoneText = phoneLabel ? phoneLabel.textContent : '';
    var success = root.querySelector('[data-bf-success]');
    var cta = hero.querySelector('[data-bf-open]');
    var lastFocus = null;
    var email = '';

    function signedUp() { try { return localStorage.getItem(STORAGE_KEY) === '1'; } catch (e) { return false; } }
    function remember() { try { localStorage.setItem(STORAGE_KEY, '1'); } catch (e) {} }
    function markCta() {
      if (!cta) return;
      var doneLabel = cta.getAttribute('data-label-done');
      if (signedUp() && doneLabel) { cta.textContent = doneLabel; cta.classList.add('is-done'); }
    }
    function show(step) {
      form.hidden = step !== 'email';
      if (phoneForm) phoneForm.hidden = step !== 'phone';
      success.hidden = step !== 'success';
      var focusEl = step === 'email' ? input : step === 'phone' ? phoneInput : null;
      if (focusEl) setTimeout(function () { focusEl.focus(); }, 60);
    }
    function open() {
      var formId = root.getAttribute('data-form');
      if (formId && window._klOnsite) {
        window._klOnsite.push(['openForm', formId]);
        return;
      }
      lastFocus = document.activeElement;
      root.hidden = false;
      document.body.style.overflow = 'hidden';
      show(signedUp() ? 'success' : 'email');
    }
    function close() {
      root.hidden = true;
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    function setError(el, field, on) {
      if (el) el.hidden = !on;
      if (field) field.setAttribute('aria-invalid', on ? 'true' : 'false');
    }
    function subscribe(attributes) {
      return fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'revision': '2024-10-15' },
        body: JSON.stringify({
          data: {
            type: 'subscription',
            attributes: {
              custom_source: source,
              profile: { data: { type: 'profile', attributes: attributes } }
            },
            relationships: { list: { data: { type: 'list', id: listId } } }
          }
        })
      }).then(function (res) { if (!res.ok) throw new Error('klaviyo ' + res.status); });
    }

    hero.querySelectorAll('[data-bf-open]').forEach(function (b) { b.addEventListener('click', open); });
    root.querySelectorAll('[data-bf-close]').forEach(function (b) { b.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !root.hidden) close(); });
    markCta();

    /* step 1: e-mail */
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      email = (input.value || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || !listId) { setError(errorEl, input, true); input.focus(); return; }
      setError(errorEl, input, false);
      submit.disabled = true;
      if (submitLabel) submitLabel.textContent = '…';
      subscribe({ email: email }).then(function () {
        remember();
        markCta();
        if (window.klaviyo && window.klaviyo.push) window.klaviyo.push(['identify', { $email: email }]);
        show(phoneForm ? 'phone' : 'success');
      }).catch(function () {
        setError(errorEl, input, true);
      }).then(function () {
        submit.disabled = false;
        if (submitLabel) submitLabel.textContent = submitText;
      });
    });

    /* step 2: mobile number, only with the consent box ticked */
    if (phoneForm) {
      var country = root.getAttribute('data-country') || '+31';
      function normalizePhone(raw) {
        var v = (raw || '').replace(/[\s().-]/g, '');
        if (v.indexOf('00') === 0) v = '+' + v.slice(2);
        if (v.charAt(0) !== '+') {
          if (v.charAt(0) === '0') v = v.slice(1);
          v = country + v;
        }
        return /^\+[1-9]\d{7,14}$/.test(v) ? v : null;
      }
      phoneForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var phone = normalizePhone(phoneInput.value);
        if (!phone || !phoneConsent.checked) { setError(phoneError, phoneInput, true); (phone ? phoneConsent : phoneInput).focus(); return; }
        setError(phoneError, phoneInput, false);
        phoneSubmit.disabled = true;
        if (phoneLabel) phoneLabel.textContent = '…';
        subscribe({ email: email, phone_number: phone }).then(function () {
          show('success');
        }).catch(function () {
          setError(phoneError, phoneInput, true);
        }).then(function () {
          phoneSubmit.disabled = false;
          if (phoneLabel) phoneLabel.textContent = phoneText;
        });
      });
      var skip = phoneForm.querySelector('[data-bf-phone-skip]');
      if (skip) skip.addEventListener('click', function () { show('success'); });
    }

    /* step 3: share */
    var share = root.querySelector('[data-bf-share]');
    if (share) {
      var shareLabel = share.querySelector('[data-bf-share-label]');
      var shareText = shareLabel ? shareLabel.textContent : '';
      share.addEventListener('click', function () {
        var url = location.origin + location.pathname;
        var data = { title: document.title, text: root.getAttribute('data-share-text') || '', url: url };
        if (navigator.share) { navigator.share(data).catch(function () {}); return; }
        var copied = function () {
          if (!shareLabel) return;
          shareLabel.textContent = root.getAttribute('data-share-copied') || 'Link copied';
          setTimeout(function () { shareLabel.textContent = shareText; }, 2000);
        };
        if (navigator.clipboard) navigator.clipboard.writeText(url).then(copied, copied); else copied();
      });
    }
  })();
</script>

