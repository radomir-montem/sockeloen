{%- comment -%}
  Black Friday sign-up hero: full-screen looping video with the message
  on top, header pill floating over it, footer below (template
  page.black-friday). Conversion helpers: social proof row, countdown to
  the early-access opening, sound toggle for the video, a "you're in"
  state for returning visitors.
  The button opens a full-screen sign-up sheet: step 1 e-mail (with the
  benefits), step 2 optional mobile number with explicit SMS consent,
  step 3 success with a share button. Both steps subscribe through
  Klaviyo's client API to one list (custom source set, the list's opt-in
  process applies). Optionally the button opens a Klaviyo-built form
  instead (setting "Klaviyo form ID").
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign shade = s.overlay_opacity | divided_by: 100.0
  assign sid = section.id
  if s.sp_avatar_1 != blank
    assign sp_av1 = s.sp_avatar_1 | image_url: width: 80
  else
    assign sp_av1 = 'Scherm_afbeelding_2026-03-21_om_23.30.36.png' | file_img_url: '80x80', crop: 'center'
  endif
  if s.sp_avatar_2 != blank
    assign sp_av2 = s.sp_avatar_2 | image_url: width: 80
  else
    assign sp_av2 = 'Scherm_afbeelding_2026-03-21_om_23.31.47.png' | file_img_url: '80x80', crop: 'center'
  endif
  if s.sp_avatar_3 != blank
    assign sp_av3 = s.sp_avatar_3 | image_url: width: 80
  else
    assign sp_av3 = 'Scherm_afbeelding_2026-03-21_om_23.31.03.png' | file_img_url: '80x80', crop: 'center'
  endif
-%}
<section
  id="BfHero-{{ sid }}"
  class="bf-hero bf-hero--{{ s.text_position }}"
  style="--bf-shade: {{ shade }}; --bf-min-h: {{ s.min_height }}svh; --bf-video-pos: {{ s.video_position }};"
  data-bf-hero
  data-countdown="{{ s.countdown_date | escape }}"
>
  <div class="bf-hero__media">
    {%- if s.video != blank -%}
      {{ s.video | video_tag: image_size: '1920x', autoplay: true, loop: true, muted: true, controls: false, preload: 'auto', class: 'bf-hero__video' }}
    {%- elsif s.video_url != blank -%}
      <video class="bf-hero__video" autoplay loop muted playsinline preload="auto"{% if s.poster != blank %} poster="{{ s.poster | image_url: width: 1920 }}"{% endif %}>
        <source src="{{ s.video_url }}" type="video/mp4">
      </video>
    {%- elsif s.poster != blank -%}
      {{ s.poster | image_url: width: 2400 | image_tag: class: 'bf-hero__video', loading: 'eager', sizes: '100vw' }}
    {%- else -%}
      <div class="bf-hero__video bf-hero__video--empty"></div>
    {%- endif -%}
  </div>
  <div class="bf-hero__shade" aria-hidden="true"></div>

  <div class="bf-hero__content">
    {%- if s.kicker != blank -%}
      <p class="bf-hero__kicker">{{ s.kicker | escape }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h1 class="bf-hero__heading">{{ s.heading | escape }}</h1>
    {%- endif -%}
    {%- if s.subheading != blank -%}
      <p class="bf-hero__sub">{{ s.subheading | escape }}</p>
    {%- endif -%}

    {%- if s.countdown_enabled and s.countdown_date != blank -%}
      <div class="bf-hero__count" data-bf-countdown hidden>
        <p class="bf-hero__count-label" data-bf-count-label>{{ s.countdown_label | escape }}</p>
        <div class="bf-hero__count-boxes" data-bf-count-boxes>
          <div class="bf-hero__count-box"><span class="bf-hero__count-num" data-bf-d>0</span><span class="bf-hero__count-unit">{{ s.countdown_days | default: 'days' | escape }}</span></div>
          <div class="bf-hero__count-box"><span class="bf-hero__count-num" data-bf-h>0</span><span class="bf-hero__count-unit">{{ s.countdown_hours | default: 'hrs' | escape }}</span></div>
          <div class="bf-hero__count-box"><span class="bf-hero__count-num" data-bf-m>0</span><span class="bf-hero__count-unit">{{ s.countdown_minutes | default: 'min' | escape }}</span></div>
          <div class="bf-hero__count-box"><span class="bf-hero__count-num" data-bf-s>0</span><span class="bf-hero__count-unit">{{ s.countdown_seconds | default: 'sec' | escape }}</span></div>
        </div>
        <p class="bf-hero__count-done" data-bf-count-done hidden>{{ s.countdown_done | escape }}</p>
      </div>
    {%- endif -%}

    {%- if s.button_label != blank -%}
      <button type="button" class="bf-hero__cta" data-bf-open data-label="{{ s.button_label | escape }}" data-label-done="{{ s.button_label_done | escape }}">{{ s.button_label | escape }}</button>
    {%- endif -%}
    {%- if s.note != blank -%}
      <p class="bf-hero__note">{{ s.note | escape }}</p>
    {%- endif -%}

    {%- if s.show_social_proof and s.sp_text != blank -%}
      <div class="banner-social-proof bf-hero__sp">
        <div class="product-v2__social-proof-inner">
          <div class="product-v2__sp-avatars">
            <div class="product-v2__sp-avatar product-v2__sp-avatar--1"><img src="{{ sp_av1 }}" alt="" width="40" height="40" loading="lazy"></div>
            <div class="product-v2__sp-avatar product-v2__sp-avatar--2"><img src="{{ sp_av2 }}" alt="" width="40" height="40" loading="lazy"></div>
            <div class="product-v2__sp-avatar product-v2__sp-avatar--3"><img src="{{ sp_av3 }}" alt="" width="40" height="40" loading="lazy"></div>
          </div>
          <p class="product-v2__sp-text bf-hero__sp-text">{{ s.sp_text | escape }}</p>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if s.show_sound_toggle and s.video != blank or s.show_sound_toggle and s.video_url != blank -%}
    <button type="button" class="bf-hero__sound" data-bf-sound aria-pressed="false" data-on="{{ s.sound_label_on | default: 'Sound on' | escape }}" data-off="{{ s.sound_label_off | default: 'Sound off' | escape }}" aria-label="{{ s.sound_label_off | default: 'Sound off' | escape }}">
      <svg class="bf-hero__sound-icon bf-hero__sound-icon--off" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 9l5 6M21 9l-5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <svg class="bf-hero__sound-icon bf-hero__sound-icon--on" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 8.5a5 5 0 010 7M18.5 6a8.5 8.5 0 010 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <span class="bf-hero__sound-text" data-bf-sound-text>{{ s.sound_label_off | default: 'Sound off' | escape }}</span>
    </button>
  {%- endif -%}
</section>

{%- comment -%} Full-screen sign-up sheet {%- endcomment -%}
<div class="bf-signup" id="BfSignup-{{ sid }}" hidden data-bf-signup
  data-company="{{ s.klaviyo_company_id | escape }}"
  data-list="{{ s.klaviyo_list_id | escape }}"
  data-form="{{ s.klaviyo_form_id | escape }}"
  data-source="{{ s.custom_source | escape }}"
  data-phone="{{ s.phone_enabled }}"
  data-country="{{ s.phone_country | default: '+31' | escape }}"
  data-share-text="{{ s.share_message | escape }}"
  data-share-copied="{{ s.share_copied | default: 'Link copied' | escape }}"
>
  <div class="bf-signup__backdrop" data-bf-close></div>
  <div class="bf-signup__sheet" role="dialog" aria-modal="true" aria-labelledby="BfSignupTitle-{{ sid }}">
    <button type="button" class="bf-signup__close" data-bf-close aria-label="{{ 'accessibility.close' | t | default: 'Close' }}">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>

    {%- comment -%} step 1: e-mail {%- endcomment -%}
    <form class="bf-signup__form" data-bf-form novalidate>
      {%- if s.form_kicker != blank -%}
        <p class="bf-signup__kicker">{{ s.form_kicker | escape }}</p>
      {%- endif -%}
      <h2 class="bf-signup__title" id="BfSignupTitle-{{ sid }}">{{ s.form_heading | escape }}</h2>
      {%- if s.form_text != blank -%}
        <p class="bf-signup__text">{{ s.form_text | escape }}</p>
      {%- endif -%}
      {%- if s.benefit_1 != blank or s.benefit_2 != blank or s.benefit_3 != blank -%}
        <ul class="bf-signup__benefits">
          {%- for i in (1..3) -%}
            {%- assign bkey = 'benefit_' | append: i -%}
            {%- assign btxt = s[bkey] -%}
            {%- if btxt != blank -%}
              <li><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ btxt | escape }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <label class="bf-signup__label" for="BfEmail-{{ sid }}">{{ s.form_placeholder | default: 'E-mail address' | escape }}</label>
      <input class="bf-signup__input" id="BfEmail-{{ sid }}" type="email" name="email" inputmode="email" autocomplete="email" placeholder="{{ s.form_placeholder | default: 'E-mail address' | escape }}" required>
      <p class="bf-signup__error" data-bf-error hidden>{{ s.error_text | escape }}</p>
      <button type="submit" class="bf-signup__submit" data-bf-submit>
        <span data-bf-submit-label>{{ s.form_button | escape }}</span>
      </button>
      {%- if s.form_consent != blank -%}
        <p class="bf-signup__consent">{{ s.form_consent | escape }}</p>
      {%- endif -%}
    </form>

    {%- comment -%} step 2: mobile number (optional) {%- endcomment -%}
    {%- if s.phone_enabled -%}
      <form class="bf-signup__form bf-signup__phone" data-bf-phone-form hidden novalidate>
        {%- if s.phone_kicker != blank -%}
          <p class="bf-signup__kicker">{{ s.phone_kicker | escape }}</p>
        {%- endif -%}
        <h2 class="bf-signup__title">{{ s.phone_heading | escape }}</h2>
        {%- if s.phone_text != blank -%}
          <p class="bf-signup__text">{{ s.phone_text | escape }}</p>
        {%- endif -%}
        <label class="bf-signup__label" for="BfPhone-{{ sid }}">{{ s.phone_placeholder | default: 'Mobile number' | escape }}</label>
        <div class="bf-signup__tel">
          <span class="bf-signup__tel-country" data-bf-country>{{ s.phone_country | default: '+31' | escape }}</span>
          <input class="bf-signup__input bf-signup__input--tel" id="BfPhone-{{ sid }}" type="tel" name="phone" inputmode="tel" autocomplete="tel-national" placeholder="{{ s.phone_placeholder | default: '6 12345678' | escape }}">
        </div>
        <label class="bf-signup__check-row">
          <input type="checkbox" name="sms_consent" data-bf-sms-consent>
          <span class="bf-signup__check-box" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6.5l2.5 2.5L10 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span class="bf-signup__check-text">{{ s.phone_consent | escape }}</span>
        </label>
        <p class="bf-signup__error" data-bf-phone-error hidden>{{ s.phone_error | escape }}</p>
        <button type="submit" class="bf-signup__submit" data-bf-phone-submit>
          <span data-bf-phone-label>{{ s.phone_button | escape }}</span>
        </button>
        <button type="button" class="bf-signup__skip" data-bf-phone-skip>{{ s.phone_skip | escape }}</button>
      </form>
    {%- endif -%}

    {%- comment -%} step 3: success {%- endcomment -%}
    <div class="bf-signup__success" data-bf-success hidden>
      <div class="bf-signup__check" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M6 14.5l5 5L22 9" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h2 class="bf-signup__title">{{ s.success_heading | escape }}</h2>
      {%- if s.success_text != blank -%}
        <p class="bf-signup__text">{{ s.success_text | escape }}</p>
      {%- endif -%}
      {%- if s.share_enabled and s.share_button != blank -%}
        <button type="button" class="bf-signup__share" data-bf-share>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12v7a1 1 0 001 1h14a1 1 0 001-1v-7M12 3v13M7 8l5-5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span data-bf-share-label>{{ s.share_button | escape }}</span>
        </button>
      {%- endif -%}
      <button type="button" class="bf-signup__submit bf-signup__submit--done" data-bf-close>{{ s.success_button | default: 'Done' | escape }}</button>
    </div>
  </div>
</div>

<style>
  /* the video runs up behind the floating header, like the homepage hero */
  body.template--page.template--black-friday main#MainContent,
  body.template--page.template--black-friday #MainContent {
    padding-top: 0;
  }

  #BfHero-{{ sid }} {
    position: relative;
    min-height: var(--bf-min-h, 100svh);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #0b0b0b;
    color: #fff;
  }
  #BfHero-{{ sid }} .bf-hero__media { position: absolute; inset: 0; }
  #BfHero-{{ sid }} .bf-hero__media video,
  #BfHero-{{ sid }} .bf-hero__media img,
  #BfHero-{{ sid }} .bf-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--bf-video-pos, center);
    display: block;
  }
  #BfHero-{{ sid }} .bf-hero__video--empty { background: linear-gradient(160deg, #1a1a1a, #000); }
  #BfHero-{{ sid }} .bf-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(0, 0, 0, .45) 0%, rgba(0, 0, 0, 0) 32%, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, .55) 100%),
      rgba(0, 0, 0, var(--bf-shade, .35));
    pointer-events: none;
  }
  #BfHero-{{ sid }} .bf-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding: 140px 16px 96px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  #BfHero-{{ sid }}.bf-hero--bottom .bf-hero__content { align-self: flex-end; padding-bottom: 72px; }
  #BfHero-{{ sid }}.bf-hero--top .bf-hero__content { align-self: flex-start; }
  #BfHero-{{ sid }} .bf-hero__kicker {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .8);
  }
  #BfHero-{{ sid }} .bf-hero__heading {
    margin: 0;
    font-size: clamp(38px, 6vw, 72px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -.01em;
    color: #fff;
    text-wrap: balance;
  }
  #BfHero-{{ sid }} .bf-hero__sub {
    margin: 0;
    max-width: 560px;
    font-size: clamp(15px, 1.6vw, 19px);
    line-height: 1.45;
    color: rgba(255, 255, 255, .88);
    text-wrap: balance;
  }
  /* countdown: glass boxes, same recipe as the buttons */
  #BfHero-{{ sid }} .bf-hero__count { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 4px; }
  #BfHero-{{ sid }} .bf-hero__count[hidden] { display: none; }
  #BfHero-{{ sid }} .bf-hero__count-label,
  #BfHero-{{ sid }} .bf-hero__count-done {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .8);
  }
  #BfHero-{{ sid }} .bf-hero__count-done { color: #7ed321; }
  #BfHero-{{ sid }} .bf-hero__count-boxes { display: flex; gap: 8px; }
  #BfHero-{{ sid }} .bf-hero__count-box {
    min-width: 66px;
    padding: 10px 8px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    background: rgba(255, 255, 255, .16);
    border: 1px solid rgba(255, 255, 255, .24);
    border-radius: 8px;
    backdrop-filter: blur(21px) saturate(180%);
    -webkit-backdrop-filter: blur(21px) saturate(180%);
  }
  #BfHero-{{ sid }} .bf-hero__count-num { font-size: 24px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  #BfHero-{{ sid }} .bf-hero__count-unit { font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: rgba(255, 255, 255, .75); }
  /* glass button, same recipe as the homepage hero button */
  #BfHero-{{ sid }} .bf-hero__cta {
    margin-top: 8px;
    padding: 15px 28px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(255, 255, 255, .2);
    border: 1px solid rgba(255, 255, 255, .28);
    border-radius: 8px;
    backdrop-filter: blur(21px) saturate(180%);
    -webkit-backdrop-filter: blur(21px) saturate(180%);
    box-shadow: 0 2px 2px rgba(0, 0, 0, .1);
    cursor: pointer;
    transition: background-color .2s ease, border-color .2s ease;
  }
  #BfHero-{{ sid }} .bf-hero__cta:hover { background: rgba(255, 255, 255, .34); border-color: rgba(255, 255, 255, .45); }
  #BfHero-{{ sid }} .bf-hero__cta.is-done { background: rgba(126, 211, 33, .22); border-color: rgba(126, 211, 33, .45); }
  #BfHero-{{ sid }} .bf-hero__note { margin: 0; font-size: 12px; color: rgba(255, 255, 255, .7); }
  /* social proof row, same look as the homepage hero */
  #BfHero-{{ sid }} .bf-hero__sp { margin-top: 8px !important; }
  #BfHero-{{ sid }} .bf-hero__sp-text { color: rgba(255, 255, 255, .9) !important; font-size: 13px !important; }
  /* sound toggle */
  #BfHero-{{ sid }} .bf-hero__sound {
    position: absolute;
    right: 20px;
    bottom: 20px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px 0 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(255, 255, 255, .2);
    border: 1px solid rgba(255, 255, 255, .28);
    border-radius: 999px;
    backdrop-filter: blur(21px) saturate(180%);
    -webkit-backdrop-filter: blur(21px) saturate(180%);
    cursor: pointer;
    transition: background-color .2s ease;
  }
  #BfHero-{{ sid }} .bf-hero__sound:hover { background: rgba(255, 255, 255, .34); }
  #BfHero-{{ sid }} .bf-hero__sound-icon--on { display: none; }
  #BfHero-{{ sid }} .bf-hero__sound[aria-pressed="true"] .bf-hero__sound-icon--on { display: block; }
  #BfHero-{{ sid }} .bf-hero__sound[aria-pressed="true"] .bf-hero__sound-icon--off { display: none; }
  @media screen and (max-width: 749px) {
    #BfHero-{{ sid }} .bf-hero__content { padding: 150px 16px 84px; gap: 14px; }
    #BfHero-{{ sid }} .bf-hero__cta { width: 100%; padding: 16px 20px; }
    #BfHero-{{ sid }} .bf-hero__count-box { min-width: 0; flex: 1; }
    #BfHero-{{ sid }} .bf-hero__count-boxes { width: 100%; max-width: 360px; }
    #BfHero-{{ sid }} .bf-hero__sound { right: 16px; bottom: 16px; }
  }

  /* ---- sign-up sheet ---- */
  #BfSignup-{{ sid }} { position: fixed; inset: 0; z-index: 400; }
  #BfSignup-{{ sid }}[hidden] { display: none; }
  #BfSignup-{{ sid }} .bf-signup__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, .62);
    backdrop-filter: blur(21px) saturate(180%);
    -webkit-backdrop-filter: blur(21px) saturate(180%);
  }
  #BfSignup-{{ sid }} .bf-signup__sheet {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(480px, calc(100% - 32px));
    max-height: calc(100% - 32px);
    overflow: auto;
    background: #fff;
    color: #111;
    border-radius: 12px;
    padding: 40px 32px 32px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
    text-align: center;
  }
  #BfSignup-{{ sid }} .bf-signup__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 8px;
    background: #f2f2f2;
    color: #111;
    cursor: pointer;
  }
  #BfSignup-{{ sid }} .bf-signup__close:hover { background: #e6e6e6; }
  #BfSignup-{{ sid }} .bf-signup__form[hidden],
  #BfSignup-{{ sid }} .bf-signup__success[hidden] { display: none; }
  #BfSignup-{{ sid }} .bf-signup__kicker {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #0395F6;
  }
  #BfSignup-{{ sid }} .bf-signup__title {
    margin: 0 0 10px;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.1;
    color: #111;
    text-wrap: balance;
  }
  #BfSignup-{{ sid }} .bf-signup__text { margin: 0 0 20px; font-size: 15px; line-height: 1.5; color: #666; }
  #BfSignup-{{ sid }} .bf-signup__benefits {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
  }
  #BfSignup-{{ sid }} .bf-signup__benefits li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.4; color: #222; }
