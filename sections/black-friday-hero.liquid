  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "video", "id": "video", "label": "Video", "info": "Landscape, muted, loops. Keep it short (5–15 s) and under ~8 MB for fast loading." },
    { "type": "text", "id": "video_url", "label": "Video URL (fallback)", "info": "Direct MP4 link, used when no video is picked above." },
    { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Shown while the video loads and when video cannot play." },
    { "type": "select", "id": "video_position", "label": "Video focal point", "options": [
      { "value": "center", "label": "Center" },
      { "value": "top", "label": "Top" },
      { "value": "bottom", "label": "Bottom" }
    ], "default": "center" },
    { "type": "range", "id": "overlay_opacity", "label": "Darken video", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "range", "id": "min_height", "label": "Height", "min": 70, "max": 100, "step": 5, "unit": "vh", "default": 100 },

    { "type": "header", "content": "Message" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Black Friday 2026" },
    { "type": "text", "id": "heading", "label": "Title", "default": "Don't miss the early break away" },
    { "type": "text", "id": "subheading", "label": "Subtitle", "default": "Join here to get exclusive access to our Black Friday deals first" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Sign up for early access" },
    { "type": "text", "id": "note", "label": "Small line under the button", "default": "Members get the deals before anyone else." },
    { "type": "select", "id": "text_position", "label": "Text position", "options": [
      { "value": "center", "label": "Center" },
      { "value": "bottom", "label": "Bottom" },
      { "value": "top", "label": "Top" }
    ], "default": "center" },

    { "type": "header", "content": "Footer" },
    { "type": "checkbox", "id": "hide_footer", "label": "Hide the theme footer on this page", "default": true, "info": "Keeps visitors on the one goal. A one-line legal footer with the policy links stays." },
    { "type": "text", "id": "legal_privacy", "label": "Privacy link text", "default": "Privacy policy" },
    { "type": "text", "id": "legal_terms", "label": "Terms link text", "default": "Terms" },

    { "type": "header", "content": "Klaviyo" },
